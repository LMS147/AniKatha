<Project Sdk="Microsoft.NET.Sdk.Razor">
 <PropertyGroup>
  <TargetFramework>net10.0-android</TargetFramework><OutputType>Exe</OutputType><RootNamespace>AniKatha.Mobile</RootNamespace>
  <UseMaui>true</UseMaui><SingleProject>true</SingleProject><EnableDefaultCssItems>false</EnableDefaultCssItems>
  <ApplicationTitle>AniKatha</ApplicationTitle><ApplicationId>co.zyma.anikatha</ApplicationId>
  <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion>
  <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion><AndroidPackageFormats>apk</AndroidPackageFormats>
 </PropertyGroup>
 <ItemGroup>
  <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#171021" />
  <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#0b0b10" BaseSize="128,128" />
  <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
  <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.0" />
  <ProjectReference Include="../AniKatha.UI/AniKatha.UI.csproj" />
 </ItemGroup>
</Project>
