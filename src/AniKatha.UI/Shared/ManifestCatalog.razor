@using System.Text.Json
@using Microsoft.JSInterop
@inject IJSRuntime JS
@using static AniKatha.Core.AddonResources
@implements IDisposable
@inject AddonClient Client
@inject NavigationManager Navigation
@inherits ProfileComponent

<section class="@(ReaderProvider is not null ? "manga-reader-source" : ShowDetailActions ? "manga-provider-details" : "settings-card")">
 @if (ReaderProvider is null)
 {
 @if (!ShowDetailActions) { <h3>@Source.Addon.Name @Catalog.Name</h3> }
 @if (HasFilters) { <p>Filters check loaded titles only. Titles missing the selected metadata are excluded.</p> }
 @if (InitialTitle is null)
 {
  @foreach (var extra in AdditionalExtras)
  {
   <label>
    @extra.Name @(extra.Required ? "(required)" : "")
    @if (extra.Options.Count > 0)
    {
     <select value="@ExtraValue(extra.Name)" @onchange="args => ChangeExtra(extra.Name, args)">
      <option value="">Choose @extra.Name</option>
      @foreach (var option in extra.Options) { <option value="@option">@option</option> }
     </select>
    }
    else { <input value="@ExtraValue(extra.Name)" @onchange="args => ChangeExtra(extra.Name, args)" /> }
   </label>
  }
  @if (MissingRequired) { <p>Provide the required filters to search or browse this catalogue.</p> }
 }
 @foreach(var item in titles){
  <button class="secondary design-provider-title" @onclick="() => SelectTitle(item)">
   @if (Catalog.Type == "manga" && MediaUrl(Field(item, "poster"))) { <img src="@Field(item,"poster")" alt="" loading="lazy" /> }
   @Field(item,"name")
  </button>
 }
 @if(more){<button disabled="@busy" @onclick="()=>Load(false)">Load more</button>}
 @if(busy){<p role="status">Loading…</p>}
 @if(error!=null){<p role="alert">@error <button @onclick="Retry">Retry</button></p>}
 @if(!busy && error==null && selected is null && titles.Count==0 && !MissingRequired){<p>No matching titles.</p>}
 @if(selected!=null){
  <ProviderTitleDetails Listing="selected.Value" Details="details" Type="@Catalog.Type" Standalone="ShowDetailActions" HideSynopsis="ShowDetailActions"/>
  @if (!ShowDetailActions && (InitialTitle == null || AllowSaveInitialTitle))
  {
   <button disabled="@saved" @onclick="SaveTitle">@(saved ? "Saved to library" : "Save to library")</button>
  }
  @if (ShowDetailActions)
  {
   <div class="manga-detail-actions">
    @if (units.Count > 0)
    {
     <a class="primary" href="@ReadingAction"><Icon Name="book" />@(continueLink is null ? "Start reading" : "Continue reading")</a>
    }
    @if (savedTitle is { } local)
    {
     <a class="secondary" href="@($"/library/title/{local.Id}/tracking")">Edit Library entry ›</a>
     <button type="button" class="secondary manga-favorite" aria-label="Favorite title" aria-pressed="@(local.IsFavourite ? "true" : "false")" @onclick="ToggleFavorite">@(local.IsFavourite ? "★" : "☆")</button>
    }
    else if (AllowSaveInitialTitle) { <button class="secondary" @onclick="SaveTitle">Save to library</button> }
   </div>
   <ProviderTitleDetails Listing="selected.Value" Details="details" Type="@Catalog.Type" Standalone="true" DescriptionOnly="true" />
  }
  @if (units.Count > 0)
  {
   <section class="design-units" aria-labelledby="@unitHeading">
    <header><h3 id="@unitHeading" tabindex="-1">@(IsManga ? "Chapters" : "Episodes")</h3><span>@units.Count @(IsManga ? "releases" : "episodes")</span></header>
    <div class="design-unit-tools">
     <label>Search @(IsManga ? "chapters" : "episodes")<input type="search" @bind="unitSearch" @bind:event="oninput" @bind:after="ResetUnitPage" /></label>
     @if (IsManga && ReleaseGroups.Length > 1)
     {
      <label>Group<select @bind="group" @bind:after="ResetUnitPage"><option value="">All groups</option>
       @foreach (var releaseGroup in ReleaseGroups) { <option>@releaseGroup</option> }
      </select></label>
     }
     @if (IsManga && (HasVolume || HasReleaseDate))
     {
      <label>Sort releases<select @bind="releaseSort" @bind:after="ResetUnitPage">
       <option value="">Source order</option>
       @if (HasReleaseDate) { <option value="date">Newest release</option> }
       @if (HasVolume) { <option value="volume">Volume</option> }
      </select></label>
     }
    </div>
    <div class="design-chips" role="group" aria-label="Release order and layout">
     <button type="button" class="secondary" @onclick="ReverseUnits">@(reverseUnits ? "Reversed order" : "Source order")</button>
     @if (!IsManga)
     {
      <button type="button" class="secondary" aria-pressed="@(gridUnits ? "true" : "false")" @onclick="() => gridUnits = true">Grid</button>
      <button type="button" class="secondary" aria-pressed="@(!gridUnits ? "true" : "false")" @onclick="() => gridUnits = false">List</button>
     }
    </div>
    @{
     var results = VisibleUnits.ToArray();
     var start = unitPage * UnitsPerPage;
    }
    @if (results.Length == 0) { <p>No matching releases.</p> }
    <div class="@(gridUnits && !IsManga ? "design-unit-grid" : "design-unit-list")">
  @foreach (var unit in results.Skip(start).Take(UnitsPerPage))
  {
   var id = Field(unit, "id");
   <div class="design-unit-row" @key="id">
    <button class="secondary @(dimWatched && Catalog.Type != "manga" && progress.TryGetValue(id, out var status) && status.Completed ? "watched-dimmed" : null)" @onclick="() => SelectUnit(unit)" aria-pressed="@(unitId == id ? "true" : "false")"><span>@Field(unit,"title")</span>
    @if (ShowDetailActions) { <span class="manga-chapter-chevron" aria-hidden="true"></span> }</button>
    @if (IsManga && ReleaseGroup(unit) is { Length: > 0 } releaseGroup) { <small>@releaseGroup</small> }
    @if (IsManga && Volume(unit) is decimal volume) { <small>Volume @volume</small> }
    @if (IsManga && ReleaseDate(unit) is { } date)
    { <small><time datetime="@date.ToString("O")">@date.ToString("MMM d, yyyy")</time></small> }
    @if (progress.TryGetValue(id, out var unitProgress))
    {
     <small>@(unitProgress.Completed ? "Completed" : "In progress")</small>
     @if (!unitProgress.Completed && continueLink == unitProgress.HistoryId)
     {
      <a class="text-link" href="@($"/resume/{continueLink}")">Continue @Field(unit,"title")</a>
     }
    }
   </div>
  }
    </div>
    @if (results.Length > UnitsPerPage)
    {
     <nav class="design-pagination" aria-label="Release pages">
      <button type="button" class="secondary" disabled="@(unitPage == 0)" @onclick="() => unitPage--">Previous</button>
      <span>Showing @(start + 1)–@Math.Min(start + UnitsPerPage, results.Length) of @results.Length</span>
      <button type="button" class="secondary" disabled="@(start + UnitsPerPage >= results.Length)" @onclick="() => unitPage++">Next</button>
     </nav>
    }
   </section>
  }
  @if(!busy && error==null && units.Count==0){<p>No episodes or chapters available.</p>}
 }
 }
 else if (busy) { <p role="status">Opening chapter…</p> }
 else if (error is not null) { <p role="alert">@error <button class="secondary" @onclick="Retry">Retry</button></p> }
 else if (unitId is null || !targets.Any(target => target.Provider.ProviderKey == ReaderProvider))
 { <p role="alert">This chapter is unavailable from the selected source. Return to Chapters to choose a source.</p> }
 @if(unitId!=null){
  @if (ReaderProvider is null)
  {
  <h3>Sources for @label</h3>
  @if (nextSourceUnavailable) { <p role="status">The previous provider has no source for this episode. Choose another source below.</p> }
  @if (targets.Count == 0) { <p>No compatible add-on.</p> }
  @if (targets.Count > 0 || preferredSource.Length > 0)
  {
   <label>Preferred source for this title
    <select value="@preferredSource" @onchange="SetPreferredSource">
     <option value="">No preference</option>
     @if (preferredSource.Length > 0 && !targets.Any(target => target.Provider.ProviderKey == preferredSource))
     {
      <option value="@preferredSource">Preferred source unavailable for this unit</option>
     }
     @foreach (var target in targets)
     {
      <option value="@target.Provider.ProviderKey">@target.Provider.Addon.Name</option>
     }
    </select>
   </label>
   @if (preferenceError) { <p role="alert">Could not save the preferred source.</p> }
  }
  }
  <div id="@episodeSources" class="design-source-panel" tabindex="-1" @ref="sourcePanel">
  @foreach(var target in targets.Where(target => ReaderProvider is null || target.Provider.ProviderKey == ReaderProvider).OrderByDescending(target => target.Provider.ProviderKey == preferredSource)){
   <ManifestSources @key="(target.Provider.ProviderKey,target.UnitId,titleId,unitId)" Source="target.Provider" AniListProgress="aniListProgress" HasOriginMetadata="true" Origin="@Source.ProviderKey" Type="@Catalog.Type" TitleId="@titleId" UnitId="@target.UnitId" Label="@label" Title="@DisplayTitle" Poster="@TitlePoster" Preferred="@(target.Provider.ProviderKey == preferredSource)" AutoOpen="@(ReaderProvider is not null || target.Provider.ProviderKey == autoOpenSource)" DedicatedReader="@(ReaderProvider is not null)" ReaderPath="@(ShowDetailActions && ReaderProvider is null ? ReaderLink(unitId, target.Provider.ProviderKey) : null)" NextEpisode="@(CanMove(1) && Catalog.Type != "manga" ? EventCallback.Factory.Create(this, () => MoveUnit(1, target.Provider.ProviderKey)) : default)" PreviousChapter="@(CanMove(-1) && Catalog.Type == "manga" ? EventCallback.Factory.Create(this, () => MoveUnit(-1, target.Provider.ProviderKey)) : default)"
    NextChapter="@(CanMove(1) && Catalog.Type == "manga" ? EventCallback.Factory.Create(this, () => MoveUnit(1, target.Provider.ProviderKey)) : default)"
    ProgressChanged="RefreshProgress" ActivateVideo="ActivateVideo" SourcePickerId="@episodeSources" NextEpisodeLabel="@GetNextEpisodeLabel()"/>
  }
  </div>
 }
</section>

@code {
 [Parameter] public Dictionary<(string Provider, string Type, string Id), CatalogPage>? Session { get; set; }
 [Parameter] public SearchOptions? Filters { get; set; }
 [Parameter] public string? SubmittedQuery { get; set; }
 [Parameter] public SavedTitle? InitialTitle {get;set;}
 [Parameter] public bool AllowSaveInitialTitle { get; set; }
 [Parameter] public string? InitialUnitId { get; set; }
 [Parameter] public bool OpenMangaPage { get; set; }
 [Parameter] public bool ShowDetailActions { get; set; }
 [Parameter] public string? ReaderProvider { get; set; }
 [Parameter] public string? From { get; set; }
 SavedTitle? savedTitle;
 string DisplayTitle => Field(details, "name") is { Length: > 0 } name ? name : Field(selected!.Value, "name");
 string ReaderLink(string? release, string provider) =>
  AniKatha.UI.Pages.MangaDetails.ProviderPath(Source.ProviderKey, titleId, DisplayTitle, release, From, provider);
 string ReadingAction
 {
  get
  {
   if (continueLink is not null && readingHistory is { } entry)
   {
     var match = units.FirstOrDefault(unit => Source.ResolveUnitProviders(Catalog.Type, unit, Providers)
      .Any(target => target.UnitId == entry.UnitId && target.Provider.ProviderKey == entry.Source));
    if (match.ValueKind != JsonValueKind.Undefined) return ReaderLink(Field(match, "id"), entry.Source);
   }
   foreach (var unit in units.OrderByDescending(unit => unitId is not null && Field(unit, "id") == unitId))
   {
    var sources = Source.ResolveUnitProviders(Catalog.Type, unit, Providers).ToArray();
    if (sources.Length == 0) continue;
    var chosen = sources.FirstOrDefault(target => target.Provider.ProviderKey == preferredSource);
    return ReaderLink(Field(unit, "id"), (chosen.Provider ?? sources[0].Provider).ProviderKey);
   }
   return $"#{unitHeading}";
  }
 }
 ResumeEntry? readingHistory;

 async Task ToggleFavorite()
 {
  if (savedTitle is not { } item) return;
  try { await Store.SetFavouriteAsync(item.Id, !item.IsFavourite); item.IsFavourite = !item.IsFavourite; }
  catch { error = "Could not update this title’s favorite status."; }
 }
 ElementReference sourcePanel;
 bool focusSources;

 Task SelectUnit(JsonElement unit)
 {
  Choose(unit);
  if (ShowDetailActions && ReaderProvider is null && targets.Count == 1)
  {
   Navigation.NavigateTo(ReaderLink(unitId, targets[0].Provider.ProviderKey));
   return Task.CompletedTask;
  }
  focusSources = IsManga && ShowDetailActions;
  return Task.CompletedTask;
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if (!focusSources) return;
  focusSources = false;
  try { await sourcePanel.FocusAsync(); }
  catch (JSException) { }
 }
 bool IsManga => Catalog.Type == "manga";
 const int UnitsPerPage = 15;
 string unitSearch = "", group = "", releaseSort = "";
 bool reverseUnits, gridUnits;
 int unitPage;
 readonly string unitHeading = $"releases-{Guid.NewGuid():N}";

 static string ReleaseGroup(JsonElement unit) => Field(unit, "group") is { Length: > 0 } value ? value : Field(unit, "scanlationGroup");
 string[] ReleaseGroups => units.Select(ReleaseGroup).Where(value => value.Length > 0)
  .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(value => value).ToArray();
 static DateTimeOffset? ReleaseDate(JsonElement unit) =>
  DateTimeOffset.TryParse(Field(unit, "releasedAt"), System.Globalization.CultureInfo.InvariantCulture,
   System.Globalization.DateTimeStyles.AssumeUniversal, out var date) ? date : null;
 static decimal? Volume(JsonElement unit) =>
  unit.ValueKind == JsonValueKind.Object && unit.TryGetProperty("volume", out var value) &&
  (value.ValueKind == JsonValueKind.String || value.ValueKind == JsonValueKind.Number) &&
  decimal.TryParse(value.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture,
   out var number) ? number : null;
 bool HasReleaseDate => units.Any(unit => ReleaseDate(unit).HasValue);
 bool HasVolume => units.Any(unit => Volume(unit).HasValue);
 IEnumerable<JsonElement> OrderedUnits => releaseSort switch
 {
  "date" => units.OrderByDescending(ReleaseDate),
  "volume" => units.OrderBy(unit => Volume(unit) ?? decimal.MaxValue),
  _ => units
 };
 IEnumerable<JsonElement> VisibleUnits => (reverseUnits ? OrderedUnits.Reverse() : OrderedUnits).Where(unit =>
  (group.Length == 0 || group.Equals(ReleaseGroup(unit), StringComparison.OrdinalIgnoreCase)) &&
  (unitSearch.Trim().Length == 0 || Field(unit, "title").Contains(unitSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
    Field(unit, "id").Contains(unitSearch.Trim(), StringComparison.OrdinalIgnoreCase)));
 void ResetUnitPage() => unitPage = 0;
 void ReverseUnits() { reverseUnits = !reverseUnits; ResetUnitPage(); }

 Task SelectTitle(JsonElement item)
 {
  var id = Field(item, "id");
  if (!OpenMangaPage || !Source.Supports("chapters", "manga", id)) return Open(item);
  Navigation.NavigateTo(AniKatha.UI.Pages.MangaDetails.ProviderPath(Source.ProviderKey, id, Field(item, "name")));
  return Task.CompletedTask;
 }
 string? TitlePoster => MediaUrl(Field(details,"poster")) ? Field(details,"poster") :
  selected is { } item && MediaUrl(Field(item,"poster")) ? Field(item,"poster") : null;
 [Parameter] public string? InitialProviderId { get; set; }
 [Parameter] public int? ExpectedAniListId { get; set; }
 [Parameter,EditorRequired] public AddonResources Source {get;set;}=null!;
 [Parameter,EditorRequired] public AddonCatalog Catalog {get;set;}=null!;
 [Parameter,EditorRequired] public List<AddonResources> Providers {get;set;}=[];
 List<JsonElement> titles=[],units=[];
 List<(AddonResources Provider, string UnitId)> targets=[];
 JsonElement? selected;
 JsonElement details;
 AddonAniListProgress? aniListProgress;
 Dictionary<string, (bool Completed, string? HistoryId)> progress = new();
 string? continueLink;
 string applied="",titleId="",label="";
 string? unitId,error;
 bool busy,more,retryMeta,retryReset,dimWatched;
 int offset;
 Dictionary<string, string> extraValues = new(StringComparer.Ordinal);
 IEnumerable<CatalogExtra> AdditionalExtras => Catalog.Extras.Where(x => x.Name is not ("search" or "skip"));
 string ExtraValue(string name) => extraValues.GetValueOrDefault(name, "");
 bool MissingRequired => Catalog.Extras.Any(x => x.Required && x.Name != "skip" &&
  (x.Name == "search" ? string.IsNullOrWhiteSpace(SubmittedQuery) : ExtraValue(x.Name).Length == 0));

 Task ChangeExtra(string name, ChangeEventArgs args)
 {
  extraValues[name] = (args.Value as string ?? "").Trim();
  return Load(true);
 }

 HashSet<string> seenTitles = new(StringComparer.Ordinal);
 bool HasFilters => Filters is { } f && (f.Genre is { Length: > 0 } || f.Year.HasValue ||
  f.Season is { Length: > 0 } || f.Format is { Length: > 0 });

 bool MatchesFilters(JsonElement item)
 {
  if (Filters is not { } filters) return true;
  if (filters.Genre is { Length: > 0 } && !Items(item,"genres").Any(x =>
       x.ValueKind == JsonValueKind.String && string.Equals(x.GetString(), filters.Genre, StringComparison.OrdinalIgnoreCase)))
   return false;
  if (filters.Year is int year && Field(item,"year") != year.ToString(System.Globalization.CultureInfo.InvariantCulture) &&
      !(item.TryGetProperty("year", out var value) && value.ValueKind == JsonValueKind.Number && value.TryGetInt32(out var itemYear) && itemYear == year))
   return false;
  return (string.IsNullOrEmpty(filters.Season) || string.Equals(Field(item,"season"), filters.Season, StringComparison.OrdinalIgnoreCase)) &&
         (string.IsNullOrEmpty(filters.Format) || string.Equals(Field(item,"format"), filters.Format, StringComparison.OrdinalIgnoreCase));
 }
 CancellationTokenSource? active;
 bool saved, disposed;
 long progressRequest;
 string? autoOpenSource;
 ManifestSources? activeVideo;
 bool switchingVideo, nextSourceUnavailable;

 async Task<bool> ActivateVideo(ManifestSources next)
 {
  if (disposed || switchingVideo) return false;
  switchingVideo = true;
  try
  {
   var previous = activeVideo;
   if (previous is not null && !await previous.ReleaseVideoAsync(next)) return false;
   if (disposed || next.IsDisposed) return false;
   activeVideo = next;
   return true;
  }
  finally { switchingVideo = false; }
 }
 readonly string episodeSources = $"unit-sources-{Guid.NewGuid():N}";

 string? GetNextEpisodeLabel()
 {
  if (Catalog.Type == "manga" || !CanMove(1)) return null;
  var index = units.FindIndex(unit => Field(unit, "id") == unitId);
  return Field(units[index + 1], "title");
 }

 bool CanMove(int direction)
 {
  var index = units.FindIndex(unit => Field(unit, "id") == unitId);
  return index >= 0 && index + direction >= 0 && index + direction < units.Count;
 }

 void MoveUnit(int direction, string providerKey)
 {
  if (!CanMove(direction)) return;
  var index = units.FindIndex(unit => Field(unit, "id") == unitId);
  var unit = units[index + direction];
  if (ReaderProvider is not null)
  {
   var sources = Source.ResolveUnitProviders(Catalog.Type, unit, Providers).ToArray();
   if (sources.Length == 0) { Navigation.NavigateTo(AniKatha.UI.Pages.MangaDetails.ProviderPath(Source.ProviderKey, titleId, DisplayTitle, Field(unit, "id"), From)); return; }
   var sameSource = sources.FirstOrDefault(target => target.Provider.ProviderKey == providerKey);
   Navigation.NavigateTo(ReaderLink(Field(unit, "id"), (sameSource.Provider ?? sources[0].Provider).ProviderKey), replace: true);
  }
  else Choose(unit, providerKey);
 }

 string preferredSource = "";
 bool preferenceError;
 string PreferenceKey => $"preferred-source:{Source.ProviderKey}/{Catalog.Type}/{Uri.EscapeDataString(titleId)}";

 async Task SetPreferredSource(ChangeEventArgs args)
 {
  var value = args.Value as string ?? "";
  if (value.Length > 0 && !targets.Any(target => target.Provider.ProviderKey == value)) return;
  var token = active?.Token ?? CancellationToken.None;
  var key = PreferenceKey;
  preferredSource = value;
  preferenceError = false;
  try { await Store.SetSettingAsync(key, value); }
  catch { if (!token.IsCancellationRequested) preferenceError = true; }
 }
 (string, string, string) PageKey => (Source.ProviderKey, Catalog.Type, Catalog.Id);
 bool pageLoaded;
 protected override Task OnInitializedAsync()
 {
  if (InitialTitle is not null)
   return Open(JsonSerializer.SerializeToElement(new { id = InitialProviderId ?? InitialTitle.ExternalId, name = InitialTitle.Title, poster = InitialTitle.Poster }));
  if (Session?.GetValueOrDefault(PageKey) is not { } saved) return Load(true);
  applied = SubmittedQuery ?? "";
  (extraValues, titles, seenTitles, offset, more, error) =
   (saved.Extras, saved.Titles, saved.Seen, saved.Offset, saved.More, saved.Error);
  pageLoaded = true;
  return Task.CompletedTask;
 }
 async Task RefreshSavedTitle(CancellationToken token)
 {
  var id = titleId;
  var local = (await Store.GetLibraryAsync()).FirstOrDefault(item => item.ProviderKey == Source.ProviderKey &&
    item.ResourceType == Catalog.Type && item.ExternalId == id);
  if (!token.IsCancellationRequested && id == titleId) savedTitle = local;
 }

 async Task SaveTitle()
 {
  if(selected==null)return;
  try { await Store.SaveProviderTitleAsync(Source.ProviderKey,Catalog.Type,titleId,Field(details, "name") is { Length: > 0 } name ? name : Field(selected.Value,"name"),
    Field(details,"poster") is { Length: > 0 } poster && MediaUrl(poster) ? poster :
    MediaUrl(Field(selected.Value,"poster")) ? Field(selected.Value,"poster") : null);
   saved = true;
   if (ShowDetailActions) await RefreshSavedTitle(active?.Token ?? CancellationToken.None);
  }
  catch {error="Could not save this title.";}
 }
 CancellationToken Begin(){
  active?.Cancel();active?.Dispose();active=new();busy=true;error=null;return active.Token;
 }
 Task Retry()=>retryMeta && selected.HasValue ? Open(selected.Value) : Load(retryReset);
 async Task Load(bool reset){
  var token=Begin();retryMeta=false;retryReset=reset;
  if(reset){pageLoaded=false;titles.Clear();seenTitles.Clear();offset=0;more=false;applied=SubmittedQuery ?? "";selected=null;details=default;unitId=null;activeVideo=null;}
  if (MissingRequired)
  {
   busy = false;
   pageLoaded = true;
   return;
  }
  try{
   var extras = AdditionalExtras.Where(extra => ExtraValue(extra.Name).Length > 0)
    .Select(extra => Uri.EscapeDataString(extra.Name) + "=" + Uri.EscapeDataString(ExtraValue(extra.Name))).ToList();
   if(applied.Length>0)extras.Add("search="+Uri.EscapeDataString(applied));
   if (offset > 0 || Catalog.Extras.Any(x => x.Name == "skip" && x.Required))
    extras.Add("skip=" + offset.ToString(System.Globalization.CultureInfo.InvariantCulture));
   var uri=Source.Resource("catalog",Catalog.Type,Catalog.Id,extras.Count==0?null:string.Join("&",extras));
   var root=await Client.FetchJsonAsync(uri,token);
   if (!root.TryGetProperty("metas",out var list) || list.ValueKind!=JsonValueKind.Array) throw new FormatException();
   token.ThrowIfCancellationRequested();
   var page=Items(root,"metas").ToList();
   var before = seenTitles.Count;
   foreach (var item in page)
   {
    var id = Field(item, "id");
    var type = Field(item, "type");
    if (id.Length == 0 || type.Length > 0 && type != Catalog.Type || !seenTitles.Add(id))
     continue;
    if (MatchesFilters(item)) titles.Add(item);
   }
   offset += page.Count;
   more = Catalog.Skip && seenTitles.Count > before;
  }catch(OperationCanceledException) when(token.IsCancellationRequested){}
  catch(Exception){if(!token.IsCancellationRequested)error="Catalogue request failed.";}
  finally{if(!token.IsCancellationRequested){busy=false;pageLoaded=true;}}
 }
 async Task Open(JsonElement item){
  var token=Begin();retryMeta=true;saved=false;savedTitle=null;readingHistory=null;selected=item;details=default;preferredSource="";preferenceError=false;progress.Clear();continueLink=null;titleId=Field(item,"id");unitId=null;activeVideo=null;units=[];
  unitSearch = group = releaseSort = ""; ResetUnitPage();
  try{
   var resource=Catalog.Type=="manga"?"chapters":"meta";
   if(!Source.Supports(resource,Catalog.Type,titleId)){error="Source does not supply title details.";return;}
   var root=await Client.FetchJsonAsync(Source.Resource(resource,Catalog.Type,titleId),token);
   token.ThrowIfCancellationRequested();
   if (root.TryGetProperty("meta", out var metadata) && metadata.ValueKind == JsonValueKind.Object)
    details = metadata;
   if (ExpectedAniListId is int expected && AddonAniListProgress.TitleId(details) != expected)
   {
    error = "This source no longer confirms the AniList match.";
    return;
   }
   units = (resource == "chapters" ? Items(root, "chapters") : Items(details, "videos"))
    .Where(unit => Field(unit, "id").Length > 0).ToList();
   var preference = await Store.GetSettingAsync(PreferenceKey);
   if (token.IsCancellationRequested) return;
   preferredSource = preference ?? "";
   if (ShowDetailActions && ReaderProvider is null) await RefreshSavedTitle(token);
   await RefreshProgress();
   if (!token.IsCancellationRequested && InitialUnitId is { } initialUnit)
   {
    var match = units.FirstOrDefault(unit => Field(unit, "id") == initialUnit);
    if (match.ValueKind != JsonValueKind.Undefined) Choose(match);
   }
  }catch(OperationCanceledException) when(token.IsCancellationRequested){}
  catch(Exception){if(!token.IsCancellationRequested)error="Title request failed.";}
  finally{if(!token.IsCancellationRequested)busy=false;}
 }
 async Task RefreshProgress()
 {
  if (disposed) return;
  var request = ++progressRequest;
  var token = active?.Token ?? CancellationToken.None;
  var currentTitle = titleId;
  var dim = await Store.GetSettingAsync(MediaPreferences.DimWatchedKey) == "true";
  var entries = (await Store.HistoryAsync()).Where(entry => entry.Origin == Source.ProviderKey &&
   entry.Type == Catalog.Type && entry.TitleId == currentTitle).ToList();
  var current = new Dictionary<string, (bool Completed, string? HistoryId)>(StringComparer.Ordinal);
  var unfinished = new HashSet<string>(StringComparer.Ordinal);
  foreach (var unit in units)
  {
   var id = Field(unit, "id");
   foreach (var target in Source.ResolveUnitProviders(Catalog.Type, unit, Providers))
   {
    var entry = entries.FirstOrDefault(x => x.Source == target.Provider.ProviderKey && x.UnitId == target.UnitId);
    if (entry is null) continue;
    var key = ResumeEntry.Key(entry.Origin, entry.Type, entry.TitleId, entry.UnitId, entry.Source);
    var complete = await Store.IsUnitCompleteAsync(key);
    if (token.IsCancellationRequested) return;
    if (!current.TryGetValue(id, out var prior) || complete)
     current[id] = (complete, entry.Id);
   }
   if (current.TryGetValue(id, out var status) && !status.Completed && status.HistoryId is not null)
    unfinished.Add(status.HistoryId);
  }
  if (token.IsCancellationRequested || request != progressRequest) return;
  dimWatched = dim;
  progress = current;
  readingHistory = entries.FirstOrDefault(entry => unfinished.Contains(entry.Id));
  continueLink = readingHistory?.Id;
 }
 void Choose(JsonElement unit, string? autoOpen = null)
 {
  var nextUnit = Field(unit, "id");
  if (unitId != nextUnit) activeVideo = null;
  autoOpenSource = autoOpen;
  unitId = Field(unit, "id");
  label = Field(unit, "title");
  aniListProgress = AddonAniListProgress.Read(Catalog.Type, details, unit);
  targets = Source.ResolveUnitProviders(Catalog.Type, unit, Providers).ToList();
  nextSourceUnavailable = Catalog.Type != "manga" && autoOpen is not null &&
   !targets.Any(target => target.Provider.ProviderKey == autoOpen);
 }
 public void Dispose()
 {
  disposed = true;
  active?.Cancel();
  active?.Dispose();
  if (Session is not null && pageLoaded)
   Session[PageKey] = new(extraValues, titles, seenTitles, offset, more, retryMeta ? null : error);
 }
}
