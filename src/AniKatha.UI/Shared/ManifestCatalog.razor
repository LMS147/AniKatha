@using System.Text.Json
@using static AniKatha.Core.AddonResources
@implements IDisposable
@inject AddonClient Client
@inject LocalStore Store

<section class="settings-card">
 <h3>@Source.Addon.Name @Catalog.Name</h3>
 @if (HasFilters) { <p>Filters check loaded titles only. Titles missing the selected metadata are excluded.</p> }
 @if (InitialTitle is null)
 {
  @foreach (var extra in AdditionalExtras)
  {
   <label>
    @extra.Name @(extra.Required ? "(required)" : "")
    @if (extra.Options.Count > 0)
    {
     <select value="@ExtraValue(extra.Name)" @onchange="args => ChangeExtra(extra.Name, args)">
      <option value="">Choose @extra.Name</option>
      @foreach (var option in extra.Options) { <option value="@option">@option</option> }
     </select>
    }
    else { <input value="@ExtraValue(extra.Name)" @onchange="args => ChangeExtra(extra.Name, args)" /> }
   </label>
  }
  @if (MissingRequired) { <p>Provide the required filters to search or browse this catalogue.</p> }
 }
 @foreach(var item in titles){
  <button class="secondary" @onclick="()=>Open(item)">@Field(item,"name")</button>
 }
 @if(more){<button disabled="@busy" @onclick="()=>Load(false)">Load more</button>}
 @if(busy){<p role="status">Loading…</p>}
 @if(error!=null){<p role="alert">@error <button @onclick="Retry">Retry</button></p>}
 @if(!busy && error==null && titles.Count==0 && !MissingRequired){<p>No matching titles.</p>}
 @if(selected!=null){
  <ProviderTitleDetails Listing="selected.Value" Details="details" Type="@Catalog.Type"/>
  @if(InitialTitle==null){<button disabled="@saved" @onclick="SaveTitle">@(saved?"Saved to library":"Save to library")</button>}
  @foreach (var unit in units)
  {
   var id = Field(unit, "id");
   <div>
    <button class="secondary" @onclick="() => Choose(unit)" aria-pressed="@(unitId == id)">@Field(unit,"title")</button>
    @if (progress.TryGetValue(id, out var unitProgress))
    {
     <small>@(unitProgress.Completed ? "Completed" : "In progress")</small>
     @if (!unitProgress.Completed && continueLink == unitProgress.HistoryId)
     {
      <a class="text-link" href="@($"/resume/{continueLink}")">Continue @Field(unit,"title")</a>
     }
    }
   </div>
  }
  @if(!busy && error==null && units.Count==0){<p>No episodes or chapters available.</p>}
 }
 @if(unitId!=null){
  @if (targets.Count == 0) { <p>No compatible add-on.</p> }
  @if (targets.Count > 0 || preferredSource.Length > 0)
  {
   <label>Preferred source for this title
    <select value="@preferredSource" @onchange="SetPreferredSource">
     <option value="">No preference</option>
     @if (preferredSource.Length > 0 && !targets.Any(target => target.Provider.ProviderKey == preferredSource))
     {
      <option value="@preferredSource">Preferred source unavailable for this unit</option>
     }
     @foreach (var target in targets)
     {
      <option value="@target.Provider.ProviderKey">@target.Provider.Addon.Name</option>
     }
    </select>
   </label>
   @if (preferenceError) { <p role="alert">Could not save the preferred source.</p> }
  }
  @foreach(var target in targets.OrderByDescending(target => target.Provider.ProviderKey == preferredSource)){
   <ManifestSources @key="(target.Provider.ProviderKey,target.UnitId,titleId)" Source="target.Provider" Origin="@Source.ProviderKey" Type="@Catalog.Type" TitleId="@titleId" UnitId="@target.UnitId" Label="@label" Title="@Field(selected!.Value,"name")" Preferred="@(target.Provider.ProviderKey == preferredSource)" AutoOpen="@(target.Provider.ProviderKey == autoOpenSource)" NextEpisode="@(CanMove(1) && Catalog.Type != "manga" ? EventCallback.Factory.Create(this, () => MoveUnit(1, target.Provider.ProviderKey)) : default)" ProgressChanged="RefreshProgress"/>
  }
 }
</section>

@code {
 [Parameter] public Dictionary<(string Provider, string Type, string Id), CatalogPage>? Session { get; set; }
 [Parameter] public SearchOptions? Filters { get; set; }
 [Parameter] public string? SubmittedQuery { get; set; }
 [Parameter] public SavedTitle? InitialTitle {get;set;}
 [Parameter,EditorRequired] public AddonResources Source {get;set;}=null!;
 [Parameter,EditorRequired] public AddonCatalog Catalog {get;set;}=null!;
 [Parameter,EditorRequired] public List<AddonResources> Providers {get;set;}=[];
 List<JsonElement> titles=[],units=[];
 List<(AddonResources Provider, string UnitId)> targets=[];
 JsonElement? selected;
 JsonElement details;
 Dictionary<string, (bool Completed, string? HistoryId)> progress = new();
 string? continueLink;
 string applied="",titleId="",label="";
 string? unitId,error;
 bool busy,more,retryMeta,retryReset;
 int offset;
 Dictionary<string, string> extraValues = new(StringComparer.Ordinal);
 IEnumerable<CatalogExtra> AdditionalExtras => Catalog.Extras.Where(x => x.Name is not ("search" or "skip"));
 string ExtraValue(string name) => extraValues.GetValueOrDefault(name, "");
 bool MissingRequired => Catalog.Extras.Any(x => x.Required && x.Name != "skip" &&
  (x.Name == "search" ? string.IsNullOrWhiteSpace(SubmittedQuery) : ExtraValue(x.Name).Length == 0));

 Task ChangeExtra(string name, ChangeEventArgs args)
 {
  extraValues[name] = (args.Value as string ?? "").Trim();
  return Load(true);
 }

 HashSet<string> seenTitles = new(StringComparer.Ordinal);
 bool HasFilters => Filters is { } f && (f.Genre is { Length: > 0 } || f.Year.HasValue ||
  f.Season is { Length: > 0 } || f.Format is { Length: > 0 });

 bool MatchesFilters(JsonElement item)
 {
  if (Filters is not { } filters) return true;
  if (filters.Genre is { Length: > 0 } && !Items(item,"genres").Any(x =>
       x.ValueKind == JsonValueKind.String && string.Equals(x.GetString(), filters.Genre, StringComparison.OrdinalIgnoreCase)))
   return false;
  if (filters.Year is int year && Field(item,"year") != year.ToString(System.Globalization.CultureInfo.InvariantCulture) &&
      !(item.TryGetProperty("year", out var value) && value.ValueKind == JsonValueKind.Number && value.TryGetInt32(out var itemYear) && itemYear == year))
   return false;
  return (string.IsNullOrEmpty(filters.Season) || string.Equals(Field(item,"season"), filters.Season, StringComparison.OrdinalIgnoreCase)) &&
         (string.IsNullOrEmpty(filters.Format) || string.Equals(Field(item,"format"), filters.Format, StringComparison.OrdinalIgnoreCase));
 }
 CancellationTokenSource? active;
 bool saved, disposed;
 long progressRequest;
 string? autoOpenSource;
 bool CanMove(int direction)
 {
  var index = units.FindIndex(unit => Field(unit, "id") == unitId);
  return index >= 0 && index + direction >= 0 && index + direction < units.Count;
 }

 void MoveUnit(int direction, string providerKey)
 {
  if (!CanMove(direction)) return;
  var index = units.FindIndex(unit => Field(unit, "id") == unitId);
  Choose(units[index + direction], providerKey);
 }

 string preferredSource = "";
 bool preferenceError;
 string PreferenceKey => $"preferred-source:{Source.ProviderKey}/{Catalog.Type}/{Uri.EscapeDataString(titleId)}";

 async Task SetPreferredSource(ChangeEventArgs args)
 {
  var value = args.Value as string ?? "";
  if (value.Length > 0 && !targets.Any(target => target.Provider.ProviderKey == value)) return;
  var token = active?.Token ?? CancellationToken.None;
  var key = PreferenceKey;
  preferredSource = value;
  preferenceError = false;
  try { await Store.SetSettingAsync(key, value); }
  catch { if (!token.IsCancellationRequested) preferenceError = true; }
 }
 (string, string, string) PageKey => (Source.ProviderKey, Catalog.Type, Catalog.Id);
 bool pageLoaded;
 protected override Task OnInitializedAsync()
 {
  if (InitialTitle is not null)
   return Open(JsonSerializer.SerializeToElement(new { id = InitialTitle.ExternalId, name = InitialTitle.Title, poster = InitialTitle.Poster }));
  if (Session?.GetValueOrDefault(PageKey) is not { } saved) return Load(true);
  applied = SubmittedQuery ?? "";
  (extraValues, titles, seenTitles, offset, more, error) =
   (saved.Extras, saved.Titles, saved.Seen, saved.Offset, saved.More, saved.Error);
  pageLoaded = true;
  return Task.CompletedTask;
 }
 async Task SaveTitle()
 {
  if(selected==null)return;
  try { await Store.SaveProviderTitleAsync(Source.ProviderKey,Catalog.Type,titleId,Field(selected.Value,"name"),
    Field(details,"poster") is { Length: > 0 } poster && MediaUrl(poster) ? poster :
    MediaUrl(Field(selected.Value,"poster")) ? Field(selected.Value,"poster") : null);saved=true; }
  catch {error="Could not save this title.";}
 }
 CancellationToken Begin(){
  active?.Cancel();active?.Dispose();active=new();busy=true;error=null;return active.Token;
 }
 Task Retry()=>retryMeta && selected.HasValue ? Open(selected.Value) : Load(retryReset);
 async Task Load(bool reset){
  var token=Begin();retryMeta=false;retryReset=reset;
  if(reset){pageLoaded=false;titles.Clear();seenTitles.Clear();offset=0;more=false;applied=SubmittedQuery ?? "";selected=null;details=default;unitId=null;}
  if (MissingRequired)
  {
   busy = false;
   pageLoaded = true;
   return;
  }
  try{
   var extras = AdditionalExtras.Where(extra => ExtraValue(extra.Name).Length > 0)
    .Select(extra => Uri.EscapeDataString(extra.Name) + "=" + Uri.EscapeDataString(ExtraValue(extra.Name))).ToList();
   if(applied.Length>0)extras.Add("search="+Uri.EscapeDataString(applied));
   if (offset > 0 || Catalog.Extras.Any(x => x.Name == "skip" && x.Required))
    extras.Add("skip=" + offset.ToString(System.Globalization.CultureInfo.InvariantCulture));
   var uri=Source.Resource("catalog",Catalog.Type,Catalog.Id,extras.Count==0?null:string.Join("&",extras));
   var root=await Client.FetchJsonAsync(uri,token);
   if (!root.TryGetProperty("metas",out var list) || list.ValueKind!=JsonValueKind.Array) throw new FormatException();
   token.ThrowIfCancellationRequested();
   var page=Items(root,"metas").ToList();
   var before = seenTitles.Count;
   foreach (var item in page)
   {
    var id = Field(item, "id");
    var type = Field(item, "type");
    if (id.Length == 0 || type.Length > 0 && type != Catalog.Type || !seenTitles.Add(id))
     continue;
    if (MatchesFilters(item)) titles.Add(item);
   }
   offset += page.Count;
   more = Catalog.Skip && seenTitles.Count > before;
  }catch(OperationCanceledException) when(token.IsCancellationRequested){}
  catch(Exception){if(!token.IsCancellationRequested)error="Catalogue request failed.";}
  finally{if(!token.IsCancellationRequested){busy=false;pageLoaded=true;}}
 }
 async Task Open(JsonElement item){
  var token=Begin();retryMeta=true;saved=false;selected=item;details=default;preferredSource="";preferenceError=false;progress.Clear();continueLink=null;titleId=Field(item,"id");unitId=null;units=[];
  try{
   var resource=Catalog.Type=="manga"?"chapters":"meta";
   if(!Source.Supports(resource,Catalog.Type,titleId)){error="Source does not supply title details.";return;}
   var root=await Client.FetchJsonAsync(Source.Resource(resource,Catalog.Type,titleId),token);
   token.ThrowIfCancellationRequested();
   if (root.TryGetProperty("meta", out var metadata) && metadata.ValueKind == JsonValueKind.Object)
    details = metadata;
   units = (resource == "chapters" ? Items(root, "chapters") : Items(details, "videos"))
    .Where(unit => Field(unit, "id").Length > 0).ToList();
   var preference = await Store.GetSettingAsync(PreferenceKey);
   if (token.IsCancellationRequested) return;
   preferredSource = preference ?? "";
   await RefreshProgress();
  }catch(OperationCanceledException) when(token.IsCancellationRequested){}
  catch(Exception){if(!token.IsCancellationRequested)error="Title request failed.";}
  finally{if(!token.IsCancellationRequested)busy=false;}
 }
 async Task RefreshProgress()
 {
  if (disposed) return;
  var request = ++progressRequest;
  var token = active?.Token ?? CancellationToken.None;
  var currentTitle = titleId;
  var entries = (await Store.HistoryAsync()).Where(entry => entry.Origin == Source.ProviderKey &&
   entry.Type == Catalog.Type && entry.TitleId == currentTitle).ToList();
  var current = new Dictionary<string, (bool Completed, string? HistoryId)>(StringComparer.Ordinal);
  var unfinished = new HashSet<string>(StringComparer.Ordinal);
  foreach (var unit in units)
  {
   var id = Field(unit, "id");
   foreach (var target in Source.ResolveUnitProviders(Catalog.Type, unit, Providers))
   {
    var entry = entries.FirstOrDefault(x => x.Source == target.Provider.ProviderKey && x.UnitId == target.UnitId);
    if (entry is null) continue;
    var key = ResumeEntry.Key(entry.Origin, entry.Type, entry.TitleId, entry.UnitId, entry.Source);
    var complete = await Store.IsUnitCompleteAsync(key);
    if (token.IsCancellationRequested) return;
    if (!current.TryGetValue(id, out var prior) || complete)
     current[id] = (complete, entry.Id);
   }
   if (current.TryGetValue(id, out var status) && !status.Completed && status.HistoryId is not null)
    unfinished.Add(status.HistoryId);
  }
  if (token.IsCancellationRequested || request != progressRequest) return;
  progress = current;
  continueLink = entries.FirstOrDefault(entry => unfinished.Contains(entry.Id))?.Id;
 }
 void Choose(JsonElement unit, string? autoOpen = null)
 {
  autoOpenSource = autoOpen;
  unitId = Field(unit, "id");
  label = Field(unit, "title");
  targets = Source.ResolveUnitProviders(Catalog.Type, unit, Providers).ToList();
 }
 public void Dispose()
 {
  disposed = true;
  active?.Cancel();
  active?.Dispose();
  if (Session is not null && pageLoaded)
   Session[PageKey] = new(extraValues, titles, seenTitles, offset, more, retryMeta ? null : error);
 }
}
