@using System.Text.Json
@using static AniKatha.Core.AddonResources

@if (!DescriptionOnly)
{
 <header class="design-title-card @(Standalone ? "template-manga-cover" : null)">
  @if (MediaUrl(Poster) && failedPoster != Poster)
  {
   <img class="provider-detail-poster" src="@Poster" alt="" loading="lazy" @onerror="() => failedPoster = Poster" />
  }
  else if (Standalone)
  {
   <div class="manga-cover-placeholder" aria-hidden="true"><Icon Name="book" /></div>
  }
  <div>
   <span class="eyebrow">@(Type == "manga" ? "Manga" : "Anime")</span>
   @if (!Standalone) { <h3>@Name</h3> }
   @if (Standalone)
   {
    <div class="chips">
     @foreach (var fact in Facts) { <span>@fact</span> }
    </div>
   }
   @if (Count is int count) { <p>@count @UnitLabel(count)</p> }
   @if (!Standalone && Status.Length > 0) { <p>Release status · @Status</p> }
  </div>
 </header>
 @if (Standalone)
 {
  <section class="template-title-credits"><h1>@Name</h1>
   @if (Text("alternateTitle") is { Length: > 0 } alternate && alternate != Name) { <p>@alternate</p> }
  </section>
 }
}
@if (!HideSynopsis)
{
 @if (Synopsis.Length > 0) { <details class="template-synopsis manga-provider-synopsis" open><summary>Synopsis</summary><p>@Synopsis</p></details> }
 @if (Genres.Length > 0)
 {
  @if (DescriptionOnly)
  {
   <details class="template-synopsis" open><summary>Details</summary><h3>Genres</h3>
    <div class="chips">@foreach (var genre in Genres) { <span>@genre</span> }</div>
   </details>
  }
  else { <div class="chips">@foreach (var genre in Genres) { <span>@genre</span> }</div> }
 }
}

@code {
 [Parameter] public JsonElement Listing { get; set; }
 [Parameter] public JsonElement Details { get; set; }
 [Parameter] public bool Standalone { get; set; }
 [Parameter] public bool HideSynopsis { get; set; }
 [Parameter] public bool DescriptionOnly { get; set; }
 string? failedPoster;
 IEnumerable<string> Facts => new[] { Text("format"), Year, Status, Text("originalLanguage") }
  .Where(value => value.Length > 0);
 string Year => new[] { Details, Listing }.Where(item => item.ValueKind == JsonValueKind.Object)
  .Select(item => item.TryGetProperty("year", out var year) && year.ValueKind == JsonValueKind.Number ? year.ToString() : "")
  .FirstOrDefault(year => year.Length > 0) ?? "";
 [Parameter] public string Type { get; set; } = "";

 string Name => Text("name");
 string Poster => Text("poster");
 string Synopsis => Text("description") is { Length: > 0 } description ? description : Text("synopsis");
 string Status => Text("status");
 string[] Genres => new[] { Details, Listing }
  .Select(item => Items(item, "genres").Where(value => value.ValueKind == JsonValueKind.String)
   .Select(value => value.GetString()!).Where(value => value.Length > 0).ToArray())
  .FirstOrDefault(genres => genres.Length > 0) ?? [];
 int? Count => ReadCount(Details) ?? ReadCount(Listing);

 string Text(string key) => Field(Details, key) is { Length: > 0 } value ? value : Field(Listing, key);
 string UnitLabel(int count) => Type == "manga" ? (count == 1 ? "chapter" : "chapters") : (count == 1 ? "episode" : "episodes");

 int? ReadCount(JsonElement item)
 {
  var field = Type == "manga" ? "chapterCount" : "episodeCount";
  if (item.ValueKind == JsonValueKind.Object && item.TryGetProperty(field, out var value) &&
      value.ValueKind == JsonValueKind.Number && value.TryGetInt32(out var count) && count >= 0)
   return count;
  return null;
 }
}
