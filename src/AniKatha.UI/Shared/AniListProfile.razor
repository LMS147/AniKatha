@inherits ProfileComponent
@implements IDisposable

<section class="settings-card tracking-account" aria-label="AniList account">
 @if (loading)
 {
  <p role="status">Opening AniList settings…</p>
 }
 else if (link is null)
 {
  <div class="tracking-account-heading">
   <span class="tracking-account-avatar" aria-hidden="true">AL</span>
   <div><h2>AniList account</h2><p>Sync your anime and manga lists, scores, and completed progress.</p></div>
  </div>
  @if (ProfileAniList?.CanConnect == true)
  {
   <button class="primary" disabled="@(operation is not null)" @onclick="Connect">Connect AniList</button>
  }
  else
  {
   <p class="tracking-badge"><span aria-hidden="true">◇</span> AniList sign-in is unavailable for this build.</p>
  }
 }
 else
 {
  <div class="tracking-account-heading">
   <div class="profile-sync-avatar">
   @if (link.Viewer.Avatar is { } avatar && failedAvatar != avatar && AddonResources.MediaUrl(avatar))
   {
    <img class="tracking-account-avatar" src="@avatar" alt="" width="56" height="56" @onerror="() => failedAvatar = avatar" />
   }
   else
   {
    <span class="tracking-account-avatar" aria-hidden="true">@ProfileAvatar.Glyph(link.Viewer.Name, "")</span>
   }
   @if (Template && link.RequiresReconnect == false) { <span class="profile-sync-check" aria-hidden="true">✓</span> }
   </div>
   <div><span class="muted">Linked AniList account</span><h2>@link.Viewer.Name</h2>
    <p class="tracking-badge" role="status"><span aria-hidden="true">@StateIcon</span> @State</p>
   </div>
  </div>
  @if (Template)
  {
   <dl class="profile-sync-facts">
    <div><dt>Last list import</dt><dd>
     @if (summary.LastImport is { } date) { <time datetime="@date.ToString("O")">@date.ToLocalTime().ToString("MMM d, h:mm tt")</time> }
     else { <span>—</span> }
    </dd></div>
    <div><dt>Auto-sync</dt><dd>@(automatic ? "Enabled" : "Disabled")</dd></div>
   </dl>
  }
  else if (summary.LastImport is { } lastImport)
  {
   <p class="muted">Last list import <time datetime="@lastImport.ToString("O")">@lastImport.ToLocalTime().ToString("g")</time></p>
  }
  @if (pending > 0)
  {
   <p class="tracking-pending" role="status">@pending @(pending == 1 ? "change" : "changes") saved on this device · Waiting to sync</p>
  }
  <div class="settings-actions profile-sync-actions">
   @if (link.RequiresReconnect)
   {
    @if (ProfileAniList?.CanConnect == true)
    {
     <button class="primary" disabled="@(operation is not null)" @onclick="Connect">Reconnect AniList</button>
    }
   }
   else
   {
    <button class="@(Template || pending > 0 ? "primary" : "secondary")" disabled="@(operation is not null)" @onclick="Retry">@if (Template) { <Icon Name="sync" /> }Sync now</button>
    <button class="@(!Template && pending == 0 ? "primary" : "secondary")" disabled="@(operation is not null)" @onclick="Import">
     @if (Template) { <Icon Name="download" /> }
     @(summary.HasImported ? "Refresh lists" : "Import lists")
    </button>
   }
   @if (showLibrary) { <a class="secondary" href="/library">Open Library</a> }
  </div>
  @if (Template)
  {
   @DisconnectControls
  }
  else { <p class="muted">Import adds Anime and Manga tracking entries to Library. Installed add-ons provide video and chapter pages.</p> }
 }
 @if (operation is not null) { <p role="status">@operation</p> }
 @if (message is not null) { <p role="@(hasError ? "alert" : "status")">@message</p> }
</section>
@if (link is not null)
{
 <section class="settings-card tracking-preferences">
  @if (Template)
  {
   <label class="profile-switch profile-sync-toggle">
    <span><strong>Auto-sync completed episodes &amp; chapters</strong><small>Available for units with a verified AniList match.</small></span>
    <input type="checkbox" role="switch" checked="@automatic" @onchange="ChangeAutomatic" />
   </label>
  }
  else
  {
   <h2>Tracking preferences</h2>
   <label class="tracking-toggle"><input type="checkbox" checked="@automatic" @onchange="ChangeAutomatic" />
    <span><strong>Automatically sync completed add-on episodes and chapters</strong><small>Available for units with a verified AniList match.</small></span>
   </label>
  }
 </section>
 @if (!Template)
 {
  <section class="settings-card">
   <h2>Account management</h2>
   @DisconnectControls
  </section>
 }
}

@code {
 [Parameter] public bool Template { get; set; }
 RenderFragment DisconnectControls => @<div class="profile-disconnect">
  @if (confirmDisconnect)
  {
   <p>Disconnect AniList from this profile? Your local Library, watch and reading progress will remain on this device.</p>
   <div class="settings-actions">
    <button class="secondary" disabled="@(operation is not null)" @onclick="() => confirmDisconnect = false">Keep connected</button>
    <button class="secondary danger-action" disabled="@(operation is not null)" @onclick="Disconnect">Disconnect account</button>
   </div>
  }
  else
  {
   <button class="text-link danger-action" disabled="@(operation is not null)" @onclick="() => confirmDisconnect = true">Disconnect AniList</button>
  }
 </div>;


 AniListLink? link;
 AniListImportSummary summary = new(false, null);
 bool loading = true, automatic = true, showLibrary, confirmDisconnect, hasError, disposed;
 int pending;
 long refresh;
 string? operation, message, failedAvatar;
 readonly CancellationTokenSource lifetime = new();
 string State => link?.RequiresReconnect == true ? "Reconnect required" : operation is not null ? "Syncing" :
  pending > 0 ? "Changes pending" : "Connected";
 string StateIcon => State switch { "Reconnect required" => "!", "Syncing" => "↻", "Changes pending" => "◷", _ => "✓" };

 protected override async Task OnInitializedAsync()
 {
  Store.AniListChanged += Changed;
  try
  {
   automatic = await Store.GetSettingAsync(LocalStore.AutomaticAniListKey) != "false";
   await Refresh();
  }
  catch { Inform("Could not open AniList settings. Reopen this page to try again.", true); }
  finally { loading = false; }
  if (link is { RequiresReconnect: false } && ProfileAniList is { } account)
  {
   try { await account.CurrentAsync(lifetime.Token); await Refresh(); }
   catch (AniListAuthorizationException) { await Refresh(); Inform("Reconnect AniList to import lists or send pending changes.", true); }
   catch (OperationCanceledException) when (disposed) { }
   catch { Inform("Could not check AniList. Your local Library is available.", true); }
  }
 }

 async Task Refresh()
 {
  var version = ++refresh;
  var next = ProfileAniList is { } account ? await account.CachedLinkAsync() : null;
  var metadata = next is null ? new(false, null) : await Store.ReadAniListImportAsync(next.Viewer.Id);
  var count = next is null ? 0 : (await Store.AniListEditsAsync(next.Viewer.Id)).Count;
  if (disposed || version != refresh) return;
  (link, summary, pending) = (next, metadata, count);
 }

 void Changed() => _ = InvokeAsync(async () =>
 {
  if (disposed) return;
  try { await Refresh(); }
  catch { return; }
  if (!disposed) StateHasChanged();
 });

 void Inform(string value, bool error = false) { message = value; hasError = error; }
 async Task Run(string status, Func<AniListAccount, Task> action)
 {
  if (operation is not null || ProfileAniList is not { } account) return;
  operation = status;
  message = null;
  hasError = false;
  try { await action(account); }
  catch (AniListAuthorizationException)
  {
   Inform(link is null ? "Sign-in did not complete. Return to AniList and try again." : "Reconnect AniList to continue.", true);
  }
  catch (OperationCanceledException) when (disposed) { }
  catch (OperationCanceledException)
  {
   Inform(status.StartsWith("Waiting", StringComparison.Ordinal) ? "Sign-in cancelled. You can try again." : "AniList did not respond. Try again.", true);
  }
  catch (HttpRequestException ex) when (ex.StatusCode is null)
  {
   Inform("Could not reach AniList. Check your internet connection and try again. Your local Library is available.", true);
  }
  catch { Inform("AniList could not complete this action. Try again. Your local Library is available.", true); }
  finally
  {
   operation = null;
   if (!disposed)
   {
    try { await Refresh(); }
    catch { Inform("Could not refresh the account status. Reopen this page to try again.", true); }
   }
  }
 }

 Task Connect() => Run("Waiting for AniList sign-in in your browser…", async account =>
 {
  await account.ConnectAsync(lifetime.Token);
  showLibrary = false;
  Inform("AniList account connected.");
 });

 Task Import() => link is { RequiresReconnect: false } active
  ? Run("Reading your Anime and Manga lists from AniList…", async account =>
  {
   var count = await account.ImportAsync(Store, active.Viewer.Id, lifetime.Token);
   showLibrary = true;
   Inform(count == 0 ? "No Anime or Manga entries found on this AniList account." :
    $"Checked {count} tracking {(count == 1 ? "entry" : "entries")}. Your lists are available in Library.");
  })
  : Task.CompletedTask;

 Task Retry() => link is { RequiresReconnect: false } active
  ? Run("Syncing pending changes…", async account =>
  {
   var sent = await account.SyncPendingAsync(Store, lifetime.Token);
   var remaining = (await Store.AniListEditsAsync(active.Viewer.Id)).Count;
   var current = await account.CachedLinkAsync();
   Inform(current?.RequiresReconnect == true ? "Reconnect AniList to send the pending changes." :
    remaining > 0 ? "Changes are still waiting. Check your connection or retry later." :
    sent > 0 ? "Synced. AniList acknowledged the pending changes." : "There are no changes waiting to sync.", remaining > 0);
  })
  : Task.CompletedTask;

 Task Disconnect() => Run("Disconnecting AniList…", async account =>
 {
  await account.DisconnectAsync();
  confirmDisconnect = false;
  showLibrary = false;
  Inform("AniList disconnected. Your local Library and progress remain on this device.");
 });

 async Task ChangeAutomatic(ChangeEventArgs args)
 {
  var enabled = args.Value is true;
  try { await Store.SetSettingAsync(LocalStore.AutomaticAniListKey, enabled ? "true" : "false"); automatic = enabled; }
  catch { Inform("Could not save the tracking preference.", true); }
 }

 public void Dispose()
 {
  disposed = true;
  Store.AniListChanged -= Changed;
  lifetime.Cancel();
  lifetime.Dispose();
 }
}
