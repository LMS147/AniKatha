<div class="poster-grid catalog-art-grid @(Shelf ? "catalog-shelf" : null)">
 @foreach (var item in Items)
 {
  <MediaPoster @key="item.Id" Title="@item.Title" Kind="@item.Kind" Poster="@item.Poster" Score="@item.Score"
               Metadata="@string.Join(" · ", new[] { item.Format?.Replace('_',' '), item.Year?.ToString() }.Where(value => !string.IsNullOrWhiteSpace(value)))"
               Selected="() => Selected.InvokeAsync(item)" />
 }
</div>
@code {
 [Parameter] public IEnumerable<Media> Items { get; set; } = [];
 [Parameter] public EventCallback<Media> Selected { get; set; }
 [Parameter] public bool Shelf { get; set; }
}
