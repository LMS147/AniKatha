<div class="poster-grid">
 @foreach(var item in Items) {
 <button class="poster-card" @key="item.Id" @onclick="()=>Selected.InvokeAsync(item)">
  <div class="poster-image">@if(item.Poster is not null){<img src="@item.Poster" alt="" loading="lazy" />}else{<span>AniKatha</span>}
   @if(item.Score is not null){<span class="score">@(item.Score / 10.0) ★</span>}
  </div><strong>@item.Title</strong><small>@item.Year · @item.Format?.Replace('_',' ')</small>
 </button>
 }
</div>
@code { [Parameter] public IEnumerable<Media> Items {get;set;}=[]; [Parameter] public EventCallback<Media> Selected {get;set;} }
