@using System.Text.Json
@using static AniKatha.Core.AddonResources
@using AniKatha.UI.Pages
@implements IDisposable
@inject AddonClient Client
@inherits ProfileComponent
<div class="notice"><strong>@Source.Addon.Name</strong> @if (Preferred) { <small>Preferred</small> }
@if(loading){<p>Loading sources…</p>}
else if(error){<p>Source request failed. <button @onclick="Load">Retry</button></p>}
else if (Type == "manga" && pages.Count > 0)
{
 <button @onclick="Read">Read @Label</button>
 @if (Downloads is not null) { <button @onclick="() => Download(null)">Download chapter</button> }
 @if (translation.Length > 0) { <small>Translation · @translation</small> }
}
else if (streams.Count > 0)
{
 @foreach (var stream in streams)
 {
  <div>
   <button disabled="@openingVideo" @onclick="() => Play(stream)">@StreamName(stream)</button>
   @if (Downloads is not null && OfflineDownloads.DownloadableStreamId(stream) is string streamId)
   { <button @onclick="() => Download(streamId)">Download @StreamName(stream)</button> }
   @if (StreamDetails(stream) is { Length: > 0 } description) { <small>@description</small> }
  </div>
 }
}
else { <p>No matching @(Type == "manga" ? "chapter" : "episode") from this provider.</p> }
@if (!loading && !error) { <button type="button" @onclick="Refresh">Refresh sources</button> }
@if (downloadStatus is not null) { <p role="status">@downloadStatus</p> }
@if (switchError) { <p role="alert">Could not preserve the current playback position. Try selecting the source again.</p> }
@if (progressError) { <p role="alert">Your history entry could not be saved.</p> }
</div>
@if(reading){<ReadMangaPreview @key="Key" ChapterKey="@Key" TitleSettingsKey="@ReaderTitleKey" Pages="readingPages" Title="@Title" ChapterLabel="@Label" PreviousChapter="PreviousChapter" NextChapter="NextChapter" OnCompleted="ProgressChanged"/>}
@if(video!=null){<WatchPreview @key="videoVersion" @ref="videoPlayer" EpisodeKey="@Key" VideoUrl="@video" Subtitles="subtitles" Title="@Title" EpisodeLabel="@Label" TrackCompletion="true" StartPlaying="playImmediately" RefreshSource="RefreshPlayingStream" OnNext="NextEpisode" OnCompleted="ProgressChanged" OnSourceFailed="Invalidate"/>}

@code {
 OfflineDownloads? Downloads => ProfileDownloads;
 string? downloadStatus;

 async Task Download(string? streamId)
 {
  if (Downloads is not { } downloads) return;
  try
  {
   if (HasOriginMetadata) await Store.SaveAddonAniListProgressAsync(Key, AniListProgress);
   await downloads.QueueAsync(new(Origin, Type, TitleId, UnitId, Source.ProviderKey, Title, Label, streamId));
   downloadStatus = "Added to Downloads in Library.";
  }
  catch { downloadStatus = "This download could not be queued."; }
 }

 [CascadingParameter] public SourceResultCache? Cache { get; set; }
 [Parameter,EditorRequired] public AddonResources Source {get;set;}=null!;
 [Parameter] public AddonAniListProgress? AniListProgress { get; set; }
 [Parameter] public bool HasOriginMetadata { get; set; }
 [Parameter] public string Origin {get;set;}="";
 [Parameter] public string TitleId {get;set;}="";
 [Parameter] public string UnitId {get;set;}="";
 [Parameter] public string Type {get;set;}="";
 [Parameter] public string Label {get;set;}="";
 [Parameter] public string Title {get;set;}="";
 [Parameter] public bool AutoOpen { get; set; }
 [Parameter] public EventCallback PreviousChapter { get; set; }
 [Parameter] public EventCallback NextChapter { get; set; }
 [Parameter] public EventCallback NextEpisode { get; set; }
 [Parameter] public bool Preferred { get; set; }
 [Parameter] public EventCallback ProgressChanged { get; set; }
 [Parameter] public Func<ManifestSources, Task<bool>>? ActivateVideo { get; set; }
 internal bool IsDisposed => disposed;
 readonly CancellationTokenSource stop=new();
 bool loading,reading,error,progressError,disposed;
 string translation = "";
 long playbackRequest;
 static string StreamDetails(JsonElement stream)
 {
  var quality = Field(stream, "quality");
  var audio = Field(stream, "audioLanguage");
  var tracks = ReadSubtitles(stream);
  var subtitles = tracks.Count > 0 ? "Subtitles available" : "";
  return string.Join(" · ", new[] { quality, audio, subtitles }.Where(value => value.Length > 0));
 }
 string? video;
 WatchPreview? videoPlayer;
 bool openingVideo, switchError, playImmediately;
 long videoVersion;
 JsonElement playingStream;

 internal async Task<bool> ReleaseVideoAsync(ManifestSources next)
 {
  if (video is null || disposed) return true;
  try
  {
   if (videoPlayer is not null && !await videoPlayer.PauseAndCheckpointAsync()) return false;
   if (next.IsDisposed || disposed) return false;
   if (next.Key != Key)
   {
    var position = await Store.GetPlaybackPositionAsync(Key);
    await Store.SavePlaybackPositionAsync(next.Key, position);
   }
   video = null;
   videoPlayer = null;
   playbackRequest++;
   await InvokeAsync(StateHasChanged);
   return true;
  }
  catch { return false; }
 }
 List<EpisodeSubtitle> subtitles=[];
 List<string> pages=[], readingPages=[];
 List<JsonElement> streams=[];
 string ReaderTitleKey => $"reader:title:{Origin}/{Type}/{Uri.EscapeDataString(TitleId)}";
 string Key=>ResumeEntry.Key(Origin,Type,TitleId,UnitId,Source.ProviderKey);
 static string StreamName(JsonElement stream)=>Field(stream,"name") is { Length:>0 } name?name:"Play";
 protected override async Task OnInitializedAsync()
 {
  await Load();
  if (!AutoOpen || disposed) return;
  if (Type == "manga" && pages.Count > 0) await Read();
  else if (streams.Count > 0) await Play(streams[0], startPlaying: true);
 }
 void Invalidate() => Cache?.Invalidate(Key);

 Task Refresh()
 {
  Invalidate();
  return Load();
 }

 async Task Load(){
  if (loading || disposed) return;
  loading=true;error=false;
  streams=[];pages=[];translation="";
  try{
   var resource=Type=="manga"?"pages":"stream";
   JsonElement result = default;
   var cached = Cache is not null && Cache.TryGet(Key, Source.Addon.ManifestJson, out result);
   var root = cached ? result : await Client.FetchJsonAsync(Source.Resource(resource,Type,UnitId),stop.Token);
   if (stop.IsCancellationRequested) return;
   if(!root.TryGetProperty(Type=="manga"?"pages":"streams",out var list) || list.ValueKind!=JsonValueKind.Array)throw new FormatException();
   if(Type=="manga"){
    pages=Items(root,"pages").Select(x=>x.GetString()??"").ToList();
    translation = Field(root, "language");
    if(pages.Any(x=>!MediaUrl(x)))throw new FormatException();
   }else streams=Items(root,"streams").Where(x=>MediaUrl(Field(x,"url"))).ToList();
   if (!cached && (pages.Count > 0 || streams.Count > 0)) Cache?.Set(Key, Source.Addon.ManifestJson, root);
  }catch(AddonResourceNotFoundException){}
  catch(OperationCanceledException) when(stop.IsCancellationRequested){}
  catch(Exception){error=true;}
  finally{loading=false;}
 }
 async Task Remember()
 {
  var id = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(Key)));
  try
  {
   if (HasOriginMetadata) await Store.SaveAddonAniListProgressAsync(Key, AniListProgress);
   await Store.RememberAsync(new ResumeEntry { Id=id, Origin=Origin, Source=Source.ProviderKey, Type=Type,
    TitleId=TitleId, UnitId=UnitId, Title=Title, Label=Label });
   progressError = false;
  }
  catch { progressError = true; }
 }

 async Task Read()
 {
  await Remember();
  if (disposed) return;
  if (!reading) readingPages = pages;
  reading = true;
  await ProgressChanged.InvokeAsync();
 }

 async Task Play(JsonElement stream, bool startPlaying = false)
 {
  if (openingVideo || disposed) return;
  openingVideo = true;
  switchError = false;
  try
  {
   await Remember();
   if (disposed) return;
   if (ActivateVideo is not null ? !await ActivateVideo(this) : !await ReleaseVideoAsync(this))
   {
    switchError = !disposed;
    return;
   }
   var request = ++playbackRequest;
   playingStream = stream;
   playImmediately = startPlaying;
   video = Field(stream, "url");
   videoVersion++;
   subtitles = ReadSubtitles(stream);
   await ProgressChanged.InvokeAsync();
   if (disposed || request != playbackRequest || !Source.Supports("subtitles", Type, UnitId)) return;
   await InvokeAsync(StateHasChanged);
   try
   {
    var response = await Client.FetchJsonAsync(Source.Resource("subtitles", Type, UnitId), stop.Token);
    if (!disposed && request == playbackRequest)
     subtitles = subtitles.Concat(ReadSubtitles(response)).DistinctBy(x => x.Url).ToList();
   }
   catch { /* Inline tracks remain available. */ }
  }
  finally { openingVideo = false; }
 }

 async Task<bool> RefreshPlayingStream()
 {
  if (openingVideo || loading || disposed) return false;
  var previous = playingStream;
  var id = Field(previous, "id");
  var name = Field(previous, "name");
  var url = Field(previous, "url");
  await Refresh();
  var matches = streams.Where(stream => id.Length > 0 ? Field(stream, "id") == id :
   Field(stream, "url") == url || (name.Length > 0 && Field(stream, "name") == name)).Take(2).ToList();
  if (matches.Count != 1) return false;
  await Play(matches[0], startPlaying: true);
  return !switchError && !disposed;
 }
 static List<EpisodeSubtitle> ReadSubtitles(JsonElement item)=>Items(item,"subtitles")
  .Where(x=>MediaUrl(Field(x,"url"))).Select(x=>new EpisodeSubtitle(Field(x,"lang"),Field(x,"url"),Field(x,"label"),Field(x,"role"))).ToList();
 public void Dispose(){disposed=true;stop.Cancel();stop.Dispose();}
}
