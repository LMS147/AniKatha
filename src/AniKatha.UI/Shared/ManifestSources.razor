@using System.Text.Json
@using static AniKatha.Core.AddonResources
@using AniKatha.UI.Pages
@implements IDisposable
@inject AddonClient Client
@inject LocalStore Store
<div class="notice"><strong>@Source.Addon.Name</strong>
@if(loading){<p>Loading sources…</p>}
else if(error){<p>Source request failed. <button @onclick="Load">Retry</button></p>}
else if(Type=="manga" && pages.Count>0){<button @onclick="Read">Read @Label</button>}
else if(streams.Count>0){@foreach(var stream in streams){<button @onclick="()=>Play(stream)">@StreamName(stream)</button>}}
else{<p>No sources available.</p>}
</div>
@if(reading){<ReadMangaPreview @key="Key" ChapterKey="@Key" Pages="pages" Title="@Title" ChapterLabel="@Label" OnCompleted="ProgressChanged"/>}
@if(video!=null){<WatchPreview @key="video" EpisodeKey="@Key" VideoUrl="@video" Subtitles="subtitles" Title="@Title" EpisodeLabel="@Label" TrackCompletion="true" OnCompleted="ProgressChanged"/>}

@code {
 [Parameter,EditorRequired] public AddonResources Source {get;set;}=null!;
 [Parameter] public string Origin {get;set;}="";
 [Parameter] public string TitleId {get;set;}="";
 [Parameter] public string UnitId {get;set;}="";
 [Parameter] public string Type {get;set;}="";
 [Parameter] public string Label {get;set;}="";
 [Parameter] public string Title {get;set;}="";
 [Parameter] public EventCallback ProgressChanged { get; set; }
 readonly CancellationTokenSource stop=new();
 bool loading,reading,error;
 string? video;
 List<EpisodeSubtitle> subtitles=[];
 List<string> pages=[];
 List<JsonElement> streams=[];
 string Key=>ResumeEntry.Key(Origin,Type,TitleId,UnitId,Source.ProviderKey);
 static string StreamName(JsonElement stream)=>Field(stream,"name") is { Length:>0 } name?name:"Play";
 protected override Task OnInitializedAsync()=>Load();
 async Task Load(){
  loading=true;error=false;
  try{
   var resource=Type=="manga"?"pages":"stream";
   var root=await Client.FetchJsonAsync(Source.Resource(resource,Type,UnitId),stop.Token);
   if(!root.TryGetProperty(Type=="manga"?"pages":"streams",out var list) || list.ValueKind!=JsonValueKind.Array)throw new FormatException();
   if(Type=="manga"){
    pages=Items(root,"pages").Select(x=>x.GetString()??"").ToList();
    if(pages.Any(x=>!MediaUrl(x)))throw new FormatException();
   }else streams=Items(root,"streams").Where(x=>MediaUrl(Field(x,"url"))).ToList();
  }catch(OperationCanceledException) when(stop.IsCancellationRequested){}
  catch(Exception){error=true;}
  finally{loading=false;}
 }
 async Task Remember()
 {
  var id=Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(Key)));
  await Store.RememberAsync(new ResumeEntry {Id=id, Origin=Origin, Source=Source.ProviderKey, Type=Type,
   TitleId=TitleId, UnitId=UnitId, Title=Title, Label=Label});
 }
 async Task Read(){await Remember();reading=true;await ProgressChanged.InvokeAsync();}
 async Task Play(JsonElement stream)
 {
  await Remember();
  video=Field(stream,"url");
  await ProgressChanged.InvokeAsync();
  subtitles=ReadSubtitles(stream);
  if(Source.Supports("subtitles",Type,UnitId))
  {
   try
   {
    var response=await Client.FetchJsonAsync(Source.Resource("subtitles",Type,UnitId),stop.Token);
    subtitles=subtitles.Concat(ReadSubtitles(response)).DistinctBy(x=>x.Url).ToList();
   }
   catch(Exception){ /* The video can still play with the embedded tracks. */ }
  }
 }
 static List<EpisodeSubtitle> ReadSubtitles(JsonElement item)=>Items(item,"subtitles")
  .Where(x=>MediaUrl(Field(x,"url"))).Select(x=>new EpisodeSubtitle(Field(x,"lang"),Field(x,"url"))).ToList();
 public void Dispose(){stop.Cancel();stop.Dispose();}
}
