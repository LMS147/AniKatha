@page "/anime/preview/episode-1"
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject LocalStore Store

<PageTitle>Watch Big Buck Bunny · AniKatha</PageTitle>
<header class="page-header">
 <a class="text-link" href="/anime/preview">← Episodes</a>
 <h1 class="playback-heading">Big Buck Bunny</h1>
 <p>Episode 1 · Sample trailer</p>
</header>

<video @ref="video" class="episode-video" controls playsinline preload="metadata" aria-label="Big Buck Bunny trailer"></video>
@if (playbackError)
{
 <div class="notice" role="alert">
  The video couldn’t be loaded. Check your connection and try again.
  <button type="button" @onclick="Retry">Retry video</button>
 </div>
}
@if (progressError)
{
 <p class="notice" role="status">Your playback position couldn’t be saved.</p>
}
<p class="playback-credit muted">
 © 2008 Blender Foundation · <a href="https://peach.blender.org/about/" target="_blank" rel="noopener noreferrer">CC BY 3.0</a>
</p>

@code {
 ElementReference video;
 DotNetObjectReference<WatchPreview>? callbacks;
 IJSObjectReference? module;
 IJSObjectReference? player;
 Task initialization = Task.CompletedTask;
 bool disposed;
 bool playbackError;
 bool progressError;

 protected override Task OnAfterRenderAsync(bool firstRender)
  => firstRender ? initialization = InitializePlayerAsync() : Task.CompletedTask;

 async Task InitializePlayerAsync()
 {
  try
  {
   var position = await Store.GetPlaybackPositionAsync(PlaybackSample.EpisodeKey);
   if (disposed)
    return;

   module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AniKatha.UI/episode-player.mjs");
   if (disposed)
    return;

   callbacks ??= DotNetObjectReference.Create(this);
   player = await module.InvokeAsync<IJSObjectReference>("attachPlayer", video, callbacks, PlaybackSample.VideoUrl, position);
  }
  catch (JSDisconnectedException) { }
  catch (Exception)
  {
   await SetPlaybackError();
  }
 }

 async Task Retry()
 {
  playbackError = false;
  if (player is not null)
   await player.InvokeVoidAsync("retry");
  else
   await (initialization = InitializePlayerAsync());
 }

 [JSInvokable]
 public async Task<bool> SavePosition(double seconds)
 {
  try
  {
   await Store.SavePlaybackPositionAsync(PlaybackSample.EpisodeKey, seconds);
   if (progressError && !disposed)
   {
    progressError = false;
    await InvokeAsync(StateHasChanged);
   }
   return true;
  }
  catch
  {
   if (!disposed && !progressError)
   {
    progressError = true;
    await InvokeAsync(StateHasChanged);
   }
   return false;
  }
 }

 [JSInvokable]
 public Task SetPlaybackError()
 {
  if (disposed)
   return Task.CompletedTask;
  playbackError = true;
  return InvokeAsync(StateHasChanged);
 }

 public async ValueTask DisposeAsync()
 {
  disposed = true;
  try
  {
   await initialization;
   if (player is not null)
   {
    await player.InvokeVoidAsync("dispose");
    await player.DisposeAsync();
   }
   if (module is not null)
    await module.DisposeAsync();
  }
  catch (JSDisconnectedException) { }
  finally
  {
   callbacks?.Dispose();
  }
 }
}
