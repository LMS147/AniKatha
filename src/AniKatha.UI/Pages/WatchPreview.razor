@page "/anime/preview/episode-1"
@using Microsoft.JSInterop
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS
@inherits ProfileComponent
@inject IServiceProvider Services
@inject AddonClient Addons
@inject NavigationManager Navigation

<PageTitle>Watch @Title · AniKatha</PageTitle>
<section class="anime-player" aria-label="Episode player">
 <div @ref="stage" class="player-stage @(fullscreen ? "player-fullscreen" : null)"
      data-panel="@panel.ToString().ToLowerInvariant()" data-opening="true"
      @onkeydown="PlayerKeyDown">
  <video @ref="video" class="@($"episode-video subtitle-{subtitleSize} subtitle-{subtitleBackground}")"
         playsinline preload="metadata" data-offline-source="@(OfflineFile ? VideoUrl : null)" aria-label="@Title"></video>
  <header class="player-context">
   <div class="player-heading">
    <button class="player-button player-back" type="button" @onclick="HandleBack" aria-label="Back">← <span>Back</span></button>
    <div class="player-title"><h1>@Title</h1><p>@EpisodeLabel</p></div>
    <button class="player-button" type="button" @onclick="ToggleFullscreen">@(fullscreen ? "Exit fullscreen" : "Fullscreen")</button>
   </div>
   @if (SourceLabel is not null) { <p class="player-source">@SourceLabel @if (SourceDetails is { Length: > 0 }) { <span>· @SourceDetails</span> }</p> }
  </header>

  <div class="player-transport" role="group" aria-label="Playback controls">
   <button class="player-button" type="button" data-player-seek disabled aria-label="@($"Rewind {seekSeconds} seconds")" @onclick="() => Seek(-seekSeconds)">↶ @seekSeconds s</button>
   <button class="player-button player-play" type="button" data-player-toggle aria-label="Play"><Icon Name="play"/><span data-player-play-label>Play</span></button>
   <button class="player-button" type="button" data-player-seek disabled aria-label="@($"Forward {seekSeconds} seconds")" @onclick="() => Seek(seekSeconds)">↷ @seekSeconds s</button>
  </div>
  <div class="player-footer">
   <div class="player-timeline">
    <span data-player-elapsed>0:00</span>
    <input type="range" min="0" max="1" step="0.1" value="0" data-player-scrubber aria-label="Playback position" disabled />
    <span data-player-duration hidden></span>
   </div>
   <div class="player-actions">
    @if (SubtitleOptions().Any() || loadingSubtitle || subtitleError)
    { <button class="player-button" type="button" data-player-menu="subtitles" aria-expanded="@(panel == PlayerPanel.Subtitles ? "true" : "false")" @onclick="() => OpenPanel(PlayerPanel.Subtitles)">Subtitles</button> }
    @if (audioTracks.Count > 1)
    { <button class="player-button" type="button" data-player-menu="audio" aria-expanded="@(panel == PlayerPanel.Audio ? "true" : "false")" @onclick="() => OpenPanel(PlayerPanel.Audio)">Audio</button> }
    <button class="player-button" type="button" data-player-menu="speed" aria-expanded="@(panel == PlayerPanel.Speed ? "true" : "false")" @onclick="() => OpenPanel(PlayerPanel.Speed)">Speed · @SpeedLabel(speed)</button>
    @if (SourcePickerId is not null)
    { <button class="player-button" type="button" @onclick="ShowSources">Change source</button> }
   </div>
   @if (!SubtitleOptions().Any() && !loadingSubtitle && !subtitleError)
   { <p class="player-no-subtitles">No subtitles available for this source.</p> }
  </div>
  <div class="player-indicators" role="status">
   <span class="player-opening">Opening episode…</span><span class="player-buffering">Buffering…</span>
  </div>

  @if (playbackError)
  {
   <div class="player-recovery" role="alert">
    <strong>Couldn’t play this episode</strong>
    <p>@(OfflineFile ? "Try reopening the downloaded video." : "Retry the connection or try another available source.")</p>
    <div class="player-actions">
     <button class="player-button" type="button" @onclick="Retry">Retry video</button>
     @if (RefreshSource is not null) { <button class="player-button" type="button" @onclick="RefreshVideo">Refresh video link</button> }
     @if (SourcePickerId is not null) { <button class="player-button" type="button" @onclick="ShowSources">Choose another source</button> }
    </div>
    @if (recoveryMessage is not null) { <p>@recoveryMessage</p> }
   </div>
  }
  @if (completionMessage is not null) { <p class="tracking-feedback player-tracking" role="status">@completionMessage</p> }

  @if (panel != PlayerPanel.None)
  {
   <div class="player-menu">
    <button class="player-scrim" type="button" tabindex="-1" aria-hidden="true" @onclick="ClosePanel"></button>
    <section class="player-sheet" role="dialog" aria-modal="true" aria-label="@panel" @ref="sheet">
     <header><h2>@panel</h2><button class="player-button" type="button" data-player-close @onclick="ClosePanel">Close</button></header>
     @if (panel == PlayerPanel.Subtitles)
     {
      var options = SubtitleOptions().ToList();
      @if (options.Count == 0) { <p>No subtitles available for this source.</p> }
      <div class="player-options" role="group" aria-label="Subtitle tracks">
       <button class="player-option" type="button" data-subtitle-choice="" aria-pressed="@Selected(subtitleChoice.Length == 0)" @onclick='() => ChangeSubtitle("")'>Off</button>
       @foreach (var track in options)
       {
        <button @key="track.Id" class="player-option" type="button" data-subtitle-choice="@track.Id" aria-pressed="@Selected(track.Id == subtitleChoice)" @onclick="() => ChangeSubtitle(track.Id)">
         <span>@TrackLanguage(track)</span>
         @if (TrackLabel(track) is { Length: > 0 } label) { <small>@label</small> }
        </button>
       }
      </div>
      @if (loadingSubtitle) { <p role="status">Loading subtitle track…</p> }
      @if (subtitleError)
      {
       <div class="notice" role="alert">Could not load the selected subtitle track. The video is still available.
        <button class="secondary" type="button" @onclick="() => ApplySubtitle(attemptedSubtitle)">Retry subtitle</button>
       </div>
      }
      @if (activeSidecar is not null)
      {
       <div class="player-offset" aria-label="Subtitle timing">
        <h3>Subtitle timing</h3>
        <span role="status">@(subtitleOffset == 0 ? "Original subtitle timing" : $"{Math.Abs(subtitleOffset)} ms {(subtitleOffset < 0 ? "earlier" : "later")}")</span>
        <div class="player-actions">
         <button class="player-button" type="button" @onclick="() => OffsetSubtitles(-250)" disabled="@(loadingSubtitle || subtitleOffset <= -30000)">Earlier by 250 ms</button>
         <button class="player-button" type="button" @onclick="() => OffsetSubtitles(250)" disabled="@(loadingSubtitle || subtitleOffset >= 30000)">Later by 250 ms</button>
         <button class="player-button" type="button" @onclick="ResetSubtitleOffset" disabled="@(loadingSubtitle || subtitleOffset == 0)">Reset to 0</button>
        </div>
       </div>
      }
     }
     else if (panel == PlayerPanel.Audio)
     {
      <div class="player-options" role="group" aria-label="Audio tracks">
       @foreach (var track in audioTracks)
       {
        <button @key="track.Id" class="player-option" type="button" data-audio-choice="@track.Id" aria-pressed="@Selected(track.Id == audioChoice)" @onclick="() => ChangeAudio(track.Id)">
         <span>@TrackLanguage(track)</span>
         @if (TrackLabel(track) is { Length: > 0 } label) { <small>@label</small> }
        </button>
       }
      </div>
      @if (audioError) { <p role="alert">That audio track couldn’t be selected. Choose another track or try again.</p> }
     }
     else
     {
      <div class="player-options player-speeds" role="group" aria-label="Playback speeds">
       @foreach (var rate in MediaPreferences.PlaybackSpeeds)
       {
        <button class="player-option" type="button" data-player-rate="@rate.ToString(CultureInfo.InvariantCulture)" aria-pressed="@Selected(speed == rate)" @onclick="() => ChangeSpeed(rate)">@SpeedLabel(rate)</button>
       }
      </div>
      <button class="secondary" type="button" @onclick="SetDefaultSpeed">Save as default</button>
      @if (speedStatus is not null) { <p role="status">@speedStatus</p> }
     }
    </section>
   </div>
  }
 </div>
 <div class="player-extras">
  @if (OnNext.HasDelegate)
  {
   <button class="secondary" type="button" disabled="@advancing" @onclick="NextEpisode">
    Next episode @(NextEpisodeLabel is { Length: > 0 } nextLabel ? $"· {nextLabel}" : "→")
   </button>
   <small>Autoplay @(autoplay ? "on" : "off")</small>
  }
  <button @ref="pipButton" class="secondary player-pip" type="button" hidden>Picture-in-picture</button>
  @if (CanOpenExternally) { <button class="secondary" type="button" disabled="@handingOff" @onclick="OpenExternally">Open in external player</button> }
  @if (TrackCompletion && !completed) { <button class="secondary" type="button" disabled="@completing" @onclick="MarkWatched">Mark episode watched</button> }
 </div>
 @if (pictureInPictureError is not null) { <p role="status">@pictureInPictureError</p> }
 @if (handoffMessage is not null) { <p role="status">@handoffMessage</p> }
 @if (progressError) { <p class="notice" role="status">Your playback position couldn’t be saved.</p> }
 @if (VideoUrl == PlaybackSample.VideoUrl)
 {
  <p class="playback-credit muted">© 2008 Blender Foundation · <a href="https://peach.blender.org/about/" target="_blank" rel="noopener noreferrer">CC BY 3.0</a></p>
 }
</section>

@code {
 enum PlayerPanel { None, Subtitles, Audio, Speed }
 PlayerPanel panel;
 bool fullscreen, focusPanel, restoreFocus;
 PlayerPanel previousPanel;
 ElementReference stage, sheet;
 PlayerBackHandler? BackHandler => Services.GetService(typeof(PlayerBackHandler)) as PlayerBackHandler;
 [Parameter] public string? SourceLabel { get; set; }
 [Parameter] public string? SourceDetails { get; set; }
 [Parameter] public string? SourcePickerId { get; set; }
 [Parameter] public string? NextEpisodeLabel { get; set; }
 [Parameter] public EventCallback OnLeave { get; set; }

 static string SpeedLabel(double value) => $"{value:0.##}×";
 static string Selected(bool value) => value ? "true" : "false";

 void OpenPanel(PlayerPanel value)
 {
  panel = value;
  focusPanel = true;
 }

 void ClosePanel()
 {
  previousPanel = panel;
  panel = PlayerPanel.None;
  restoreFocus = true;
 }

 void ToggleFullscreen() => fullscreen = !fullscreen;

 async Task HandleBack()
 {
  if (disposed) return;
  if (panel != PlayerPanel.None) ClosePanel();
  else if (fullscreen) ToggleFullscreen();
  else if (OnLeave.HasDelegate) await OnLeave.InvokeAsync();
  else if (await PauseAndCheckpointAsync())
   Navigation.NavigateTo(OfflineFile ? "/library?view=downloads" : "/anime/preview");
 }

 Task PlayerKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
  => args.Key == "Escape" && (fullscreen || panel != PlayerPanel.None) ? HandleBack() : Task.CompletedTask;

 async Task ShowSources()
 {
  fullscreen = false;
  if (module is not null) await module.InvokeVoidAsync("focusSourcePicker", SourcePickerId);
 }

 [Parameter] public bool OfflineFile { get; set; }
 [Parameter] public bool StartPlaying { get; set; }
 [Parameter] public EventCallback OnNext { get; set; }
 bool autoplay, advancing, completing, completed;
 [Parameter] public Func<Task<bool>>? RefreshSource { get; set; }
 string? recoveryMessage;
 IExternalVideoPlayer? ExternalPlayer => Services.GetService(typeof(IExternalVideoPlayer)) as IExternalVideoPlayer;
 bool CanOpenExternally => !OfflineFile && AddonResources.MediaUrl(VideoUrl) && ExternalPlayer is not null;
 bool handingOff;
 string? handoffMessage;

 async Task OpenExternally()
 {
  if (handingOff || !CanOpenExternally || ExternalPlayer is not { } external) return;
  handingOff = true;
  handoffMessage = null;
  try
  {
   if (!await PauseAndCheckpointAsync())
    handoffMessage = "Could not save your current position. Try again before opening another player.";
   else if (!await external.OpenAsync(new Uri(VideoUrl)))
    handoffMessage = "No installed video app could open this stream.";
   else
    handoffMessage = "Position saved. Use Mark episode watched if you finish in the external player.";
  }
  catch { handoffMessage = "Could not open this stream in an external player."; }
  finally { handingOff = false; }
 }

 async Task RefreshVideo()
 {
  recoveryMessage = null;
  if (RefreshSource is not null && !await RefreshSource())
   recoveryMessage = "Could not refresh this stream. Choose another available source.";
 }

 internal async Task<bool> PauseAndCheckpointAsync()
 {
  await initialization;
  if (disposed) return false;
  if (player is not null) await player.InvokeVoidAsync("pauseAndCheckpoint");
  return !progressError;
 }

 async Task NextEpisode()
 {
  if (disposed || advancing || !OnNext.HasDelegate) return;
  advancing = true;
  try
  {
   if (!await PauseAndCheckpointAsync()) return;
   await OnNext.InvokeAsync();
  }
  finally { advancing = false; }
 }

 [Parameter] public EventCallback OnSourceFailed { get; set; }
 [Parameter] public bool TrackCompletion { get; set; }
 [Parameter] public EventCallback OnCompleted { get; set; }
 [Parameter] public string EpisodeKey {get;set;} = PlaybackSample.EpisodeKey;
 [Parameter] public string VideoUrl {get;set;} = PlaybackSample.VideoUrl;
 [Parameter] public string Title {get;set;} = "Big Buck Bunny";
 [Parameter] public string EpisodeLabel {get;set;} = "Episode 1 · Sample trailer";
 [Parameter] public IReadOnlyList<EpisodeSubtitle> Subtitles {get;set;}=[];
 int seekSeconds = 10;
 Task Seek(int seconds) => player?.InvokeVoidAsync("seek", seconds).AsTask() ?? Task.CompletedTask;

 double speed = 1;
 string? speedStatus;

 async Task ChangeSpeed(double value)
 {
  speed = value;
  if (player is not null) await player.InvokeVoidAsync("setSpeed", speed);
  speedStatus = null;
 }

 async Task SetDefaultSpeed()
 {
  try
  {
   await Store.SetSettingAsync(MediaPreferences.SpeedKey, speed.ToString(CultureInfo.InvariantCulture));
   speedStatus = "Default playback speed saved.";
  }
  catch { speedStatus = "Could not save playback speed."; }
 }

 ElementReference video, pipButton;
 DotNetObjectReference<WatchPreview>? callbacks;
 IJSObjectReference? module;
 IJSObjectReference? player;
 Task initialization = Task.CompletedTask;
 bool disposed;
 string? completionMessage;
 bool playbackError;
 string? pictureInPictureError;
 [JSInvokable]
 public Task SetPictureInPictureError()
 {
  if (disposed) return Task.CompletedTask;
  pictureInPictureError = "This device could not enter picture-in-picture.";
  return InvokeAsync(StateHasChanged);
 }
 bool progressError;

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if (firstRender)
  {
   BackHandler?.Register(this, () => InvokeAsync(async () =>
   {
    await HandleBack();
    if (!disposed) StateHasChanged();
   }));
   await (initialization = InitializePlayerAsync());
  }
  else
  {
   await ApplyPreferredSubtitle();
   if (module is null || disposed) return;
   if (focusPanel)
   {
    focusPanel = false;
    await module.InvokeVoidAsync("focusPlayerPanel", sheet);
   }
   if (restoreFocus)
   {
    restoreFocus = false;
    await module.InvokeVoidAsync("focusPlayerMenu", stage, previousPanel.ToString().ToLowerInvariant());
   }
  }
 }

 async Task InitializePlayerAsync()
 {
  try
  {
   var position = await Store.GetPlaybackPositionAsync(EpisodeKey);
   speed = MediaPreferences.ReadSpeed(await Store.GetSettingAsync(MediaPreferences.SpeedKey));
   autoplay = await Store.GetSettingAsync(MediaPreferences.AutoplayKey) == "true";
   seekSeconds = MediaPreferences.ReadSeekInterval(await Store.GetSettingAsync(MediaPreferences.SeekIntervalKey));
   preferredAudioLanguage = await Store.GetSettingAsync(MediaPreferences.AudioLanguageKey);
   preferredLanguage = await Store.GetSettingAsync(MediaPreferences.SubtitleLanguageKey);
   subtitleSize = (await Store.GetSettingAsync(MediaPreferences.SubtitleSizeKey)) switch
   { "large" => "large", "small" => "small", _ => "normal" };
   subtitleBackground = await Store.GetSettingAsync(MediaPreferences.SubtitleBackgroundKey) == "transparent" ? "transparent" : "dark";
   subtitlePlacement = await Store.GetSettingAsync(MediaPreferences.SubtitlePlacementKey) ?? "automatic";
   if (disposed)
    return;

   module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AniKatha.UI/episode-player.mjs");
   if (disposed)
    return;

   callbacks ??= DotNetObjectReference.Create(this);
   player = await module.InvokeAsync<IJSObjectReference>("attachPlayer", video, callbacks, VideoUrl, position, TrackCompletion, speed, StartPlaying, OfflineFile, Title, EpisodeLabel, pipButton, stage);
   if (!disposed && OnLeave.HasDelegate) await module.InvokeVoidAsync("revealPlayer", stage);
   if (!disposed) await InvokeAsync(StateHasChanged);
   await ApplyPreferredSubtitle();
  }
  catch (JSDisconnectedException) { }
  catch (Exception)
  {
   await SetPlaybackError();
  }
 }

 async Task Retry()
 {
  playbackError = false;
  if (player is not null)
   await player.InvokeVoidAsync("retry");
  else
   await (initialization = InitializePlayerAsync());
 }

 [JSInvokable]
 public async Task<bool> SavePosition(double seconds)
 {
  try
  {
   await Store.SavePlaybackPositionAsync(EpisodeKey, seconds);
   if (progressError && !disposed)
   {
    progressError = false;
    await InvokeAsync(StateHasChanged);
   }
   return true;
  }
  catch
  {
   if (!disposed && !progressError)
   {
    progressError = true;
    await InvokeAsync(StateHasChanged);
   }
   return false;
  }
 }

 async Task ShowSyncResult(Task<string> sync)
 {
  var message = await sync;
  if (!disposed) await InvokeAsync(() =>
  {
   completionMessage = message;
   StateHasChanged();
  });
 }

 Task MarkWatched() => SaveCompletion(advance: false);

 [JSInvokable]
 public Task<bool> CompleteEpisode() => SaveCompletion(advance: true);

 async Task<bool> SaveCompletion(bool advance)
 {
  if (!TrackCompletion || disposed || completing) return false;
  if (completed) return true;
  completing = true;
  try
  {
   if (!advance && !await PauseAndCheckpointAsync()) return false;
   var receipt = await AddonCompletion.SaveAsync(Store, ProfileAniList, EpisodeKey);
   completed = true;
   completionMessage = receipt.Message;
   if (receipt.Sync is not null) _ = ShowSyncResult(receipt.Sync);
   if (!disposed)
   {
    await InvokeAsync(() => OnCompleted.InvokeAsync());
    if (!disposed) await InvokeAsync(StateHasChanged);
    if (advance && autoplay) await InvokeAsync(NextEpisode);
   }
   return true;
  }
  catch
  {
   if (!disposed)
   {
    progressError = true;
    await InvokeAsync(StateHasChanged);
   }
   return false;
  }
  finally { completing = false; }
 }

 [JSInvokable]
 public async Task SetPlaybackError()
 {
  if (disposed)
   return;
  playbackError = true;
  await InvokeAsync(() => OnSourceFailed.InvokeAsync());
  await InvokeAsync(StateHasChanged);
 }

 public async ValueTask DisposeAsync()
 {
  disposed = true;
  BackHandler?.Clear(this);
  subtitleRequest?.Cancel();subtitleRequest?.Dispose();
  try
  {
   await initialization;
   if (player is not null)
   {
    await player.InvokeVoidAsync("dispose");
    await player.DisposeAsync();
   }
   if (module is not null)
    await module.DisposeAsync();
  }
  catch (JSDisconnectedException) { }
  finally
  {
   callbacks?.Dispose();
  }
 }
}
