@page "/anime/preview/episode-1"
@using Microsoft.JSInterop
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject LocalStore Store
@inject AddonClient Addons

<PageTitle>Watch @Title · AniKatha</PageTitle>
<header class="page-header">
 @if(EpisodeKey==PlaybackSample.EpisodeKey){<a class="text-link" href="/anime/preview">← Episodes</a>}
 <h1 class="sample-heading">@Title</h1>
 <p>@EpisodeLabel</p>
</header>

<video @ref="video" class="@($"episode-video subtitle-{subtitleSize} subtitle-{subtitleBackground}")" controls playsinline preload="metadata" data-offline-source="@(OfflineFile ? VideoUrl : null)" aria-label="@Title"></video>
<div class="reader-controls">
 <button class="secondary" @onclick="() => Seek(-seekSeconds)">−@seekSeconds s</button>
 <button class="secondary" @onclick="() => Seek(seekSeconds)">+@seekSeconds s</button>
 <label>Playback speed
  <select value="@speed.ToString(CultureInfo.InvariantCulture)" @onchange="ChangeSpeed">
   @foreach (var rate in MediaPreferences.PlaybackSpeeds)
   {
    <option value="@rate.ToString(CultureInfo.InvariantCulture)">@rate.ToString("0.##")×</option>
   }
  </select>
 </label>
 @if (OnNext.HasDelegate) { <button class="secondary" @onclick="NextEpisode">Next episode →</button> }
 <button class="secondary" @onclick="SetDefaultSpeed">Save as default</button>
</div>
@if (speedStatus is not null) { <p role="status">@speedStatus</p> }
@if(Subtitles.Count>0)
{
 <label>Subtitles<select value="@(selectedTrack < 0 ? "" : selectedTrack.ToString(CultureInfo.InvariantCulture))" @onchange="ChangeSubtitle">
 <option value="">Off</option>
 @for(var i=0;i<Subtitles.Count;i++){<option value="@i">@Subtitles[i].Language</option>}
 </select></label>
}
@if(subtitleError){<p role="alert">Could not load the selected subtitle track.</p>}
@if (playbackError)
{
 <div class="notice" role="alert">
  The video couldn’t be loaded. Check your connection and try again.
  <button type="button" @onclick="Retry">Retry video</button>
 </div>
}
@if (progressError)
{
 <p class="notice" role="status">Your playback position couldn’t be saved.</p>
}
@if (VideoUrl == PlaybackSample.VideoUrl)
{
<p class="playback-credit muted">
 © 2008 Blender Foundation · <a href="https://peach.blender.org/about/" target="_blank" rel="noopener noreferrer">CC BY 3.0</a>
</p>

}
@code {
 [Parameter] public bool OfflineFile { get; set; }
 [Parameter] public bool StartPlaying { get; set; }
 [Parameter] public EventCallback OnNext { get; set; }
 bool autoplay, advancing;

 async Task NextEpisode()
 {
  if (disposed || advancing || !OnNext.HasDelegate) return;
  advancing = true;
  try
  {
   if (player is not null) await player.InvokeVoidAsync("checkpoint");
   await OnNext.InvokeAsync();
  }
  finally { advancing = false; }
 }

 [Parameter] public EventCallback OnSourceFailed { get; set; }
 [Parameter] public bool TrackCompletion { get; set; }
 [Parameter] public EventCallback OnCompleted { get; set; }
 [Parameter] public string EpisodeKey {get;set;} = PlaybackSample.EpisodeKey;
 [Parameter] public string VideoUrl {get;set;} = PlaybackSample.VideoUrl;
 [Parameter] public string Title {get;set;} = "Big Buck Bunny";
 [Parameter] public string EpisodeLabel {get;set;} = "Episode 1 · Sample trailer";
 [Parameter] public IReadOnlyList<EpisodeSubtitle> Subtitles {get;set;}=[];
 int seekSeconds = 10;
 Task Seek(int seconds) => player?.InvokeVoidAsync("seek", seconds).AsTask() ?? Task.CompletedTask;

 double speed = 1;
 string? speedStatus;

 async Task ChangeSpeed(ChangeEventArgs args)
 {
  speed = MediaPreferences.ReadSpeed(args.Value?.ToString());
  if (player is not null) await player.InvokeVoidAsync("setSpeed", speed);
  speedStatus = null;
 }

 async Task SetDefaultSpeed()
 {
  try
  {
   await Store.SetSettingAsync(MediaPreferences.SpeedKey, speed.ToString(CultureInfo.InvariantCulture));
   speedStatus = "Default playback speed saved.";
  }
  catch { speedStatus = "Could not save playback speed."; }
 }

 bool subtitleError, manualSubtitle;
 int selectedTrack = -1;
 string? preferredLanguage, automaticTrack;
 string subtitleSize = "normal", subtitleBackground = "dark", subtitlePlacement = "automatic";
 CancellationTokenSource? subtitleRequest;

 Task ChangeSubtitle(ChangeEventArgs args)
 {
  manualSubtitle = true;
  return ApplySubtitle(int.TryParse(args.Value?.ToString(), out var index) ? index : -1);
 }

 async Task ApplySubtitle(int index)
 {
  subtitleRequest?.Cancel();
  subtitleRequest?.Dispose();
  var token = (subtitleRequest = new()).Token;
  selectedTrack = index;
  subtitleError = false;
  if (player is null) return;
  try
  {
   await player.InvokeVoidAsync("clearSubtitle");
   if (index < 0 || index >= Subtitles.Count) return;
   var selected = Subtitles[index];
   var cues = await Addons.GetSubtitleAsync(selected.Url, token);
   if (!token.IsCancellationRequested) await player.InvokeVoidAsync("setSubtitle", selected.Language, cues, subtitlePlacement);
  }
  catch { if (!token.IsCancellationRequested) subtitleError = true; }
 }

 async Task ApplyPreferredSubtitle()
 {
  if (manualSubtitle || disposed || player is null) return;
  var index = MediaPreferences.PreferredTrack(Subtitles, preferredLanguage);
  if (index < 0 || automaticTrack == Subtitles[index].Url) return;
  automaticTrack = Subtitles[index].Url;
  await ApplySubtitle(index);
  if (!disposed) await InvokeAsync(StateHasChanged);
 }

 ElementReference video;
 DotNetObjectReference<WatchPreview>? callbacks;
 IJSObjectReference? module;
 IJSObjectReference? player;
 Task initialization = Task.CompletedTask;
 bool disposed;
 bool playbackError;
 bool progressError;

 protected override Task OnAfterRenderAsync(bool firstRender)
  => firstRender ? initialization = InitializePlayerAsync() : ApplyPreferredSubtitle();

 async Task InitializePlayerAsync()
 {
  try
  {
   var position = await Store.GetPlaybackPositionAsync(EpisodeKey);
   speed = MediaPreferences.ReadSpeed(await Store.GetSettingAsync(MediaPreferences.SpeedKey));
   autoplay = await Store.GetSettingAsync(MediaPreferences.AutoplayKey) == "true";
   seekSeconds = MediaPreferences.ReadSeekInterval(await Store.GetSettingAsync(MediaPreferences.SeekIntervalKey));
   preferredLanguage = await Store.GetSettingAsync(MediaPreferences.SubtitleLanguageKey);
   subtitleSize = (await Store.GetSettingAsync(MediaPreferences.SubtitleSizeKey)) switch
   { "large" => "large", "small" => "small", _ => "normal" };
   subtitleBackground = await Store.GetSettingAsync(MediaPreferences.SubtitleBackgroundKey) == "transparent" ? "transparent" : "dark";
   subtitlePlacement = await Store.GetSettingAsync(MediaPreferences.SubtitlePlacementKey) ?? "automatic";
   if (disposed)
    return;

   module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AniKatha.UI/episode-player.mjs");
   if (disposed)
    return;

   callbacks ??= DotNetObjectReference.Create(this);
   player = await module.InvokeAsync<IJSObjectReference>("attachPlayer", video, callbacks, VideoUrl, position, TrackCompletion, speed, StartPlaying, OfflineFile);
   if (!disposed) await InvokeAsync(StateHasChanged);
   await ApplyPreferredSubtitle();
  }
  catch (JSDisconnectedException) { }
  catch (Exception)
  {
   await SetPlaybackError();
  }
 }

 async Task Retry()
 {
  playbackError = false;
  if (player is not null)
   await player.InvokeVoidAsync("retry");
  else
   await (initialization = InitializePlayerAsync());
 }

 [JSInvokable]
 public async Task<bool> SavePosition(double seconds)
 {
  try
  {
   await Store.SavePlaybackPositionAsync(EpisodeKey, seconds);
   if (progressError && !disposed)
   {
    progressError = false;
    await InvokeAsync(StateHasChanged);
   }
   return true;
  }
  catch
  {
   if (!disposed && !progressError)
   {
    progressError = true;
    await InvokeAsync(StateHasChanged);
   }
   return false;
  }
 }

 [JSInvokable]
 public async Task<bool> CompleteEpisode()
 {
  if (!TrackCompletion) return false;
  try
  {
   await Store.CompleteUnitAsync(EpisodeKey);
   if (!disposed)
   {
    await InvokeAsync(() => OnCompleted.InvokeAsync());
    if (autoplay) await InvokeAsync(NextEpisode);
   }
   return true;
  }
  catch
  {
   if (!disposed)
   {
    progressError = true;
    await InvokeAsync(StateHasChanged);
   }
   return false;
  }
 }

 [JSInvokable]
 public async Task SetPlaybackError()
 {
  if (disposed)
   return;
  playbackError = true;
  await InvokeAsync(() => OnSourceFailed.InvokeAsync());
  await InvokeAsync(StateHasChanged);
 }

 public async ValueTask DisposeAsync()
 {
  disposed = true;
  subtitleRequest?.Cancel();subtitleRequest?.Dispose();
  try
  {
   await initialization;
   if (player is not null)
   {
    await player.InvokeVoidAsync("dispose");
    await player.DisposeAsync();
   }
   if (module is not null)
    await module.DisposeAsync();
  }
  catch (JSDisconnectedException) { }
  finally
  {
   callbacks?.Dispose();
  }
 }
}
