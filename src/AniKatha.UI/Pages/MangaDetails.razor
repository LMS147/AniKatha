@using System.Text.Json
@page "/manga/details/{Id:int}"
@page "/manga/details/source"
@page "/manga/read/source"
@inherits ProfileComponent
@implements IDisposable
@inject AniListClient Api

<article class="@(Reader is null ? "template-details manga-details-screen" : "chapter-reading-screen")">
@if (provider is null || Reader is not null || metadataOnly)
{
<nav class="detail-toolbar template-detail-top"><a class="text-link" href="@BackPath" aria-label="@BackLabel">@(Reader is null ? "← Details" : "← Chapters")</a></nav>
}
@if (title is { } item)
{
 <PageTitle>@item.Title · AniKatha</PageTitle>
 @if (provider is { } source)
 {
  @if (metadataOnly)
  {
   <ProviderTitleDetails Listing="listing" Details="metadata" Type="manga" Standalone="true" />
   <p role="status">This provider only supplies title information.</p>
  }
  else
  {
  <ManifestCatalog @key="(source.ProviderKey, item.ExternalId, Release, Reader)" Source="source" Catalog="@(new AddonCatalog("manga", "", "", false, false))"
                   Providers="providers" InitialTitle="item" InitialUnitId="@Release" AllowSaveInitialTitle="true" ShowDetailActions="true" ReaderProvider="@Reader" From="@From" DetailBackPath="@BackPath" DetailBackLabel="@BackLabel" />
  }
 }
 else
 {
  <section class="design-title-card template-manga-cover" id="manga-overview" aria-label="Cover and summary">
   @if (item.Poster is { } poster && AddonResources.MediaUrl(poster)) { <img src="@poster" alt="" /> }
   <div>
    <span class="eyebrow">@((media?.Format ?? "Manga").Replace('_',' '))</span>
    <div class="design-title-facts chips">
     @if (media?.Year is int year) { <span>@year</span> }
     @if (media?.Status is { } status) { <span>@status.Replace('_', ' ')</span> }
     @if (media?.Country is { } country) { <span>@country</span> }
     @if (media?.Chapters is int count) { <span>@count chapters</span> }
    </div>
    <dl class="template-manga-metrics">
     @if (media?.Score is int score) { <div><dt>AniList score</dt><dd>★ @(score / 10.0)</dd></div> }
     @if (media?.Popularity is int popularity) { <div><dt>Tracked on AniList</dt><dd>@popularity.ToString("N0")</dd></div> }
    </dl>
   </div>
  </section>
  <section class="template-title-credits"><h1>@item.Title</h1>
   @if (media?.AlternateTitle is { } alternate && alternate != item.Title) { <p>@alternate</p> }
  </section>
  <div class="settings-actions template-title-actions">
   <a class="primary" href="#chapters"><Icon Name="book" />Find chapters</a>
   @if (saved) { <a class="secondary" href="@($"/library/title/{item.Id}/tracking")">Edit tracking</a> }
   else { <button class="secondary" disabled="@saving" @onclick="Save">Save to library</button> }
  </div>
  @if (media is { } catalogue)
  {
   <details class="template-synopsis" open><summary>Synopsis</summary>
    <p>@(string.IsNullOrWhiteSpace(catalogue.Description) ? "No synopsis available." : catalogue.Description)</p>
   </details>
   <details class="template-synopsis" open><summary>Details</summary>
    @if (catalogue.Genres.Length > 0) { <h3>Genres</h3><div class="chips">@foreach (var genre in catalogue.Genres) { <span>@genre</span> }</div> }
    @if (catalogue.Tags.Count > 0) { <h3>Tags</h3><div class="chips">@foreach (var tag in catalogue.Tags) { <span>@tag</span> }</div> }
    <h3>Trackers</h3><a class="secondary template-tracker" href="@($"https://anilist.co/manga/{item.Id}")" target="_blank" rel="noopener noreferrer" aria-label="Open title on AniList">AL</a>
   </details>
  }
  <section id="chapters" class="design-detail-section"><h2>Chapters</h2><TrackedTitleSources @key="item.Id" Title="item"/></section>
 }
}
else if (error is null) { <p role="status">Opening manga…</p> }
@if (error is not null)
{
 <div class="notice" role="alert">@error <button type="button" @onclick="Load">Try again</button></div>
}

</article>

@code {
 public static string ProviderPath(string provider, string title, string name, string? release = null, string? from = null, string? reader = null, string? catalog = null)
 {
  var path = $"/manga/{(reader is null ? "details" : "read")}/source?provider={Uri.EscapeDataString(provider)}&title={Uri.EscapeDataString(title)}&name={Uri.EscapeDataString(name)}";
  if (!string.IsNullOrEmpty(release)) path += $"&release={Uri.EscapeDataString(release)}";
  if (!string.IsNullOrEmpty(from)) path += $"&from={Uri.EscapeDataString(from)}";
  if (reader is not null) path += $"&reader={Uri.EscapeDataString(reader)}";
  if (catalog is not null) path += $"&catalog={Uri.EscapeDataString(catalog)}";
  return path;
 }
 [CascadingParameter] public CatalogSession? Session { get; set; }
 [Inject] AddonClient Client { get; set; } = default!;
 [SupplyParameterFromQuery] public string? Catalog { get; set; }
 bool metadataOnly;
 JsonElement listing, metadata;
 [Parameter] public int Id { get; set; }
 [SupplyParameterFromQuery] public string? Provider { get; set; }
 [SupplyParameterFromQuery] public string? Title { get; set; }
 [SupplyParameterFromQuery] public string? Release { get; set; }
 [SupplyParameterFromQuery] public string? Name { get; set; }
 [SupplyParameterFromQuery] public string? From { get; set; }
 [SupplyParameterFromQuery] public string? Reader { get; set; }
 string BackPath => Reader is not null && Provider is not null && Title is not null
  ? ProviderPath(Provider, Title, Name ?? "Manga details", Release, From) : From == "home" ? "/" : "/manga";
 string BackLabel => Reader is not null ? "Back to chapters" : From == "home" ? "Back to Home" : "Back to Browse Manga";
 CancellationTokenSource? request;
 SavedTitle? title;
 Media? media;
 AddonResources? provider;
 List<AddonResources> providers = [];
 bool saved, saving;
 string? error;

 protected override Task OnParametersSetAsync() => Load();

 async Task Load()
 {
  request?.Cancel();
  request?.Dispose();
  request = new();
  var token = request.Token;
  var id = Id;
  (metadataOnly, listing, metadata) = (false, default, default);
  (title, media, provider, error, saved) = (null, null, null, null, false);
  try
  {
   if (id <= 0)
   {
    var found = (await Store.GetAddonsAsync()).Select(addon => new AddonResources(addon)).ToList();
    token.ThrowIfCancellationRequested();
    var source = found.FirstOrDefault(candidate => candidate.ProviderKey == Provider);
    if (source is null || string.IsNullOrWhiteSpace(Title) || Title.Length > 512)
    {
     error = "This manga’s chapter source is unavailable.";
     return;
    }
    var catalog = Catalog is null ? null : source.Catalogs("MANGA").FirstOrDefault(item => item.Id == Catalog);
    var card = catalog is null ? null : Session?.MangaShelves
        .GetValueOrDefault($"{source.ProviderKey}/manga/{Uri.EscapeDataString(catalog.Id)}")?
        .Cards.FirstOrDefault(item => item.Id == Title);
    var name = card?.Title ?? (string.IsNullOrWhiteSpace(Name) ? "Manga details" : Name);
    if (!source.Supports("chapters", "manga", Title))
    {
     if (catalog is null || Reader is not null)
     {
      error = "This manga’s chapter source is unavailable.";
      return;
     }
     metadataOnly = true;
     listing = card?.Listing ?? JsonSerializer.SerializeToElement(new { name });
     if (source.Supports("meta", "manga", Title))
     {
      var root = await Client.FetchJsonAsync(source.Resource("meta", "manga", Title), token);
      token.ThrowIfCancellationRequested();
      if (root.ValueKind == JsonValueKind.Object && root.TryGetProperty("meta", out var details)) metadata = details;
     }
    }
    (provider, providers) = (source, found);
    title = new() { Kind = "MANGA", ResourceType = "manga", ExternalId = Title, Title = name, Poster = card?.Poster };
    return;
   }
   var existing = await Store.FindSavedTitleAsync(id);
   token.ThrowIfCancellationRequested();
   if (existing is { Kind: "MANGA" }) { title = existing; saved = true; }
   var catalogue = await Api.FindTitleAsync(id, "MANGA", token);
   token.ThrowIfCancellationRequested();
   if (catalogue is { Kind: "MANGA" } && catalogue.Id == id)
   {
    media = catalogue;
    title ??= new() { Id = id, Kind = "MANGA", Title = catalogue.Title, Poster = catalogue.Poster };
   }
   else if (title is null) error = "This manga could not be found.";
  }
  catch (OperationCanceledException) when (token.IsCancellationRequested) { }
  catch { if (!token.IsCancellationRequested) error = "Could not load manga details. Check your connection."; }
 }
 async Task Save()
 {
  if (media is not { } item || saving) return;
  saving = true;
  try
  {
   if (await Store.FindSavedTitleAsync(item.Id) is null) await Store.SaveAsync(item);
   if (media?.Id == item.Id) saved = true;
  }
  catch { error = "Could not save this manga."; }
  finally { saving = false; }
 }
 public void Dispose() { request?.Cancel(); request?.Dispose(); }
}
