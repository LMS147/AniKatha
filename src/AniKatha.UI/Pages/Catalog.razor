@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject AniListClient Api
@inject NavigationManager Navigation
@inject JikanCatalogue Jikan
@inherits ProfileComponent
<section class="design-catalog">
<header class="catalog-top" @ref="heading">
 <h1>Browse @(Kind == "ANIME" ? "Anime" : "Manga")</h1>
 <nav class="catalog-modes" aria-label="Browse media type">
  <a href="/anime" aria-current="@(Kind == "ANIME" ? "page" : null)">Anime</a>
  <a href="/manga" aria-current="@(Kind == "MANGA" ? "page" : null)">Manga</a>
 </nav>
</header>
<form @onsubmit="SubmitSearch" @onsubmit:preventDefault>
 <fieldset class="catalog-search-fields" disabled="@(!initialized)">
 <div class="catalog-search-row">
  <div class="search-box"><button type="submit" aria-label="Search"><Icon /></button><input type="search" aria-label="Search titles" placeholder="@(Kind=="ANIME"?"Search anime titles…":"Search manga titles…")" @bind="search"/></div>
  <button type="button" class="catalog-toggle" aria-label="Toggle filters" aria-expanded="@(filtersOpen ? "true" : "false")" aria-controls="catalog-filters" @onclick="() => filtersOpen = !filtersOpen"><Icon Name="filters" />@if (ActiveFilters.Count > 0) { <span>@ActiveFilters.Count</span> }</button>
 </div>
 <section id="catalog-filters" class="design-filter-panel" hidden="@(!filtersOpen)" aria-label="Catalogue filters">
 <div class="filters">
 <label>Source<select aria-label="Catalogue source" value="@source" @onchange="ChangeSource">
 <option value="">All Sources</option>
 <option value="@AniListSource">AniList catalogue</option>
 @if (jikan is not null) { <option value="@JikanSource">@jikan.Name</option> }
 @foreach (var provider in httpProviders.Where(p => p.Catalogs(Kind).Any())) {
  <option value="@provider.ProviderKey">@provider.Addon.Name</option>
 }
 </select></label>
 <label>Genre<select @bind="genre"><option value="">All genres</option>@foreach(var g in genres){<option>@g</option>}</select></label>
 <label>Year<input type="number" min="1900" max="2100" placeholder="Any year" @bind="year"/></label>
 @if(Kind=="ANIME"){<label>Season<select @bind="season"><option value="">All seasons</option><option value="WINTER">Winter</option><option value="SPRING">Spring</option><option value="SUMMER">Summer</option><option value="FALL">Autumn</option></select></label>}
 <label>Format<select @bind="format"><option value="">All formats</option>@foreach(var f in formats){<option value="@f">@f.Replace('_',' ')</option>}</select></label>
 @if (ShowBuiltIn && !UsingAddon) {
 <label>Sort<select @bind="sort"><option value="TRENDING_DESC">Trending</option><option value="POPULARITY_DESC">Popular</option><option value="SCORE_DESC">Top rated</option><option value="START_DATE_DESC">Newest</option></select></label>
 }
 </div><div class="filter-actions"><button class="secondary" type="button" @onclick="Reset">Clear filters</button><button class="primary" type="submit">@(UsingAddon ? "Find titles" : "Apply filters")</button></div>
 </section>
 </fieldset>
</form>
@if (ActiveFilters.Count > 0)
{
 <div class="design-chips" aria-label="Applied filters">
 @foreach (var filter in ActiveFilters)
 {
  <button type="button" class="secondary" @onclick="() => ClearFilter(filter.Key)" aria-label="@($"Clear {filter.Key} filter")">@filter.Key: @filter.Value <span aria-hidden="true">×</span></button>
 }
 </div>
}
@if (!ShowDiscovery && ShowBuiltIn && !UsingAddon && appliedSearch.Length == 0)
{
 <div class="design-chips" role="group" aria-label="Discovery sort">
 @foreach (var choice in DiscoverySorts)
 {
  <button type="button" class="secondary" aria-pressed="@(appliedFilters.Sort == choice.Value ? "true" : "false")" @onclick="() => Discover(choice.Value)">@choice.Label</button>
 }
 </div>
}
@if (ShowDiscovery)
{
 <CatalogDiscovery Kind="@Kind" Selected="Select" />
 <section class="catalog-samples" aria-label="Samples">@Featured</section>
}
else if (appliedSearch.Length == 0 && source.Length == 0 && !HasFilters) { @Featured }

@foreach(var provider in httpProviders.Where(p => source.Length == 0 || p.ProviderKey == source)){
 @foreach(var catalog in provider.Catalogs(Kind)){
  @if (appliedSearch.Length > 0 && !catalog.Search)
  {
   <p>@provider.Addon.Name · @catalog.Name supports browsing only.</p>
  }
  else
  {
  <ManifestCatalog @key="(provider.ProviderKey,catalog.Type,catalog.Id,submission)" Source="provider" Catalog="catalog" Providers="httpProviders" SubmittedQuery="@appliedSearch" Filters="appliedFilters" Session="pages" OpenMangaPage="@(Kind == "MANGA")"/>
  }
 }
}

@if (ShowBuiltIn && !ShowDiscovery)
{
@if (usingAniListFallback)
{
 <div class="notice" role="status">Jikan is unreachable. Showing live results from AniList. <button @onclick="Search" disabled="@busy">Retry Jikan</button></div>
}
else if (UsingAddon && starterCatalogue)
{
 <div class="notice" role="status">Live catalogues are unavailable. Showing the starter catalogue included with AniKatha. <button @onclick="Search" disabled="@busy">Retry live catalogue</button></div>
}
else if (UsingAddon) { <p class="source-note">Titles and covers from Jikan.</p> }
@if (UsingAddon && !usingAniListFallback && HasFilters) { <p>Jikan and the starter catalogue cannot apply these filters.</p> }
@if (!UsingAddon) { <p class="source-note">Titles and covers from AniList.</p> }
@if(error is not null){<div class="notice" role="alert">@error <button @onclick="RetryBuiltIn">Retry</button></div>}
<div class="section-title"><h2>@(string.IsNullOrWhiteSpace(appliedSearch) && !HasFilters ? DiscoveryLabel:$"{(Kind == "ANIME" ? "Anime" : "Manga")} Results")</h2><span class="muted">@ResultCount titles</span></div>
@if(busy&&ResultCount==0){<div class="loading" role="status">Finding stories…</div>}
else if(ResultCount==0&&error is null){<div class="empty"><Icon/><h3>No matching titles</h3><p>@(starterCatalogue ? "No matching title in the starter catalogue." : "Try a different search or reset your filters.")</p></div>}
@if (UsingAddon && !usingAniListFallback)
{
 <div class="poster-grid">
 @foreach (var title in addonItems)
 {
  <div class="poster-card" @key="title.Id">
   <div class="poster-image">
    @if (title.Poster is not null) { <img src="@title.Poster" alt="" loading="lazy" /> }
    else { <span>AniKatha</span> }
   </div>
   <strong>@title.Name</strong>
   <small>@title.Format</small>
   @if (!string.IsNullOrWhiteSpace(title.Description))
   {
    <details><summary>Synopsis</summary><p>@title.Description</p></details>
   }
  </div>
 }
 </div>
}
else { <MediaGrid Items="items" Selected="Select"/> }
@if(hasMore && error is null){<button class="secondary load-more" disabled="@busy" @onclick="More">@(busy?"Loading…":"Load more")</button>}
}
</section>
@code {
 [CascadingParameter] public CatalogSession? Session { get; set; }
 Dictionary<(string Provider, string Type, string Id), CatalogPage> pages = new();
 ElementReference heading;
 IJSObjectReference? scrollModule;
 bool initialized, disposed, restoreScroll, filtersOpen;
 Task SubmitSearch() { filtersOpen = false; return Search(); }
 [Parameter, EditorRequired] public string Kind { get; set; } = "";
 [Parameter] public RenderFragment? Featured { get; set; }
 string search="",genre="",season="",format="",sort="TRENDING_DESC";int? year;int page=1;bool busy,hasMore;string? error;List<Media> items=[];
 CancellationTokenSource? request;
 List<AddonResources> httpProviders=[];
 InstalledAddon? jikan;
 bool preferJikan;
 List<AddonTitle> addonItems = [];
 string source = "", appliedSearch = "";
 SearchOptions appliedFilters = new();
 bool HasFilters => appliedFilters.Genre is { Length: > 0 } || appliedFilters.Year.HasValue ||
  appliedFilters.Season is { Length: > 0 } || appliedFilters.Format is { Length: > 0 };
 long submission;
 bool failedNextPage;
 bool starterCatalogue, usingAniListFallback;
 const string AniListSource = "anilist";
 const string JikanSource = "jikan";
 string SourceSetting => $"catalogue-source-{Kind}";
 bool ShowDiscovery => Featured is not null && ShowBuiltIn && !UsingAddon &&
    appliedSearch.Length == 0 && !HasFilters && appliedFilters.Sort == "TRENDING_DESC";
 bool ShowBuiltIn => source is "" or AniListSource or JikanSource;
 bool UsingAddon => source == JikanSource || source.Length == 0 && preferJikan && jikan is not null;
 int ResultCount => UsingAddon && !usingAniListFallback ? addonItems.Count : items.Count;
 string[] genres=["Action","Adventure","Comedy","Drama","Ecchi","Fantasy","Horror","Mahou Shoujo","Mecha","Music","Mystery","Psychological","Romance","Sci-Fi","Slice of Life","Sports","Supernatural","Thriller"];
 string[] formats=>Kind=="ANIME"?["TV","TV_SHORT","MOVIE","SPECIAL","OVA","ONA","MUSIC"]:["MANGA","NOVEL","ONE_SHOT"];
 protected override async Task OnInitializedAsync()
 {
  var saved = Session?.Tabs.GetValueOrDefault(Kind);
  try
  {
   var enabled = await Store.GetAddonsAsync();
   if (disposed) return;
   httpProviders = enabled.Select(x => new AddonResources(x)).ToList();
   jikan = enabled.FirstOrDefault(addon => addon.CatalogueProvider == JikanCatalogue.Provider);
   var legacyPreference = await Store.GetSettingAsync("catalogue-source");
   preferJikan = legacyPreference is null || legacyPreference == jikan?.Url;
   source = FindSource(saved?.Source ?? await Store.GetSettingAsync(SourceSetting) ?? "");
  }
  catch { /* AniList remains available if local storage cannot be opened. */ }
  if (disposed) return;
  initialized = true;
  if (saved is null)
  {
   await Reset();
   return;
  }
  search = saved.Draft.Search ?? "";
  genre = saved.Draft.Genre ?? "";
  year = saved.Draft.Year;
  season = saved.Draft.Season ?? "";
  format = saved.Draft.Format ?? "";
  sort = saved.Draft.Sort;
  appliedFilters = saved.Applied;
  appliedSearch = saved.Applied.Search ?? "";
  restoreScroll = true;
  pages = saved.Pages;
  var enabledKeys = httpProviders.Select(x => x.ProviderKey).ToHashSet();
  foreach (var key in pages.Keys.Where(x => !enabledKeys.Contains(x.Provider)).ToArray())
   pages.Remove(key);
  if (source != saved.Source || UsingAddon && jikan?.Url != saved.JikanKey ||
      !UsingAddon && saved.JikanKey is not null)
  {
   await LoadIfSelected();
   return;
  }
  (page, hasMore, failedNextPage, starterCatalogue, usingAniListFallback, error, items, addonItems) =
   (saved.Page, saved.HasMore, saved.FailedNextPage, saved.StarterCatalogue, saved.AniListFallback, saved.Error, saved.Items, saved.JikanItems);
  if (ShowBuiltIn && !ShowDiscovery && ResultCount == 0 && error is null && page == 0)
  {
   page = 1;
   await Load();
  }
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if (!initialized || scrollModule is not null || disposed) return;
  try
  {
   var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AniKatha.UI/catalog-scroll.mjs");
   if (module is null) return;
   if (disposed) { await module.DisposeAsync(); return; }
   scrollModule = module;
   await module.InvokeVoidAsync("activate", heading, Kind, restoreScroll);
  }
  catch (JSDisconnectedException) { }
 }

 Task LoadIfSelected() => ShowBuiltIn ? Load() : Task.CompletedTask;

 string FindSource(string value) =>
  value == AniListSource || value == JikanSource && jikan is not null ||
  httpProviders.Any(p => p.ProviderKey == value && p.Catalogs(Kind).Any()) ? value : "";

 async Task ChangeSource(ChangeEventArgs change)
 {
  if (!initialized) return;
  source = FindSource(change.Value as string ?? "");
  var chosen = source;
  var searchTask = Search();
  try { await Store.SetSettingAsync(SourceSetting, chosen); }
  catch { /* The source remains selected for this visit. */ }
  await searchTask;
 }

 Task Reset()
 {
  search = genre = season = format = "";
  year = null;
  sort = "TRENDING_DESC";
  return Search();
 }

 Task Search()
 {
  if (!initialized) return Task.CompletedTask;
  appliedSearch = search.Trim();
  appliedFilters = new SearchOptions(Kind, appliedSearch, genre, year, Kind == "ANIME" ? season : null, format, sort);
  submission++;
  pages = new();
  page = 1;
  items = [];
  addonItems = [];
  hasMore = false;
  failedNextPage = false;
  starterCatalogue = false;
  usingAniListFallback = false;
  if (ShowBuiltIn && !ShowDiscovery)
   return LoadIfSelected();
  request?.Cancel();
  busy = false;
  return Task.CompletedTask;
 }

 async Task More() { if (busy) return; page++; await Load(); }

 Task RetryBuiltIn() => failedNextPage ? More() : Load();

 async Task Load()
 {
  request?.Cancel();
  request?.Dispose();
  var current = request = new();
  var token = current.Token;
  busy = true;
  failedNextPage = false;
  error = null;
  try
  {
   if (UsingAddon && !usingAniListFallback)
   {
    var result = await Jikan.SearchAsync(Kind, appliedSearch, page, token);
    if (token.IsCancellationRequested) return;
    if (result.IsStarterCatalogue)
    {
     MediaPage? live = null;
     try { live = await Api.SearchAsync(appliedFilters, token); }
     catch (Exception) when (!token.IsCancellationRequested) { /* Keep bundled results when both requests fail. */ }
     if (token.IsCancellationRequested) return;
     if (live is not null)
     {
      usingAniListFallback = true;
      items = live.Items.Where(item => item.Kind == Kind).DistinctBy(item => item.Id).ToList();
      hasMore = live.HasNextPage;
      return;
     }
    }
    starterCatalogue = result.IsStarterCatalogue;
    var ids = addonItems.Select(item => item.Id).ToHashSet();
    var added = result.Items.Where(item => ids.Add(item.Id)).ToList();
    addonItems.AddRange(added);
    hasMore = result.HasNextPage && added.Count > 0;
   }
   else
   {
    var options = appliedFilters with { Page = page };
    var result = await Api.SearchAsync(options, token);
    if (token.IsCancellationRequested) return;
    var ids = items.Select(item => item.Id).ToHashSet();
    var added = result.Items.Where(item => item.Kind == Kind && ids.Add(item.Id)).ToList();
    items.AddRange(added);
    hasMore = result.HasNextPage && added.Count > 0;
   }
  }
  catch (Exception ex) when (!token.IsCancellationRequested)
  {
   error = ex is InvalidOperationException ? ex.Message : "Could not load titles. Check your connection and try again.";
   failedNextPage = page > 1;
   if (failedNextPage) page--;
  }
  catch (Exception) when (token.IsCancellationRequested) {}
  finally { if (ReferenceEquals(request, current)) busy = false; }
 }
 static readonly (string Value, string Label)[] DiscoverySorts =
  [("TRENDING_DESC", "Trending"), ("POPULARITY_DESC", "All-time popular"), ("SCORE_DESC", "Top rated"), ("START_DATE_DESC", "Newest")];
 string DiscoveryLabel => DiscoverySorts.FirstOrDefault(choice => choice.Value == appliedFilters.Sort).Label ?? "Discover";
 IReadOnlyList<(string Key, string Value)> ActiveFilters =>
  new (string Key, string? Value)[] { ("Genre", appliedFilters.Genre), ("Year", appliedFilters.Year?.ToString()),
    ("Season", appliedFilters.Season), ("Format", appliedFilters.Format?.Replace('_', ' ')) }
   .Where(filter => !string.IsNullOrWhiteSpace(filter.Value)).Select(filter => (filter.Key, filter.Value!)).ToArray();
 Task Discover(string value) { sort = value; return Search(); }
 Task ClearFilter(string key)
 {
  genre = key == "Genre" ? "" : appliedFilters.Genre ?? "";
  year = key == "Year" ? null : appliedFilters.Year;
  season = key == "Season" ? "" : appliedFilters.Season ?? "";
  format = key == "Format" ? "" : appliedFilters.Format ?? "";
  search = appliedSearch;
  sort = appliedFilters.Sort;
  return Search();
 }
 void Select(Media item)
 {
  if (item.Kind == "MANGA") Navigation.NavigateTo($"/manga/details/{item.Id}");
  else Navigation.NavigateTo($"/anime/details/{item.Id}");
 }
 public async ValueTask DisposeAsync()
 {
  disposed = true;
  request?.Cancel();
  request?.Dispose();
  if (initialized && Session is not null)
  {
   var draft = new SearchOptions(Kind, search, genre, year, season, format, sort);
   Session.Tabs[Kind] = new(draft, appliedFilters, source, UsingAddon ? jikan?.Url : null,
    busy && page == 1 ? 0 : busy ? page - 1 : page, hasMore, failedNextPage, starterCatalogue, usingAniListFallback,
    error, items, addonItems, pages);
  }
  if (scrollModule is not null)
  {
   try { await scrollModule.DisposeAsync(); }
   catch (JSDisconnectedException) { }
  }
 }
}
