@page "/manga/preview/chapter-1"
@inject LocalStore Store
@inject IJSRuntime JS
@using Microsoft.JSInterop
@implements IAsyncDisposable

<PageTitle>Read @Title · AniKatha</PageTitle>
<header class="page-header reader-header">
 @if(Pages==null){<a class="text-link" href="/manga/preview">← Chapters</a>}
 <h1 class="sample-heading">@Title</h1>
 <p>@ChapterLabel</p>
</header>

@if (ready)
{
 <section class="manga-reader" aria-label="@ChapterLabel">
  <p class="reader-position" role="status">Page @currentPage of @PageCount</p>
  <label>Reading mode
   <select value="@mode" @onchange="ChangeMode">
    <option value="ltr">Left to right</option>
    <option value="rtl">Right to left</option>
    <option value="vertical">Vertical scrolling</option>
   </select>
  </label>
  @if (mode == "vertical")
  {
   <div class="reader-stack" @ref="stack">
    @for (var page = 1; page <= PageCount; page++)
    {
     <img class="reader-page" data-reader-page="@page" src="@PageUrl(page)" alt="@PageDescription(page)" loading="lazy" />
    }
   </div>
  }
  else { <img class="reader-page" src="@PageUrl(currentPage)" alt="@PageDescription(currentPage)" /> }
  <div class="reader-controls @(mode == "rtl" ? "reader-rtl" : "")">
   <button type="button" class="secondary" disabled="@(currentPage == 1 || saving)" @onclick="() => MoveTo(currentPage - 1)">@(mode == "rtl" ? "Previous →" : "← Previous")</button>
   @if (currentPage < PageCount)
   {
    <button type="button" class="primary" disabled="@saving" @onclick="() => MoveTo(currentPage + 1)">@(mode == "rtl" ? "← Next page" : "Next page →")</button>
   }
   else if (Pages is not null)
   {
    <button class="primary" disabled="@(completed || saving)" @onclick="Finish">@(completed ? "Chapter completed" : "Mark chapter read")</button>
   }
   else
   {
    <a class="primary" href="/manga/preview">Back to chapters</a>
   }
  </div>
 </section>
 @if (storageError is not null)
 {
  <p class="notice" role="alert">@storageError</p>
 }
}
else
{
 <p role="status">Opening chapter…</p>
}

@code {
 int currentPage = 1;
 bool ready;
 bool saving, completed;
 [Parameter] public EventCallback OnCompleted { get; set; }
 string? storageError;
 [Parameter] public string ChapterKey {get;set;} = MangaSample.ChapterKey;
 [Parameter] public string Title {get;set;} = MangaSample.Title;
 [Parameter] public string ChapterLabel {get;set;} = "Chapter 1";
 [Parameter] public IReadOnlyList<string>? Pages {get;set;}
 int PageCount => Pages?.Count ?? MangaSample.PageDescriptions.Count;
 string PageUrl(int page) => Pages?[page - 1] ?? $"_content/AniKatha.UI/manga/midnight-lighthouse-{page}.webp";
 string PageDescription(int page) => Pages is null ? MangaSample.PageDescriptions[page - 1] : $"Page {page}";
 string mode = "ltr";
 bool tracking, disposed;
 ElementReference stack;
 IJSObjectReference? readerModule, pageObserver;
 DotNetObjectReference<ReadMangaPreview>? callbacks;
 Task initialization = Task.CompletedTask;
 int? queuedPage;

 Task ChangeMode(ChangeEventArgs args)
 {
  mode = args.Value?.ToString() switch { "vertical" => "vertical", "rtl" => "rtl", _ => "ltr" };
  if (mode != "vertical") return StopObserving();
  return Task.CompletedTask;
 }

 protected override Task OnAfterRenderAsync(bool firstRender)
 {
  if (disposed || !ready || mode != "vertical" || tracking) return Task.CompletedTask;
  tracking = true;
  return initialization = StartObserving();
 }

 async Task StartObserving()
 {
  try
  {
   readerModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AniKatha.UI/chapter-reader.mjs");
   if (readerModule is null || mode != "vertical" || disposed) return;
   callbacks ??= DotNetObjectReference.Create(this);
   pageObserver = await readerModule.InvokeAsync<IJSObjectReference>("watchPages", stack, callbacks, currentPage);
   if (mode != "vertical" || disposed) await StopObserving();
  }
  catch (JSDisconnectedException) { }
 }

 async Task StopObserving()
 {
  tracking = false;
  if (pageObserver is null) return;
  var observer = pageObserver;
  pageObserver = null;
  try { await observer.InvokeVoidAsync("dispose"); await observer.DisposeAsync(); }
  catch (JSDisconnectedException) { }
 }

 [JSInvokable]
 public Task ObservePage(int page)
 {
  if (disposed || mode != "vertical" || page < 1 || page > PageCount) return Task.CompletedTask;
  return InvokeAsync(async () =>
  {
   if (saving) { queuedPage = page; return; }
   await MoveTo(page, fromScroll: true);
   StateHasChanged();
  });
 }

 public async ValueTask DisposeAsync()
 {
  disposed = true;
  await initialization;
  await StopObserving();
  try { if (readerModule is not null) await readerModule.DisposeAsync(); }
  catch (JSDisconnectedException) { }
  callbacks?.Dispose();
 }

 protected override async Task OnInitializedAsync()
 {
  try
  {
   currentPage = Math.Clamp(await Store.GetReadingPageAsync(ChapterKey), 1, PageCount);
   completed = Pages is not null && await Store.IsUnitCompleteAsync(ChapterKey);
  }
  catch
  {
   storageError = "Your saved page couldn’t be loaded.";
  }
  finally
  {
   ready = true;
  }
 }

 async Task Finish()
 {
  if (saving || completed || currentPage != PageCount) return;
  saving = true;
  try
  {
   await Store.SaveReadingPageAsync(ChapterKey, currentPage);
   await Store.CompleteUnitAsync(ChapterKey);
   completed = true;
   storageError = null;
   await OnCompleted.InvokeAsync();
  }
  catch { storageError = "Could not mark this chapter read."; }
  finally { saving = false; }
 }

 async Task MoveTo(int next, bool fromScroll = false)
 {
  if (saving || next == currentPage || next < 1 || next > PageCount)
   return;

  saving = true;
  currentPage = next;
  try
  {
   await Store.SaveReadingPageAsync(ChapterKey, next);
   if (!fromScroll && pageObserver is not null) await pageObserver.InvokeVoidAsync("show", next);
   storageError = null;
  }
  catch
  {
   storageError = "Your reading position couldn’t be saved.";
  }
  finally
  {
   saving = false;
  }
  if (queuedPage is int queued)
  {
   queuedPage = null;
   if (!disposed && mode == "vertical") await MoveTo(queued, fromScroll: true);
  }
 }
}
