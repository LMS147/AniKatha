@page "/manga/preview/chapter-1"
@inject LocalStore Store

<PageTitle>Read @Title · AniKatha</PageTitle>
<header class="page-header reader-header">
 @if(Pages==null){<a class="text-link" href="/manga/preview">← Chapters</a>}
 <h1 class="sample-heading">@Title</h1>
 <p>@ChapterLabel</p>
</header>

@if (ready)
{
 <section class="manga-reader" aria-label="@ChapterLabel">
  <p class="reader-position" role="status">Page @currentPage of @PageCount</p>
  <img class="reader-page" src="@PageUrl" alt="@(Pages==null ? MangaSample.PageDescriptions[currentPage-1] : $"Page {currentPage}")"/>
  <div class="reader-controls">
   <button type="button" class="secondary" disabled="@(currentPage == 1 || saving)" @onclick="() => MoveTo(currentPage - 1)">← Previous</button>
   @if (currentPage < PageCount)
   {
    <button type="button" class="primary" disabled="@saving" @onclick="() => MoveTo(currentPage + 1)">Next page →</button>
   }
   else if (Pages is not null)
   {
    <button class="primary" disabled="@(completed || saving)" @onclick="Finish">@(completed ? "Chapter completed" : "Mark chapter read")</button>
   }
   else
   {
    <a class="primary" href="/manga/preview">Back to chapters</a>
   }
  </div>
 </section>
 @if (storageError is not null)
 {
  <p class="notice" role="alert">@storageError</p>
 }
}
else
{
 <p role="status">Opening chapter…</p>
}

@code {
 int currentPage = 1;
 bool ready;
 bool saving, completed;
 [Parameter] public EventCallback OnCompleted { get; set; }
 string? storageError;
 [Parameter] public string ChapterKey {get;set;} = MangaSample.ChapterKey;
 [Parameter] public string Title {get;set;} = MangaSample.Title;
 [Parameter] public string ChapterLabel {get;set;} = "Chapter 1";
 [Parameter] public IReadOnlyList<string>? Pages {get;set;}
 int PageCount => Pages?.Count ?? MangaSample.PageDescriptions.Count;
 string PageUrl => Pages?[currentPage-1] ?? $"_content/AniKatha.UI/manga/midnight-lighthouse-{currentPage}.webp";

 protected override async Task OnInitializedAsync()
 {
  try
  {
   currentPage = Math.Clamp(await Store.GetReadingPageAsync(ChapterKey), 1, PageCount);
   completed = Pages is not null && await Store.IsUnitCompleteAsync(ChapterKey);
  }
  catch
  {
   storageError = "Your saved page couldn’t be loaded.";
  }
  finally
  {
   ready = true;
  }
 }

 async Task Finish()
 {
  if (saving || completed || currentPage != PageCount) return;
  saving = true;
  try
  {
   await Store.SaveReadingPageAsync(ChapterKey, currentPage);
   await Store.CompleteUnitAsync(ChapterKey);
   completed = true;
   storageError = null;
   await OnCompleted.InvokeAsync();
  }
  catch { storageError = "Could not mark this chapter read."; }
  finally { saving = false; }
 }

 async Task MoveTo(int next)
 {
  if (saving || next < 1 || next > PageCount)
   return;

  saving = true;
  currentPage = next;
  try
  {
   await Store.SaveReadingPageAsync(ChapterKey, next);
   storageError = null;
  }
  catch
  {
   storageError = "Your reading position couldn’t be saved.";
  }
  finally
  {
   saving = false;
  }
 }
}
