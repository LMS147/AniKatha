@page "/manga/preview/chapter-1"
@inject LocalStore Store
@inject IServiceProvider Services
@inject IJSRuntime JS
@using Microsoft.JSInterop
@using System.Globalization
@implements IAsyncDisposable

<PageTitle>Read @Title · AniKatha</PageTitle>
<header class="page-header reader-header">
 @if(Pages==null){<a class="text-link" href="/manga/preview">← Chapters</a>}
 <h1 class="sample-heading">@Title</h1>
 <p>@ChapterLabel</p>
</header>

@if (ready)
{
 <section class="manga-reader" aria-label="@ChapterLabel">
  <p class="reader-position" role="status">Page @currentPage of @PageCount</p>
  <form class="reader-jump" novalidate @onsubmit="JumpToPage" @onsubmit:preventDefault>
   <label>Go to page <input type="number" inputmode="numeric" min="1" max="@PageCount" @bind="pageInput" /></label>
   <button type="submit" class="secondary" disabled="@saving">Go</button>
  </form>
  @if (jumpError is not null) { <p role="alert">@jumpError</p> }
  <label>Reading mode
   <select value="@mode" @onchange="ChangeMode">
    <option value="ltr">Left to right</option>
    <option value="rtl">Right to left</option>
    <option value="vertical">Vertical scrolling</option>
   </select>
  </label>
  <div class="filters reader-display">
   <label>Page fit
    <select value="@fit" @onchange="ChangeFit"><option value="width">Fit to width</option><option value="page">Fit to page</option></select>
   </label>
   <label>Zoom
    <select value="@zoom" @onchange="ChangeZoom">
     @foreach (var level in ReaderPreferences.ZoomLevels) { <option value="@level">@level%</option> }
    </select>
   </label>
  </div>
  <div class="reader-controls">
   <button class="secondary" @onclick="SaveTitleSettings">Remember layout for this title</button>
   @if (titleOverride) { <button class="secondary" @onclick="ClearTitleSettings">Use default layout</button> }
  </div>
  @if (layoutStatus is not null) { <p role="status">@layoutStatus</p> }
  <div class="reader-viewport @((zoom == 100 && fit == "page") ? "fit-page" : "") @(zoom > 100 ? "zoomed" : "")"
    style="@($"--reader-zoom:{zoom}%")">
  @if (mode == "vertical")
  {
   <div class="reader-stack" @ref="stack">
    @for (var page = 1; page <= PageCount; page++)
    {
     <img class="reader-page" data-reader-page="@(page)" src="@PageUrl(page)" alt="@PageDescription(page)" loading="lazy" />
    }
   </div>
  }
  else { <img class="reader-page" src="@PageUrl(currentPage)" alt="@PageDescription(currentPage)" /> }
  </div>
  <div class="reader-controls @(mode == "rtl" ? "reader-rtl" : "")">
   <button type="button" class="secondary" disabled="@(currentPage == 1 || saving)" @onclick="() => MoveTo(currentPage - 1)">@(mode == "rtl" ? "Previous →" : "← Previous")</button>
   @if (currentPage < PageCount)
   {
    <button type="button" class="primary" disabled="@saving" @onclick="() => MoveTo(currentPage + 1)">@(mode == "rtl" ? "← Next page" : "Next page →")</button>
   }
   else if (Pages is not null)
   {
    <button class="primary" disabled="@(completed || saving)" @onclick="Finish">@(completed ? "Chapter completed" : "Mark chapter read")</button>
   }
   else
   {
    <a class="primary" href="/manga/preview">Back to chapters</a>
   }
  </div>
  @if (PreviousChapter.HasDelegate || NextChapter.HasDelegate)
  {
   <div class="reader-controls">
    <button class="secondary" disabled="@(saving || !PreviousChapter.HasDelegate)" @onclick="() => OpenChapter(PreviousChapter)">← Previous chapter</button>
    <button class="secondary" disabled="@(saving || !NextChapter.HasDelegate)" @onclick="() => OpenChapter(NextChapter)">Next chapter →</button>
   </div>
  }
 </section>
@if (completionMessage is not null) { <p role="status">@completionMessage</p> }
 @if (storageError is not null)
 {
  <p class="notice" role="alert">@storageError</p>
 }
}
else
{
 <p role="status">Opening chapter…</p>
}

@code {
 int currentPage = 1;
 bool ready;
 bool saving, completed;
 [Parameter] public EventCallback PreviousChapter { get; set; }
 [Parameter] public EventCallback NextChapter { get; set; }
 [Parameter] public EventCallback OnCompleted { get; set; }
 string? storageError;
 string? completionMessage;
 [Parameter] public string TitleSettingsKey { get; set; } = "reader:title:midnight-lighthouse";
 [Parameter] public string ChapterKey {get;set;} = MangaSample.ChapterKey;
 [Parameter] public string Title {get;set;} = MangaSample.Title;
 [Parameter] public string ChapterLabel {get;set;} = "Chapter 1";
 [Parameter] public IReadOnlyList<string>? Pages {get;set;}
 int PageCount => Pages?.Count ?? MangaSample.PageDescriptions.Count;
 string PageUrl(int page) => Pages?[page - 1] ?? $"_content/AniKatha.UI/manga/midnight-lighthouse-{page}.webp";
 string PageDescription(int page) => Pages is null ? MangaSample.PageDescriptions[page - 1] : $"Page {page}";
 string pageInput = "";
 string? jumpError;

 async Task JumpToPage()
 {
  if (!int.TryParse(pageInput, NumberStyles.None, CultureInfo.InvariantCulture, out var page) || page < 1 || page > PageCount)
  {
   jumpError = $"Enter a page from 1 to {PageCount}.";
   return;
  }
  jumpError = null;
  await MoveTo(page);
 }

 string mode = "ltr", fit = "width";
 int zoom = 100;
 bool titleOverride;
 string? layoutStatus;

 async Task SaveTitleSettings()
 {
  try
  {
   await new ReaderPreferences(mode, fit, zoom).SaveAsync(Store, TitleSettingsKey);
   titleOverride = true;
   layoutStatus = "Layout saved for this title.";
  }
  catch { layoutStatus = "Could not save this title’s layout."; }
 }

 async Task ClearTitleSettings()
 {
  try
  {
   var defaults = await ReaderPreferences.LoadAsync(Store, ReaderPreferences.GlobalKey);
   await Store.SetSettingAsync(TitleSettingsKey, "");
   await StopObserving();
   (mode, fit, zoom) = (defaults.Mode, defaults.Fit, defaults.Zoom);
   titleOverride = false;
   layoutStatus = "Using reader defaults.";
  }
  catch { layoutStatus = "Could not restore the default layout."; }
 }

 void ChangeFit(ChangeEventArgs args)
 {
  fit = ReaderPreferences.SafeFit(args.Value?.ToString());
  zoom = 100;
 }

 void ChangeZoom(ChangeEventArgs args) => zoom = ReaderPreferences.SafeZoom(args.Value?.ToString());
 bool tracking, disposed;
 ElementReference stack;
 IJSObjectReference? readerModule, pageObserver;
 DotNetObjectReference<ReadMangaPreview>? callbacks;
 Task initialization = Task.CompletedTask;
 int? queuedPage;

 Task ChangeMode(ChangeEventArgs args)
 {
  mode = ReaderPreferences.SafeMode(args.Value?.ToString());
  if (mode != "vertical") return StopObserving();
  return Task.CompletedTask;
 }

 protected override Task OnAfterRenderAsync(bool firstRender)
 {
  if (disposed || !ready || mode != "vertical" || tracking) return Task.CompletedTask;
  tracking = true;
  return initialization = StartObserving();
 }

 async Task StartObserving()
 {
  try
  {
   readerModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AniKatha.UI/chapter-reader.mjs");
   if (readerModule is null || mode != "vertical" || disposed) return;
   callbacks ??= DotNetObjectReference.Create(this);
   pageObserver = await readerModule.InvokeAsync<IJSObjectReference>("watchPages", stack, callbacks, currentPage);
   if (mode != "vertical" || disposed) await StopObserving();
  }
  catch (JSDisconnectedException) { }
 }

 async Task StopObserving()
 {
  tracking = false;
  if (pageObserver is null) return;
  var observer = pageObserver;
  pageObserver = null;
  try { await observer.InvokeVoidAsync("dispose"); await observer.DisposeAsync(); }
  catch (JSDisconnectedException) { }
 }

 [JSInvokable]
 public Task ObservePage(int page)
 {
  if (disposed || mode != "vertical" || page < 1 || page > PageCount) return Task.CompletedTask;
  return InvokeAsync(async () =>
  {
   if (saving) { queuedPage = page; return; }
   await MoveTo(page, fromScroll: true);
   StateHasChanged();
  });
 }

 public async ValueTask DisposeAsync()
 {
  disposed = true;
  await initialization;
  await StopObserving();
  try { if (readerModule is not null) await readerModule.DisposeAsync(); }
  catch (JSDisconnectedException) { }
  callbacks?.Dispose();
 }

 protected override async Task OnInitializedAsync()
 {
  try
  {
   currentPage = Math.Clamp(await Store.GetReadingPageAsync(ChapterKey), 1, PageCount);
   completed = Pages is not null && await Store.IsUnitCompleteAsync(ChapterKey);
   titleOverride = !string.IsNullOrWhiteSpace(await Store.GetSettingAsync(TitleSettingsKey));
   var prefs = await ReaderPreferences.LoadAsync(Store, titleOverride ? TitleSettingsKey : ReaderPreferences.GlobalKey);
   (mode, fit, zoom) = (prefs.Mode, prefs.Fit, prefs.Zoom);
  }
  catch
  {
   storageError = "Your saved page couldn’t be loaded.";
  }
  finally
  {
   ready = true;
  }
 }

 async Task OpenChapter(EventCallback open)
 {
  if (saving || !open.HasDelegate) return;
  saving = true;
  try { await Store.SaveReadingPageAsync(ChapterKey, currentPage); }
  catch
  {
   storageError = "Your current page could not be saved.";
   saving = false;
   return;
  }
  try { await open.InvokeAsync(); }
  finally { saving = false; }
 }

 async Task ShowSyncResult(Task<string> sync)
 {
  var message = await sync;
  if (!disposed) await InvokeAsync(() =>
  {
   completionMessage = message;
   StateHasChanged();
  });
 }

 async Task Finish()
 {
  if (saving || completed || currentPage != PageCount) return;
  saving = true;
  try
  {
   await Store.SaveReadingPageAsync(ChapterKey, currentPage);
   var receipt = await AddonCompletion.SaveAsync(Store, Services, ChapterKey);
   completionMessage = receipt.Message;
   if (receipt.Sync is not null) _ = ShowSyncResult(receipt.Sync);
   completed = true;
   storageError = null;
   await OnCompleted.InvokeAsync();
  }
  catch { storageError = "Could not mark this chapter read."; }
  finally { saving = false; }
 }

 async Task MoveTo(int next, bool fromScroll = false)
 {
  if (saving || next == currentPage || next < 1 || next > PageCount)
   return;

  saving = true;
  currentPage = next;
  try
  {
   await Store.SaveReadingPageAsync(ChapterKey, next);
   if (!fromScroll && pageObserver is not null) await pageObserver.InvokeVoidAsync("show", next);
   storageError = null;
  }
  catch
  {
   storageError = "Your reading position couldn’t be saved.";
  }
  finally
  {
   saving = false;
  }
  if (queuedPage is int queued)
  {
   queuedPage = null;
   if (!disposed && mode == "vertical") await MoveTo(queued, fromScroll: true);
  }
 }
}
