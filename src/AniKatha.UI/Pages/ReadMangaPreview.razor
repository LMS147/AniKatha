@page "/manga/preview/chapter-1"
@inject LocalStore Store

<PageTitle>Read @MangaSample.Title · AniKatha</PageTitle>
<header class="page-header reader-header">
 <a class="text-link" href="/manga/preview">← Chapters</a>
 <h1 class="sample-heading">@MangaSample.Title</h1>
 <p>Chapter 1</p>
</header>

@if (ready)
{
 <section class="manga-reader" aria-label="Chapter 1 reader">
  <p class="reader-position" role="status">Page @currentPage of @PageCount</p>
  <img class="reader-page" src="@PageUrl" alt="@MangaSample.PageDescriptions[currentPage - 1]"/>
  <div class="reader-controls">
   <button type="button" class="secondary" disabled="@(currentPage == 1 || saving)" @onclick="() => MoveTo(currentPage - 1)">← Previous</button>
   @if (currentPage < PageCount)
   {
    <button type="button" class="primary" disabled="@saving" @onclick="() => MoveTo(currentPage + 1)">Next page →</button>
   }
   else
   {
    <a class="primary" href="/manga/preview">Back to chapters</a>
   }
  </div>
 </section>
 @if (storageError is not null)
 {
  <p class="notice" role="alert">@storageError</p>
 }
}
else
{
 <p role="status">Opening chapter…</p>
}

@code {
 int currentPage = 1;
 bool ready;
 bool saving;
 string? storageError;
 int PageCount => MangaSample.PageDescriptions.Count;
 string PageUrl => $"_content/AniKatha.UI/manga/midnight-lighthouse-{currentPage}.webp";

 protected override async Task OnInitializedAsync()
 {
  try
  {
   currentPage = Math.Clamp(await Store.GetReadingPageAsync(MangaSample.ChapterKey), 1, PageCount);
  }
  catch
  {
   storageError = "Your saved page couldn’t be loaded.";
  }
  finally
  {
   ready = true;
  }
 }

 async Task MoveTo(int next)
 {
  if (saving || next < 1 || next > PageCount)
   return;

  saving = true;
  currentPage = next;
  try
  {
   await Store.SaveReadingPageAsync(MangaSample.ChapterKey, next);
   storageError = null;
  }
  catch
  {
   storageError = "Your reading position couldn’t be saved.";
  }
  finally
  {
   saving = false;
  }
 }
}
