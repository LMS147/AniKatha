@page "/"
@inject AniListClient Catalog
@inject LocalStore Store
<header class="brand-header"><a class="wordmark" href="/">ani<span>katha</span><i>✦</i></a><a class="avatar" href="/profile" aria-label="Open profile">A</a></header>
@if(loading){<div class="hero skeleton" aria-label="Loading featured anime"></div>}
else if(featured is not null){
 <section class="hero" style="background-image:linear-gradient(0deg,#0b0b10 2%,#0b0b1055 65%),url('@(featured.Banner??featured.Poster)')">
  <div class="hero-copy"><span class="eyebrow">YOUR NEXT STORY</span><h1>@featured.Title</h1><p>@featured.Year · @featured.Format?.Replace('_',' ') · @string.Join(" / ",featured.Genres.Take(2))</p><button class="primary" @onclick="()=>selected=featured">Explore title <span>↗</span></button></div>
 </section>
}else{<section class="welcome"><span class="eyebrow">WATCH. READ. DISCOVER.</span><h1>A world of stories.<br/>One place to begin.</h1><p class="muted">Your anime and manga companion.</p></section>}
@if(error is not null){<div class="notice" role="alert">@error <button @onclick="Load">Retry</button></div>}
<a class="playback-preview-card" href="/anime/preview">
 <Icon Name="play"/>
 <span><strong>Big Buck Bunny</strong><small>Sample episode · Test in-app playback</small></span>
 <span aria-hidden="true">→</span>
</a>
<div class="section-title"><div><span class="eyebrow">PICK UP A STORY</span><h2>Your library</h2></div><a href="/library">View all ↗</a></div>
@if(saved.Count==0){<div class="empty compact"><Icon Name="library"/><h3>Your next favourite belongs here</h3><p>Save titles from Anime or Manga to start your collection.</p><a class="text-link" href="/anime">Discover anime →</a></div>}
else{<div class="saved-strip">@foreach(var item in saved.Take(8)){<a href="/library" class="saved-mini">@if(item.Poster is not null){<img src="@item.Poster" alt=""/>}<strong>@item.Title</strong><small>@item.Status</small></a>}</div>}
<div class="section-title"><div><span class="eyebrow">IN THE SPOTLIGHT</span><h2>Trending anime</h2></div><a href="/anime">Explore ↗</a></div>
<MediaGrid Items="anime.Take(6)" Selected="Select"/>
<div class="section-title"><div><span class="eyebrow">ONE MORE CHAPTER</span><h2>Trending manga</h2></div><a href="/manga">Explore ↗</a></div>
<MediaGrid Items="manga.Take(6)" Selected="Select"/>
<MediaDetails Item="selected" Closed="Close"/>
@code {
 List<Media> anime=[],manga=[]; List<SavedTitle> saved=[]; Media? featured,selected; bool loading=true; string? error;
 protected override Task OnInitializedAsync()=>Load();
 async Task Load(){loading=true;error=null;try{saved=await Store.GetLibraryAsync();anime=(await Catalog.SearchAsync(new())).Items;featured=anime.FirstOrDefault(x=>x.Banner is not null)??anime.FirstOrDefault();manga=(await Catalog.SearchAsync(new("MANGA"))).Items;}catch{error="The catalogue could not be loaded. Check your connection or try again later. Your saved library is available offline.";}finally{loading=false;}}
 void Select(Media item)=>selected=item;
 async Task Close(){selected=null;saved=await Store.GetLibraryAsync();}
}
