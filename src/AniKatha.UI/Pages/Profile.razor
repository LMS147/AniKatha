@page "/profile"
@inherits ProfileComponent
@inject IServiceProvider Services

<section class="settings-screen profile-hub">
 <header class="page-header"><h1>Profile</h1></header>
 <section class="profile-card">
  <div class="profile-identity">
   <ProfileAvatar Name="@Active.Name" Avatar="@Active.Avatar" Size="large" />
   <div><h2>@Active.Name</h2><p>@(Active.Locked ? "PIN protected · On this device" : "On this device")</p></div>
  </div>
  <a class="secondary" href="/profile/profiles">Switch profile</a>
 </section>
 <div class="settings-list">
  <a class="settings-row" href="/profile/appearance"><span class="settings-icon" aria-hidden="true">✦</span>
   <span><strong>Appearance</strong><small>Theme, accent colour, and poster density</small></span><span aria-hidden="true">›</span></a>
  <a class="settings-row" href="/profile/sources"><span class="settings-icon" aria-hidden="true">⊕</span>
   <span><strong>Sources</strong><small>Install and manage add-ons</small></span><span aria-hidden="true">›</span></a>
  <a class="settings-row" href="/profile/anilist"><span class="settings-icon" aria-hidden="true">◎</span>
   <span><strong>AniList</strong><small>@accountStatus</small></span><span aria-hidden="true">›</span></a>
  <a class="settings-row" href="/profile/playback"><span class="settings-icon" aria-hidden="true">▷</span>
   <span><strong>Playback &amp; reader</strong><small>Player, subtitles, and reading defaults</small></span><span aria-hidden="true">›</span></a>
 </div>
</section>

@code {
 LocalProfile Active => (Services.GetService(typeof(LocalProfiles)) as LocalProfiles)?.Active ?? LocalProfile.Default;
 string accountStatus = "Not connected";
 protected override async Task OnInitializedAsync()
 {
  try
  {
   if (ProfileAniList is { } account && await account.CachedLinkAsync() is { } link)
    accountStatus = link.RequiresReconnect ? $"Reconnect {link.Viewer.Name}" : $"Connected as {link.Viewer.Name}";
  }
  catch { accountStatus = "Could not check account"; }
 }
}
