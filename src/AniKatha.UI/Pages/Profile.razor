@page "/profile"
@inherits ProfileComponent
@inject IServiceProvider Services

<PageTitle>Profile · AniKatha</PageTitle>
<section class="settings-screen profile-hub profile-tabs-screen profile-template">
 <header class="profile-brand"><Icon Name="user" /><h1>Profile</h1><a class="secondary" href="/profile/profiles" aria-label="Switch profile">Switch <span aria-hidden="true">⇄</span></a></header>
 <nav class="profile-tabs" role="tablist" aria-label="Profile sections">
  @foreach (var name in Tabs)
  {
   <button type="button" role="tab" aria-selected="@(tab == name ? "true" : "false")" @onclick="() => tab = name">@name</button>
  }
 </nav>
 <div class="profile-panel" hidden="@(tab != "Account")">
  <h2 class="profile-tab-title">Account</h2>
  @if (Profiles is { } profiles) { <ProfileAccount Profiles="profiles" /> }

 </div>
 @if (tab == "Preferences")
 {
  <div class="profile-panel"><h2 class="profile-tab-title">Preferences</h2><ProfilePreferences /></div>
 }
 @if (tab == "Sync" || syncOpened)
 {
  <div class="profile-panel" hidden="@(tab != "Sync")">
   <header class="profile-template-heading"><h2 class="profile-tab-title">Sync</h2><span class="profile-service-pill"><b>AL</b> AniList</span></header>
   <AniListProfile Template="true" />
   <ProfileBackup />
  </div>
 }
 @if (tab == "Security" || securityOpened)
 {
  <div class="profile-panel" hidden="@(tab != "Security")">
   <header class="profile-template-heading profile-security-heading"><h2 class="profile-tab-title">Security</h2>
    <p>Protect access to this local profile on this device with a 4–8 digit PIN.</p>
   </header>
   @if (Profiles is not null) { <ProfilePinForm /> }
   <section class="settings-card profile-security-note">
    <h3><Icon Name="info" /> AniList credentials</h3>
    <p>AniKatha profiles are local to this device. AniList manages its own password and email. Use Sync to manage your linked AniList connection.</p>
   </section>
  </div>
 }
</section>

@code {
 [SupplyParameterFromQuery] public string? Section { get; set; }
 static readonly string[] Tabs = ["Account", "Preferences", "Sync", "Security"];
 string selected = "Account";
 bool syncOpened, securityOpened;
 LocalProfiles? Profiles => Services.GetService(typeof(LocalProfiles)) as LocalProfiles;
 string tab
 {
  get => selected;
  set
  {
   selected = value;
   syncOpened |= value == "Sync";
   securityOpened |= value == "Security";
  }
 }
 protected override void OnParametersSet() =>
  tab = Tabs.FirstOrDefault(name => name.Equals(Section, StringComparison.OrdinalIgnoreCase)) ?? "Account";
}
