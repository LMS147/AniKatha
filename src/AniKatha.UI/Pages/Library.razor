@page "/library"
@inherits ProfileComponent
@implements IDisposable
<section class="design-library">
<header class="page-header design-heading">
 <div class="template-title"><Icon Name="library" /><h1>Library</h1></div>
 <a class="secondary template-pill" href="/library?view=downloads" @onclick='() => ChangeView("Downloads")'><Icon Name="download" />Downloads</a>
</header>
<div class="template-section-tabs" role="group" aria-label="Library views">
 @foreach (var tab in Views)
 {
  <button type="button" aria-pressed="@(filter == tab.Filter ? "true" : "false")" @onclick="() => ChangeView(tab.Filter)">@tab.Label</button>
 }
</div>
@if (filter == "Downloads")
{
 <DownloadShelf/>
}
else
{
 @if(error is not null) { <div class="notice" role="alert">@error</div> }
 @if (pending.Count > 0)
 {
  <p class="tracking-pending"><span aria-hidden="true">◷</span> Tracking changes waiting to sync.
   <a class="text-link" href="/profile/anilist">@(link?.RequiresReconnect == true ? "Reconnect AniList" : "Manage sync")</a>
  </p>
 }
 @if (!loading && filter is "All" or "Stats")
 {
  @if (filter == "Stats")
  {
   <div class="design-segments design-stat-tabs" role="group" aria-label="Statistics media">
    <button type="button" aria-pressed="@(statsKind == "ANIME" ? "true" : "false")" @onclick='() => statsKind = "ANIME"'>Anime</button>
    <button type="button" aria-pressed="@(statsKind == "MANGA" ? "true" : "false")" @onclick='() => statsKind = "MANGA"'>Manga</button>
   </div>
  }
  <div class="design-overview">
   @foreach (var kind in filter == "All" ? new[] { "ANIME", "MANGA" } : new[] { statsKind })
   {
    var media = items.Where(item => item.Kind == kind).ToArray();
    var name = kind == "MANGA" ? "Manga" : "Anime";
    var rated = media.Where(item => scores.ContainsKey(item.Id)).Select(item => scores[item.Id]).ToArray();
    <section class="settings-card design-stat-card">
     <header><h2>@name @(filter == "Stats" ? "Stats" : "Overview")</h2>
      @if (filter == "All") { <button type="button" class="text-link" @onclick="() => ShowStats(kind)">Full stats</button> }
     </header>
     <dl class="design-stat-metrics">
      <div><dt>Entries</dt><dd>@media.Length</dd></div>
      <div><dt>@(name == "Manga" ? "Chapters read" : "Episodes watched")</dt><dd>@media.Sum(item => (long)item.Progress)</dd></div>
      <div><dt>@(name == "Manga" ? "Days read" : "Days watched")</dt><dd title="Time totals are unavailable">—</dd></div>
      <div><dt>Mean score</dt><dd>@(rated.Length == 0 ? "—" : $"{rated.Average():0.00} / 10")</dd></div>
     </dl>
     @if (media.Length > 0)
     {
      <div class="design-status-bar" aria-hidden="true">
       @foreach (var state in Statuses)
       {
        var count = media.Count(item => item.Status == state);
        if (count > 0) { <span class="@StatusColor(state)" style="@($"flex-grow:{count}")"></span> }
       }
      </div>
     }
     <ul class="design-stat-breakdown">
      @foreach (var state in Statuses.Where(state => media.Any(item => item.Status == state)))
      {
       var count = media.Count(item => item.Status == state);
       <li><span><i class="@StatusColor(state)"></i>@TrackingDisplay.Status(state, name == "Manga")</span><strong>@count</strong></li>
      }
     </ul>
     @if (filter == "Stats" && rated.Length > 0)
     {
      <h3>Score distribution <small>(@rated.Length scored)</small></h3>
      <div class="design-score-bars">
      @foreach (var score in Enumerable.Range(1, 10))
      {
       var count = rated.Count(value => Math.Clamp((int)Math.Ceiling(value), 1, 10) == score);
       <div><meter min="0" max="@rated.Length" value="@count" aria-label="@($"Score {score}: {count} titles")"></meter><span>@score</span></div>
      }
      </div>
     }
    </section>
   }
  </div>
  @if (filter == "All")
  {
   <div class="design-library-shortcuts">
    <button class="secondary" @onclick='() => ChangeView("Favourites")'>Favourites <small>@items.Count(item => item.IsFavourite) saved</small></button>
    <button class="secondary" @onclick='() => ChangeView("Downloads")'><Icon Name="download" />Downloads</button>
    <a class="secondary" href="#library-resume"><Icon Name="history" />Resume</a>
   </div>
  }
 }
 @if (filter is "Anime" or "Manga")
 {
  <div class="design-library-controls">
   <label>Status<select @bind="status">
    <option value="">All statuses (@items.Count(item => item.Kind == filter.ToUpperInvariant()))</option>
    @foreach (var state in Statuses) { <option value="@state">@TrackingDisplay.Status(state, filter == "Manga") (@items.Count(item => item.Kind == filter.ToUpperInvariant() && item.Status == state))</option> }
   </select></label>
   <label>Sort<select @bind="order"><option value="">Last updated</option><option value="title">Title</option><option value="progress">Progress</option></select></label>
  </div>
  <p class="muted">@Visible.Count() entries</p>
 }
 @if (loading)
 {
  <p role="status">Opening your library…</p>
 }
 else if (filter != "Stats" && !Visible.Any())
 {
  <div class="empty"><Icon Name="library"/><h2>No @(filter == "All" ? "saved titles" : filter.ToLowerInvariant()) here yet</h2>
   <p>Save titles from Anime or Manga, or import your AniList lists.</p><a class="primary" href="/anime">Find a story</a>
  </div>
 }
 else if (filter != "Stats")
 {
  <div class="library-list">
  @foreach (var item in Visible)
  {
   var titlePath = $"/library/title/{item.Id}";
   <article class="library-item tracking-library-card" @key="item.Id">
    @if (item.Poster is { } cover && AddonResources.MediaUrl(cover)) { <img src="@cover" alt="" loading="lazy"/> }
    else { <div class="tracking-cover-placeholder" aria-hidden="true"><Icon Name="@(item.Kind == "MANGA" ? "book" : "play")"/></div> }
    <div>
     <small class="eyebrow">@TrackingDisplay.Mode(item)</small>
     <h3><a href="@titlePath">@item.Title</a></h3>
     <p class="tracking-line"><strong>@TrackingDisplay.Status(item.Status, item.Kind == "MANGA")</strong> · @TrackingDisplay.Progress(item, Total(item.Id))</p>
     @if (scores.TryGetValue(item.Id, out var personalScore)) { <small>★ @personalScore.ToString("0.0") / 10</small> }
     @if (pending.Contains(item.Id))
     {
      <p class="tracking-pending"><span aria-hidden="true">◷</span> Saved on this device · Waiting to sync</p>
     }
     else if (confirmed.Contains(item.Id))
     {
      <p class="tracking-line"><span aria-hidden="true">✓</span> Synced to AniList</p>
     }
     <div class="tracking-card-actions">
      <a class="secondary template-edit" aria-label="Edit tracking" href="@($"{titlePath}/tracking")"><Icon Name="edit" /><span>Edit tracking</span></a>
      <a class="text-link" href="@titlePath">Find Sources</a>
      <button class="text-link" aria-pressed="@item.IsFavourite" @onclick="()=>Favourite(item)">@(item.IsFavourite ? "Remove favourite" : "Add to favourites")</button>
     </div>
    </div>
   </article>
  }
  </div>
 }
 @if (filter is "All" or "Anime" or "Manga") { <div id="library-resume"><ResumeHistory ShowRemove="true" MediaFilter="@filter"/></div> }
}
</section>
@code {
 [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
 static readonly (string Filter, string Label)[] Views =
  [("All", "Overview"), ("Anime", "Anime List"), ("Manga", "Manga List"), ("Stats", "Stats")];
 static readonly string[] Statuses = ["CURRENT", "COMPLETED", "PAUSED", "DROPPED", "PLANNING", "REPEATING"];
 string filter = "All", statsKind = "ANIME", status = "", order = "";
 static string StatusColor(string state) => $"status-{state.ToLowerInvariant()}";
 void ChangeView(string next) { filter = next; status = ""; }
 void ShowStats(string kind) { statsKind = kind; ChangeView("Stats"); }
 string? error;
 bool loading = true, disposed;
 long revision;
 AniListLink? link;
 List<SavedTitle> items = [];
 IReadOnlySet<int> pending = new HashSet<int>(), confirmed = new HashSet<int>();
 IReadOnlyDictionary<int, int> totals = new Dictionary<int, int>();
 Dictionary<int, double> scores = [];
 IEnumerable<SavedTitle> Visible
 {
  get
  {
   var matches = items.Where(item => (filter == "Favourites" ? item.IsFavourite : filter == "All" ||
    item.Kind == filter.ToUpperInvariant()) && (status.Length == 0 || item.Status == status));
   return order switch
   {
    "title" => matches.OrderBy(item => item.Title, StringComparer.CurrentCultureIgnoreCase),
    "progress" => matches.OrderByDescending(item => item.Progress),
    _ => matches
   };
  }
 }
 int? Total(int id) => totals.TryGetValue(id, out var known) ? known : null;

 string? appliedView;
 protected override void OnParametersSet()
 {
  if (string.Equals(View, appliedView, StringComparison.OrdinalIgnoreCase)) return;
  appliedView = View;
  ChangeView(View?.ToLowerInvariant() switch { "downloads" => "Downloads", "anime" => "Anime", "manga" => "Manga", "stats" => "Stats", _ => "All" });
 }

 protected override async Task OnInitializedAsync()
 {
  Store.AniListChanged += Changed;
  await Load();
 }

 async Task Load()
 {
  var request = ++revision;
  try
  {
   var found = await Store.GetLibraryAsync();
   if (disposed || revision != request) return;
   items = found;
   var active = ProfileAniList is { } account ? await account.CachedLinkAsync() : null;
   var pendingIds = active is null ? new HashSet<int>() : (await Store.AniListEditsAsync(active.Viewer.Id)).Select(edit => edit.MediaId).ToHashSet();
   var acknowledged = active is null ? new HashSet<int>() : await Store.ConfirmedTrackingTitlesAsync(active.Viewer.Id);
   var knownTotals = await Store.TrackingTotalsAsync(active?.Viewer.Id);
   var ratings = new Dictionary<int, double>();
   if (active is { } accountLink)
   {
    var scale = AniListAccount.ScoreScale(accountLink.Viewer.ScoreFormat);
    foreach (var item in found.Where(TrackingDisplay.CanSync))
    {
     if (disposed || revision != request) return;
     if (await Store.GetAniListScoreAsync(accountLink.Viewer.Id, item.Id, accountLink.Viewer.ScoreFormat) is double score)
      ratings[item.Id] = score * 10 / scale.Maximum;
    }
   }
   if (!disposed && revision == request) (link, pending, confirmed, totals, scores) = (active, pendingIds, acknowledged, knownTotals, ratings);
  }
  catch { if (!disposed && revision == request) error = "Some Library information could not be loaded."; }
  finally { if (!disposed && revision == request) loading = false; }
 }
 void Changed() => _ = InvokeAsync(async () =>
 {
  if (disposed) return;
  await Load();
  if (!disposed) StateHasChanged();
 });

 async Task Favourite(SavedTitle item)
 {
  try
  {
   await Store.SetFavouriteAsync(item.Id, !item.IsFavourite);
   item.IsFavourite = !item.IsFavourite;
  }
  catch { error = "Could not save favourite."; }
 }
 public void Dispose() { disposed = true; Store.AniListChanged -= Changed; }
}
