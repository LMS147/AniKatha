@page "/library"
@inherits ProfileComponent
@implements IDisposable
@inject IServiceProvider Services
<section class="design-library library-template">
 <header class="page-header design-heading">
  <div class="template-title"><Icon Name="library" /><h1>Library</h1></div>
  <a class="secondary template-pill" href="/library?view=downloads" aria-label="Downloads and offline files"><Icon Name="download" />Downloads</a>
 </header>
 <div class="template-section-tabs" role="tablist" aria-label="Library sections">
  @foreach (var tab in Views)
  {
   <button type="button" role="tab" aria-selected="@SelectedTab(tab.Filter)" @onclick="() => ChangeView(tab.Filter)">@tab.Label</button>
  }
 </div>
 @if (error is not null) { <div class="notice" role="alert">@error</div> }
 @if (pending.Count > 0 && filter is not ("Downloads" or "History"))
 {
  <p class="tracking-pending"><span aria-hidden="true">◷</span> Saved on this device · Waiting to sync
   <a class="text-link" href="/profile/anilist">@(link?.RequiresReconnect == true ? "Reconnect AniList" : "Manage sync")</a>
  </p>
 }
 @if (filter == "Downloads") { <DownloadShelf /> }
 else if (filter == "History")
 {
  <h2>Resume History</h2>
  <ResumeHistory @key="historyKind" ShowRemove="true" MediaFilter="@historyKind" />
 }
 else if (loading) { <p role="status">Opening your library…</p> }
 else if (filter == "All")
 {
  <div class="library-template-stack">
   @foreach (var kind in new[] { "ANIME", "MANGA" })
   {
    var manga = kind == "MANGA";
    var name = manga ? "Manga" : "Anime";
    var titles = items.Where(item => item.Kind == kind).ToArray();
    <section class="library-panel">
     <header><h2>@name Overview</h2><button type="button" class="text-link" @onclick="() => ShowStats(kind)">Full Stats ›</button></header>
     @Metrics(titles, manga, false)
     @if (titles.Length > 0)
     {
      <div class="library-status-strip" aria-hidden="true">
       @foreach (var state in Statuses)
       {
        var count = titles.Count(item => item.Status == state);
        if (count > 0) { <span class="@StatusColor(state)" style="@($"flex:{count}")"></span> }
       }
      </div>
      <ul class="library-status-legend">
       @foreach (var state in Statuses)
       {
        var count = titles.Count(item => item.Status == state);
        <li><i class="@StatusColor(state)"></i><span>@TrackingDisplay.Status(state, manga)</span><strong>@count</strong></li>
       }
      </ul>
     }
     <div class="library-recent">
      <header><h3>Last @name Updates</h3><button class="text-link" type="button" @onclick="() => ShowHistory(name)">@name History ›</button></header>
      @foreach (var item in titles.Take(2))
      {
       <a class="library-recent-item" href="@TitlePath(item)">
        <LibraryCover Poster="@item.Poster" Manga="manga" />
        <div><strong>@item.Title</strong><small>@TrackingDisplay.Progress(item, Total(item))</small></div>
        @if (item.UpdatedAt != default) { <time datetime="@item.UpdatedAt.ToString("O")">@RelativeTime(item.UpdatedAt)</time> }
       </a>
      }
      @if (titles.Length == 0) { <p>No @name.ToLowerInvariant() updates yet.</p> }
     </div>
    </section>
   }
   <section class="library-panel library-favorites">
    <header><h2>Favorites</h2><span class="library-number">@items.Count(item => item.IsFavourite) saved</span></header>
    @foreach (var name in new[] { "Anime", "Manga" })
    {
     var favorites = items.Where(item => item.IsFavourite && item.Kind == name.ToUpperInvariant()).ToArray();
     <b>@name (@favorites.Length)</b>
     <div class="library-favorite-grid">
      @foreach (var item in favorites)
      {
       <a aria-label="@item.Title" title="@item.Title" href="@TitlePath(item)"><LibraryCover Poster="@item.Poster" Manga="@(name == "Manga")" /></a>
      }
     </div>
    }
   </section>
   <div class="design-library-shortcuts library-quick-links">
    <button type="button" aria-label="Downloads" @onclick='() => ChangeView("Downloads")'><Icon Name="download" /><span><strong>Downloads</strong><small>@offlineCount offline</small></span><span aria-hidden="true">›</span></button>
    <button type="button" @onclick='() => ShowHistory("All")'><Icon Name="history" /><span><strong>Resume</strong><small>@resumeCount positions</small></span><span aria-hidden="true">›</span></button>
   </div>
  </div>
 }
 else if (filter == "Stats")
 {
  var manga = statsKind == "MANGA";
  var name = manga ? "Manga" : "Anime";
  var titles = items.Where(item => item.Kind == statsKind).ToArray();
  <div class="library-template-stack library-stats">
   <header><h2>@name Stats</h2>
    <div class="library-stats-toggle" role="group" aria-label="Statistics media">
     <button type="button" aria-pressed="@(!manga ? "true" : "false")" @onclick='() => ShowStats("ANIME")'>Anime</button>
     <button type="button" aria-pressed="@(manga ? "true" : "false")" @onclick='() => ShowStats("MANGA")'>Manga</button>
    </div>
   </header>
   <section class="library-panel" aria-label="@($"{name} summary metrics")">@Metrics(titles, manga, true)</section>
   @{
    var rated = Ratings(titles);
    var bins = Enumerable.Range(1, 10).Select(score => rated.Count(value => Math.Clamp((int)Math.Ceiling(value), 1, 10) == score)).ToArray();
    var counts = titles.Select(item => (Item: item, Info: Metadata(item))).ToArray();
    var years = counts.Where(entry => entry.Info?.Year is not null).GroupBy(entry => entry.Info!.Year!.Value)
        .OrderByDescending(group => group.Key).Take(5).OrderBy(group => group.Key).ToArray();
   }
   <section class="library-panel">
    <header><h3>Score Distribution</h3><small>(@rated.Length scored)</small></header>
    <div class="library-chart" style="--columns:10">
     @for (var index = 0; index < bins.Length; index++)
     {
      <div><span class="library-column"><i style="@($"--bar:{Percent(bins[index], bins.Max())}%")" title="@($"{bins[index]} titles")"></i></span><span>@(index + 1)</span></div>
     }
    </div>
   </section>
   @Breakdown("Format", counts.SelectMany(entry => entry.Info?.Format is { } format ? new[] { (format, entry.Item) } : []), titles.Length, showScores: true)
   <section class="library-panel">
    <h3>Release Year</h3>
    @if (years.Length == 0) { <small>@MetadataStatus</small> }
    else
    {
     <div class="library-chart" style="@($"--columns:{years.Length}")">
      @foreach (var year in years)
      {
       <div><span class="library-column"><i style="@($"--bar:{Percent(year.Count(), years.Max(group => group.Count()))}%")" title="@($"{year.Count()} titles")"></i></span><span>@year.Key</span></div>
      }
     </div>
    }
   </section>
   @Breakdown("Genres", counts.SelectMany(entry => (entry.Info?.Genres ?? []).Distinct().Select(genre => (genre, entry.Item))), titles.Length)
   @if (!manga)
   {
    <section class="library-panel library-credits">
     @Breakdown("Studios", counts.SelectMany(entry => (entry.Info?.Studios ?? []).Distinct().Select(studio => (studio, entry.Item))), titles.Length, bars: false)
     @Breakdown("Source Material", counts.SelectMany(entry => entry.Info?.Source is { } source ? new[] { (source, entry.Item) } : []), titles.Length, bars: false)
    </section>
   }
  </div>
 }
 else
 {
  var manga = filter == "Manga";
  var visible = Visible.ToArray();
  <div class="design-library-controls">
   <label class="library-sr-only" for="library-status">Filter @(manga ? "manga" : "anime") by status</label>
   <select id="library-status" @bind="status">
    <option value="">All Statuses (@items.Count(item => item.Kind == filter.ToUpperInvariant()))</option>
    @foreach (var state in Statuses) { <option value="@state">@TrackingDisplay.Status(state, manga) (@items.Count(item => item.Kind == filter.ToUpperInvariant() && item.Status == state))</option> }
   </select>
  </div>
  <div class="library-list-toolbar">
   <b>@visible.Length entries</b>
   <label class="library-sort"><span aria-hidden="true">⇅</span><span class="library-sr-only">Sort library</span>
    <select @bind="order"><option value="">Last Updated</option><option value="title">Title</option><option value="progress">Progress</option><option value="score">Score</option></select>
   </label>
   <button type="button" class="library-icon-button" aria-label="Filter @(manga ? "manga" : "anime") list" aria-expanded="@(filtersOpen ? "true" : "false")" @onclick="() => filtersOpen = !filtersOpen"><Icon Name="filters" /></button>
  </div>
  @if (filtersOpen)
  {
   <div class="library-panel library-filters"><label>Search titles<input type="search" @bind="search" @bind:event="oninput" /></label>
    <label><input type="checkbox" @bind="favoritesOnly" /> Favorites only</label></div>
  }
  @if (visible.Length == 0)
  {
   <div class="empty compact"><Icon Name="library" /><h2>No titles here yet</h2><a class="primary" href="@(manga ? "/manga" : "/anime")">Browse @(manga ? "Manga" : "Anime")</a></div>
  }
  <div class="library-list library-template-list">
   @foreach (var item in visible)
   {
    var total = Total(item);
    var info = Metadata(item);
    <article class="library-item tracking-library-card" @key="item.Id">
     <a href="@TitlePath(item)" aria-label="@item.Title"><LibraryCover Poster="@item.Poster" Manga="manga" /></a>
     <div class="library-item-copy">
      <header><div><h3><a href="@TitlePath(item)">@item.Title</a></h3>
       <p>@string.Join(" · ", new[] { Format(info?.Format), info?.Year?.ToString(), TrackingDisplay.Status(item.Status, manga) }.Where(value => !string.IsNullOrEmpty(value)))</p>
      </div><a class="library-icon-button" aria-label="@($"Edit {item.Title} progress")" href="@($"{TitlePath(item)}/tracking")"><Icon Name="edit" /></a></header>
      <div class="library-item-progress">
       @if (total is > 0) { <progress value="@Math.Clamp(item.Progress, 0, total.Value)" max="@total" aria-label="@TrackingDisplay.Progress(item, total)"></progress> }
       <div>
        <span class="@(scores.ContainsKey(item.Id) ? "library-rated" : "")"><span aria-hidden="true">★</span> @(scores.TryGetValue(item.Id, out var score) ? score.ToString("0.0") : "—")</span>
        <span aria-label="@TrackingDisplay.Progress(item, total)">@item.Progress@(total is > 0 ? $"/{total}" : "") @(manga ? "ch" : "ep")</span>
       </div>
      </div>
      @if (pending.Contains(item.Id)) { <p class="tracking-pending">Saved on this device · Waiting to sync</p> }
      else if (confirmed.Contains(item.Id)) { <small>✓ Synced to AniList</small> }
     </div>
    </article>
   }
  </div>
 }
</section>
@code {
 [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
 static readonly (string Filter, string Label)[] Views =
  [("All", "Overview"), ("Anime", "Anime List"), ("Manga", "Manga List"), ("Stats", "Stats")];
 static readonly string[] Statuses = ["CURRENT", "COMPLETED", "PAUSED", "DROPPED", "PLANNING", "REPEATING"];
 string filter = "All", statsKind = "ANIME", status = "", order = "", search = "", historyKind = "All";
 bool filtersOpen, favoritesOnly, metadataLoading;
 int resumeCount, offlineCount;
 readonly CancellationTokenSource metadataStop = new();
 readonly Dictionary<(string Kind, int Id), LibraryTitleMetadata> metadata = [];
 readonly HashSet<(string Kind, int Id)> metadataChecked = [];
 string MetadataStatus => metadataLoading ? "Loading title metadata…" : "No metadata available.";
 string SelectedTab(string name) => filter == name || name == "All" && filter == "History" ? "true" : "false";
 static string StatusColor(string state) => $"status-{state.ToLowerInvariant()}";
 void ChangeView(string next)
 {
  filter = next;
  status = search = "";
  filtersOpen = favoritesOnly = false;
  _ = LoadMetadata();
 }
 void ShowHistory(string kind) { historyKind = kind; ChangeView("History"); }
 void ShowStats(string kind) { statsKind = kind; ChangeView("Stats"); }
 string? error;
 bool loading = true, disposed;
 long revision;
 AniListLink? link;
 List<SavedTitle> items = [];
 IReadOnlySet<int> pending = new HashSet<int>(), confirmed = new HashSet<int>();
 IReadOnlyDictionary<int, int> totals = new Dictionary<int, int>();
 Dictionary<int, double> scores = [];
 IEnumerable<SavedTitle> Visible
 {
  get
  {
   var matches = items.Where(item => item.Kind == filter.ToUpperInvariant() &&
    (status.Length == 0 || item.Status == status) && (!favoritesOnly || item.IsFavourite) &&
    item.Title.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase));
   return order switch
   {
    "title" => matches.OrderBy(item => item.Title, StringComparer.CurrentCultureIgnoreCase),
    "progress" => matches.OrderByDescending(item => item.Progress),
    "score" => matches.OrderByDescending(item => scores.GetValueOrDefault(item.Id, -1)),
    _ => matches
   };
  }
 }
 int? Total(SavedTitle item) => totals.TryGetValue(item.Id, out var known) ? known : Metadata(item)?.Units;
 LibraryTitleMetadata? Metadata(SavedTitle item) => TrackingDisplay.CanSync(item)
  ? metadata.GetValueOrDefault((item.Kind, item.Id)) : null;
 static string TitlePath(SavedTitle item) => $"/library/title/{item.Id}";
 static int Percent(int count, int total) => total == 0 ? 0 : (int)Math.Round(100.0 * count / total);
 static string? Format(string? value) => value is null or "" ? null : value switch
 {
  "TV" or "OVA" or "ONA" or "OEL" => value,
  _ => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(value.Replace('_', ' ').ToLowerInvariant())
 };
 static string RelativeTime(DateTime updated)
 {
  var age = DateTime.UtcNow - updated.ToUniversalTime();
  return age.TotalDays >= 1 ? $"{(int)age.TotalDays}d" : age.TotalHours >= 1 ? $"{(int)age.TotalHours}h" :
   age.TotalMinutes >= 1 ? $"{(int)age.TotalMinutes}m" : "Now";
 }
 double[] Ratings(IEnumerable<SavedTitle> titles) =>
  titles.Where(item => scores.ContainsKey(item.Id)).Select(item => scores[item.Id]).ToArray();

 RenderFragment Metrics(SavedTitle[] titles, bool manga, bool stats) => @<dl class="library-metrics @(stats ? "library-metrics-centered" : "")">
  <div><dt>Entries</dt><dd>@titles.Length</dd></div>
  @if (stats) { @Mean(titles) }
  <div><dt>@(manga ? "Chapters" : "Episodes")</dt><dd>@titles.Sum(item => (long)item.Progress).ToString("N0")</dd></div>
  <div><dt>@(manga ? "Days Read" : "Days Watched")</dt><dd title="Total time is unavailable">—</dd></div>
  @if (!stats) { @Mean(titles) }
 </dl>;

 RenderFragment Mean(SavedTitle[] titles) => @<div class="library-rated"><dt>Mean Score</dt>
  <dd>@(Ratings(titles) is { Length: > 0 } rated ? rated.Average().ToString("0.00") : "—")</dd>
 </div>;

 RenderFragment Breakdown(string label, IEnumerable<(string Value, SavedTitle Item)> source, int total,
  bool bars = true, bool showScores = false) => @<section class="@(bars ? "library-panel library-breakdown" : "library-breakdown")">
  <h3>@label</h3>
  @{
   var groups = source.Where(entry => !string.IsNullOrWhiteSpace(entry.Value)).GroupBy(entry => entry.Value)
    .OrderByDescending(group => group.Count()).ThenBy(group => group.Key, StringComparer.CurrentCulture).Take(10).ToArray();
  }
  @if (groups.Length == 0) { <small>@MetadataStatus</small> }
  @foreach (var group in groups)
  {
   var count = group.Count();
   var fraction = Percent(count, total);
   var rated = showScores ? Ratings(group.Select(entry => entry.Item)) : [];
   <div>
    <header><span>@(label is "Format" or "Source Material" ? Format(group.Key) : group.Key)</span>
     <span class="library-number">@count · @fraction% @if (rated.Length > 0) { <b class="library-rated">★ @rated.Average().ToString("0.0")</b> }</span>
    </header>
    @if (bars) { <progress value="@count" max="@total" aria-label="@($"{group.Key}: {count} of {total} titles")"></progress> }
   </div>
  }
 </section>;

 async Task LoadMetadata()
 {
  if (loading || disposed || metadataLoading || filter is not ("Anime" or "Manga" or "Stats") ||
      Services.GetService(typeof(AniListClient)) is not AniListClient api) return;
  var token = metadataStop.Token;
  var requestedKind = filter == "Stats" ? statsKind : filter.ToUpperInvariant();
  var ids = items.Where(item => item.Kind == requestedKind && TrackingDisplay.CanSync(item) &&
   !metadataChecked.Contains((item.Kind, item.Id))).Select(item => item.Id).ToArray();
  if (ids.Length == 0) return;
  metadataLoading = true;
  try
  {
   foreach (var batch in ids.Chunk(50))
   {
    var found = await api.LibraryMetadataAsync(batch, requestedKind, token);
    if (token.IsCancellationRequested) return;
    foreach (var info in found) metadata[(info.Kind, info.Id)] = info;
    foreach (var id in batch) metadataChecked.Add((requestedKind, id));
   }
  }
  catch (Exception) { /* Saved data and offline controls still render. */ }
  finally { metadataLoading = false; }
  if (disposed) return;
  StateHasChanged();
  if ((filter == "Stats" ? statsKind : filter.ToUpperInvariant()) != requestedKind) await LoadMetadata();
 }

 string? appliedView;
 protected override void OnParametersSet()
 {
  if (string.Equals(View, appliedView, StringComparison.OrdinalIgnoreCase)) return;
  appliedView = View;
  ChangeView(View?.ToLowerInvariant() switch { "downloads" => "Downloads", "anime" => "Anime", "manga" => "Manga", "stats" => "Stats", _ => "All" });
 }

 protected override async Task OnInitializedAsync()
 {
  Store.AniListChanged += Changed;
  await Load();
  _ = LoadMetadata();
 }

 async Task Load()
 {
  var request = ++revision;
  try
  {
   var found = await Store.GetLibraryAsync();
   if (disposed || revision != request) return;
   items = found;
   var history = await Store.HistoryAsync();
   if (disposed || revision != request) return;
   resumeCount = history.Count;
   if (ProfileDownloads is { } downloads)
   {
    try
    {
     var offline = await downloads.ListAsync();
     if (disposed || revision != request) return;
     offlineCount = offline.Count(job => job.State == DownloadState.Complete);
    }
    catch { /* Download storage can be unavailable while the local library is usable. */ }
   }
   var active = ProfileAniList is { } account ? await account.CachedLinkAsync() : null;
   var pendingIds = active is null ? new HashSet<int>() : (await Store.AniListEditsAsync(active.Viewer.Id)).Select(edit => edit.MediaId).ToHashSet();
   var acknowledged = active is null ? new HashSet<int>() : await Store.ConfirmedTrackingTitlesAsync(active.Viewer.Id);
   var knownTotals = await Store.TrackingTotalsAsync(active?.Viewer.Id);
   var ratings = new Dictionary<int, double>();
   if (active is { } accountLink)
   {
    var scale = AniListAccount.ScoreScale(accountLink.Viewer.ScoreFormat);
    foreach (var item in found.Where(TrackingDisplay.CanSync))
    {
     if (disposed || revision != request) return;
     if (await Store.GetAniListScoreAsync(accountLink.Viewer.Id, item.Id, accountLink.Viewer.ScoreFormat) is double score)
      ratings[item.Id] = score * 10 / scale.Maximum;
    }
   }
   if (!disposed && revision == request) (link, pending, confirmed, totals, scores) = (active, pendingIds, acknowledged, knownTotals, ratings);
  }
  catch { if (!disposed && revision == request) error = "Some Library information could not be loaded."; }
  finally { if (!disposed && revision == request) loading = false; }
 }
 void Changed() => _ = InvokeAsync(async () =>
 {
  if (disposed) return;
  await Load();
  if (!disposed) { StateHasChanged(); await LoadMetadata(); }
 });

 public void Dispose()
 {
  disposed = true;
  metadataStop.Cancel();
  metadataStop.Dispose();
  Store.AniListChanged -= Changed;
 }
}
