@page "/library"
@inject LocalStore Store
@inject IServiceProvider Services
@using System.Globalization
<header class="page-header"><span class="eyebrow">STORIES YOU KEEP</span><h1>Library</h1><p>Your collection, always close.</p></header>
<div class="tabs" role="group" aria-label="Library format">@foreach(var tab in new[]{"All","Anime","Manga","Favourites"}){<button class="@(filter==tab?"selected":"")" @onclick="()=>filter=tab">@tab</button>}</div>
@if(error is not null){<div class="notice" role="alert">@error</div>}
@if(loading){<p role="status">Opening your library…</p>}
else if(!Visible.Any()){<div class="empty"><Icon Name="library"/><h2>A shelf full of possibilities</h2><p>Save titles from Anime or Manga. They’ll stay on this device even when you’re offline.</p><a class="primary" href="/anime">Find a story</a></div>}
else{<div class="library-list">@foreach(var item in Visible){<article class="library-item" @key="item.Id">@if(item.Poster is not null){<img src="@item.Poster" alt="" loading="lazy"/>}<div><small class="eyebrow">@item.Kind</small><h3>@if(item.ProviderKey!=null){<a href="@($"/library/title/{item.Id}")">@item.Title →</a>}else{@item.Title}</h3>
<button class="text-link" aria-pressed="@item.IsFavourite" @onclick="()=>Favourite(item)">@(item.IsFavourite?"Remove favourite":"Add to favourites")</button><label>Status<select value="@item.Status" @onchange="e=>UpdateStatus(item,e)"><option value="PLANNING">Planned</option><option value="CURRENT">In progress</option><option value="COMPLETED">Completed</option><option value="PAUSED">Paused</option><option value="REPEATING">Rewatching or rereading</option><option value="DROPPED">Dropped</option></select></label><div class="progress-control"><span>@item.Progress @(item.Kind=="ANIME"?"episodes":"chapters")</span><button aria-label="Decrease progress" disabled="@(item.Progress==0)" @onclick="()=>Progress(item,-1)">−</button><button aria-label="Increase progress" @onclick="()=>Progress(item,1)">+</button></div>@if (viewer is not null && IsAniList(item))
{
 <label>AniList score (out of @scoreMaximum)
  <input type="number" min="@scoreStep" max="@scoreMaximum" step="@scoreStep"
   value="@scores.GetValueOrDefault(item.Id)?.ToString(CultureInfo.InvariantCulture)"
   @onchange="args => UpdateScore(item, args)" />
 </label>
}
<button class="text-link" @onclick="()=>Remove(item)">Remove from library</button></div></article>}</div>}
<ResumeHistory ShowRemove="true" MediaFilter="@filter"/>
<p class="source-note">@(viewer is null ? "Stored on this device." : "AniList connected · Exact resume positions stay on this device.")</p>
@code {
 List<SavedTitle> items=[];string filter="All";string? error;bool loading=true;
 IEnumerable<SavedTitle> Visible=>items.Where(x=>filter=="Favourites"?x.IsFavourite:filter=="All"||x.Kind==filter.ToUpperInvariant());
 AniListAccount? tracking;
 AniListViewer? viewer;
 double scoreMaximum, scoreStep;
 readonly Dictionary<int, double?> scores = new();
 static bool IsAniList(SavedTitle item) => item.Id > 0 && item.ProviderKey is null;

 protected override async Task OnInitializedAsync()
 {
  try
  {
   items = await Store.GetLibraryAsync();
   tracking = (AniListAccount?)Services.GetService(typeof(AniListAccount));
   viewer = tracking is null ? null : await tracking.StoredViewerAsync();
   if (viewer is not null)
   {
    (scoreMaximum, scoreStep) = AniListAccount.ScoreScale(viewer.ScoreFormat);
    foreach (var entry in items.Where(IsAniList))
     scores[entry.Id] = await Store.GetAniListScoreAsync(viewer.Id, entry.Id);
   }
  }
  catch { error = "Some library information could not be loaded."; }
  finally { loading = false; }
 }

 async Task UpdateScore(SavedTitle item, ChangeEventArgs args)
 {
  if (viewer is null || !IsAniList(item)) return;
  var value = args.Value?.ToString() ?? "";
  var score = 0d;
  if (value.Length > 0 && (!double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out score) ||
      !double.IsFinite(score) || score < scoreStep || score > scoreMaximum || Math.Abs(score / scoreStep - Math.Round(score / scoreStep)) > 0.001))
  {
   error = "Enter a score on your AniList scale or leave it blank.";
   return;
  }
  try
  {
   await Store.SaveAniListScoreAsync(viewer.Id, item.Id, score > 0 ? score : null);
   scores[item.Id] = score > 0 ? score : null;
   await Sync(item, "score", score.ToString(CultureInfo.InvariantCulture));
  }
  catch { error = "Could not save this score."; }
 }

 async Task Sync(SavedTitle item, string field, string value)
 {
  if (viewer is null || tracking is null || !IsAniList(item)) return;
  try { await tracking.UpdateFieldAsync(viewer.Id, item.Id, field, value); }
  catch { error = "Saved locally. AniList did not acknowledge the change."; }
 }
 async Task Favourite(SavedTitle item){item.IsFavourite=!item.IsFavourite;try{await Store.SaveAsync(item);}catch{item.IsFavourite=!item.IsFavourite;error="Could not save favourite.";}}
 async Task UpdateStatus(SavedTitle item,ChangeEventArgs e){var previous=item.Status;item.Status=e.Value?.ToString()??"PLANNING";try{await Store.SaveAsync(item);error=null;await Sync(item,"status",item.Status);}catch{item.Status=previous;error="Could not save the change.";}}
 async Task Progress(SavedTitle item,int delta){var previous=item.Progress;item.Progress=Math.Max(0,item.Progress+delta);try{await Store.SaveAsync(item);error=null;await Sync(item,"progress",item.Progress.ToString(CultureInfo.InvariantCulture));}catch{item.Progress=previous;error="Could not save progress.";}}
 async Task Remove(SavedTitle item){try{await Store.RemoveAsync(item.Id);items.Remove(item);error=null;}catch{error="Could not remove this title.";}}
}
