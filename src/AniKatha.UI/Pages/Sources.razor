@page "/profile/sources"
@inherits ProfileComponent
@implements IDisposable
@inject AddonClient Addons
<a class="text-link" href="/profile">← Profile</a>
<section class="settings-screen sources-screen">
 <header class="page-header"><h1>Sources</h1><p>Manage the add-ons this profile uses to find, watch, and read stories.</p></header>
 <section class="settings-card">
  <h2>Install an HTTP add-on</h2>
  <p>Paste a public HTTPS manifest URL to check its capabilities before installing it.</p>
  <form @onsubmit="Inspect" @onsubmit:preventDefault>
   <label>Manifest URL
    <input id="source-manifest" type="text" inputmode="url" autocomplete="off" autocapitalize="off"
     spellcheck="false" @bind="url" @bind:event="oninput" @bind:after="ClearPreview" placeholder="https://provider.example/manifest.json" required />
   </label>
   <button class="primary" type="submit" disabled="@checking">@(checking ? "Checking manifest…" : "Check manifest")</button>
  </form>
  @if (candidate is { } preview)
  {
   <section class="notice" aria-label="Source preview">
    <h3>@preview.Name</h3>
    <div class="chips">@foreach (var capability in Capabilities(preview)) { <span>@capability</span> }</div>
    <div class="settings-actions">
     <button class="primary" @onclick="Install" disabled="@checking">Add source</button>
     <button class="secondary" @onclick="ClearPreview" disabled="@checking">Cancel</button>
    </div>
   </section>
  }
  @if (installMessage is not null) { <p role="@(installError ? "alert" : "status")">@installMessage</p> }
 </section>

 <h2>Installed add-ons</h2>
 @if (loading) { <p role="status">Loading sources…</p> }
 else if (loadFailed)
 {
  <p role="alert">Could not load installed sources.</p>
  <button class="secondary" @onclick="Load">Retry</button>
 }
 else if (installed.Count == 0)
 {
  <div class="empty"><h3>No sources installed</h3><p>Add a source to open its catalog or find playable episodes and chapter pages.</p>
   <a class="primary" href="#source-manifest">Add source</a></div>
 }
 else
 {
  <p>Sources are listed in the order AniKatha checks them. A title’s preferred provider can appear first in its picker.</p>
  @foreach (var addon in installed)
  {
   <article class="settings-card source-card" @key="addon.Url">
    <div class="addon-row"><div>
     <strong>@addon.Name</strong>
     <small>v@addon.Version · @(addon.Disabled ? "Disabled" : "Enabled")</small>
     <div class="chips">@foreach (var capability in Capabilities(addon)) { <span>@capability</span> }</div>
     @if (!string.IsNullOrWhiteSpace(addon.Description)) { <p>@addon.Description</p> }
    </div></div>
    <div class="settings-actions">
     <button class="secondary" disabled="@Busy(addon)" @onclick="() => Toggle(addon)">@(addon.Disabled ? "Enable" : "Disable")</button>
     <button class="secondary" disabled="@Busy(addon)" @onclick="() => Refresh(addon)">Refresh</button>
     <button class="secondary" disabled="@(Busy(addon) || addon == installed[0])" @onclick="() => Move(addon, -1)">Move up</button>
     <button class="secondary" disabled="@(Busy(addon) || addon == installed[^1])" @onclick="() => Move(addon, 1)">Move down</button>
     <button class="secondary danger-action" disabled="@Busy(addon)" @onclick="() => removal = addon">Remove</button>
    </div>
    @if (Busy(addon)) { <p role="status">Updating @addon.Name…</p> }
    @if (statuses.TryGetValue(addon.Url, out var status)) { <p role="@(status.Error ? "alert" : "status")">@status.Message</p> }
    @if (Uri.TryCreate(addon.Url, UriKind.Absolute, out var address) && address.Query.Length > 0)
    {
     <details><summary>Provider configuration</summary><p>This source uses a configured manifest URL. Refresh checks the same configuration. If the provider gives you a different URL, install it as a separate source.</p></details>
    }
    @if (removal == addon)
    {
     <div class="danger-panel">
      <h3>Remove @addon.Name?</h3><p>The source will stop providing results. Existing Library entries, progress, and downloaded files stay on this profile.</p>
      <div class="settings-actions"><button class="secondary" @onclick="() => removal = null">Cancel</button>
       <button class="primary danger-action" disabled="@Busy(addon)" @onclick="() => Remove(addon)">Remove source</button></div>
     </div>
    }
   </article>
  }
 }
 @if (removedName is not null) { <p role="status">Removed @removedName.</p> }
</section>

@code {
 [CascadingParameter] public CatalogSession? Catalog { get; set; }
 [CascadingParameter] public SourceResultCache? Cache { get; set; }
 readonly CancellationTokenSource lifetime = new();
 readonly HashSet<string> busy = new(StringComparer.Ordinal);
 readonly Dictionary<string, (string Message, bool Error)> statuses = new(StringComparer.Ordinal);
 List<InstalledAddon> installed = [];
 InstalledAddon? candidate, removal;
 string url = "";
 string? installMessage, removedName;
 bool loading = true, loadFailed, checking, installError, disposed;

 protected override Task OnInitializedAsync() => Load();

 async Task Load()
 {
  loading = true;
  try { installed = await Store.GetAddonsAsync(true); loadFailed = false; }
  catch { loadFailed = true; }
  finally { loading = false; }
 }

 void ClearPreview() { candidate = null; installMessage = null; installError = false; }
 bool Busy(InstalledAddon addon) => busy.Contains(addon.Url);

 async Task Inspect()
 {
  if (checking) return;
  checking = true;
  ClearPreview();
  var submitted = url;
  try
  {
   var normalized = AddonClient.ValidateUrl(submitted).AbsoluteUri;
   if (installed.Any(addon => addon.Url == normalized))
    throw new InvalidOperationException("This source is already installed.");
   var result = await Addons.InspectAsync(submitted, lifetime.Token);
   if (!disposed && submitted == url) candidate = result;
  }
  catch (OperationCanceledException) when (disposed) { }
  catch (InvalidOperationException ex) { if (submitted == url) FailInstall(ex.Message); }
  catch { if (submitted == url) FailInstall("Could not download the manifest. Check the URL and connection."); }
  finally { checking = false; }
 }

 async Task Install()
 {
  if (candidate is not { } addon || checking) return;
  checking = true;
  try
  {
   await Store.SaveAddonAsync(addon);
   Invalidate();
   installed = await Store.GetAddonsAsync(true);
   candidate = null;
   url = "";
   installMessage = $"Added {addon.Name}.";
  }
  catch (InvalidOperationException ex) { FailInstall(ex.Message); }
  catch { FailInstall("The source could not be saved. Try again."); }
  finally { checking = false; }
 }

 void FailInstall(string message) { installError = true; installMessage = message; }
 void Invalidate() { Catalog?.Tabs.Clear(); Cache?.Clear(); }

 async Task<bool> Manage(InstalledAddon addon, Func<Task> action, string message, bool reorder = false)
 {
  if (!busy.Add(addon.Url)) return false;
  statuses.Remove(addon.Url);
  try
  {
   await action();
   Invalidate();
   installed = await Store.GetAddonsAsync(true);
   if (reorder)
    Catalog?.ReorderMangaProviders(installed.Select(source => new AddonResources(source).ProviderKey));
   else
    Catalog?.InvalidateMangaProvider(new AddonResources(addon).ProviderKey);
   statuses[addon.Url] = (message, false);
   return true;
  }
  catch (OperationCanceledException) when (disposed) { return false; }
  catch (InvalidOperationException ex) { statuses[addon.Url] = (ex.Message, true); return false; }
  catch { statuses[addon.Url] = ("Could not update this source. Try again.", true); return false; }
  finally { busy.Remove(addon.Url); }
 }

 Task Toggle(InstalledAddon addon) => Manage(addon, () => Store.SetAddonDisabledAsync(addon.Url, !addon.Disabled),
  addon.Disabled ? "Source enabled." : "Source disabled.");
 Task Refresh(InstalledAddon addon) => Manage(addon,
  async () => await Store.RefreshAddonAsync(await Addons.InspectAsync(addon.Url, lifetime.Token)), "Manifest refreshed.");
 Task Move(InstalledAddon addon, int direction) => Manage(addon, () => Store.MoveAddonAsync(addon.Url, direction),
  direction < 0 ? "Source moved up." : "Source moved down.", reorder: true);

 async Task Remove(InstalledAddon addon)
 {
  if (!await Manage(addon, () => Store.RemoveAddonAsync(addon.Url), "Source removed.")) return;
  removal = null;
  removedName = addon.Name;
 }

 static string[] Capabilities(InstalledAddon addon)
 {
  try { return new AddonResources(addon).DisplayCapabilities(); }
  catch (System.Text.Json.JsonException) { return ["Refresh to load capabilities"]; }
 }

 public void Dispose() { disposed = true; lifetime.Cancel(); lifetime.Dispose(); }
}
