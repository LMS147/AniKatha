@page "/resume/{Id}"
@inject LocalStore Store
@inject IServiceProvider Services
<a class="text-link" href="/library">← Library</a>
@if(entry!=null)
{
 <header class="page-header"><h1>@entry.Title</h1><p>@entry.Label</p></header>
 @if (downloadId is not null) { <a class="primary" href="@($"/library/download/{downloadId}")">Open downloaded copy</a> }
 @if(source!=null)
 {
  <ManifestSources @key="entry.Id" Source="source" Origin="@entry.Origin" Type="@entry.Type" TitleId="@entry.TitleId"
    UnitId="@entry.UnitId" Title="@entry.Title" Label="@entry.Label"/>
 }
 else { <p class="notice">Enable or reinstall the source in Profile to resume this title.</p> }
}
else if(loaded){<p>This history entry is unavailable.</p>}
@code {
 [Parameter] public string Id {get;set;}="";
 ResumeEntry? entry;
 AddonResources? source;
 bool loaded;
 string? downloadId;
 protected override async Task OnParametersSetAsync()
 {
  var id=Id;
  var item=(await Store.HistoryAsync()).FirstOrDefault(x=>x.Id==id);
  var sources=(await Store.GetAddonsAsync()).Select(x=>new AddonResources(x)).ToList();
  if(id!=Id)return;
  entry=item;
  downloadId = null;
  if (item is not null && Services.GetService(typeof(OfflineDownloads)) is OfflineDownloads downloads)
  {
   var key = ResumeEntry.Key(item.Origin, item.Type, item.TitleId, item.UnitId, item.Source);
   var local = (await downloads.ListAsync()).FirstOrDefault(job => job.State == DownloadState.Complete && job.Selection.ProgressKey == key);
   if (id != Id) return;
   downloadId = local?.Id;
  }
  source=item!=null && sources.Any(x=>x.ProviderKey==item.Origin)
   ?sources.FirstOrDefault(x=>x.ProviderKey==item.Source && x.Supports(item.Type=="manga"?"pages":"stream",item.Type,item.UnitId)):null;
  loaded=true;
 }
}
