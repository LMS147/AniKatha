@page "/library/title/{Id:int}"
@inherits ProfileComponent
@inject NavigationManager Navigation
<a class="text-link" href="/library">← Library</a>
@if (title is { } item)
{
 <header class="design-title-card">
  @if (item.Poster is { } poster && AddonResources.MediaUrl(poster)) { <img src="@poster" alt="" /> }
  <div><span class="eyebrow">@TrackingDisplay.Mode(item)</span><h1>@item.Title</h1>
  <p>@TrackingDisplay.Status(item.Status, item.Kind == "MANGA") · @TrackingDisplay.Progress(item, total)</p>
  <a class="secondary" href="@($"/library/title/{item.Id}/tracking")">Edit tracking</a>
  <button type="button" class="secondary" aria-pressed="@item.IsFavourite" disabled="@favoriteBusy" @onclick="() => ToggleFavorite(item)">
   @(item.IsFavourite ? "Remove from favorites" : "Add to favorites")
  </button></div>
 </header>
 @if (source is not null)
 {
  <ManifestCatalog @key="Id" Source="source" Catalog="catalog!" Providers="providers" InitialTitle="title"/>
 }
 else if (TrackingDisplay.CanSync(item))
 {
  <TrackedTitleSources @key="Id" Title="title"/>
 }
 else
 {
  <p class="notice">This saved title’s source is unavailable. Enable or reinstall it in <a class="text-link" href="/profile/sources">Sources</a>.</p>
 }
 <section class="settings-card tracking-removal">
  @if (confirmRemoval)
  {
   <p>Remove this title from your local Library? Watch and reading history will remain.</p>
   <div class="settings-actions">
    <button class="secondary" @onclick="() => confirmRemoval = false">Keep title</button>
    <button class="secondary danger-action" disabled="@removing" @onclick="Remove">Remove title</button>
   </div>
  }
  else { <button class="text-link danger-action" @onclick="() => confirmRemoval = true">Remove from library</button> }
  @if (error is not null) { <p role="alert">@error</p> }
 </section>
}
else if (loaded) { <p role="alert">@error</p> }
else { <p role="status">Opening title…</p> }

@code {
 [Parameter] public int Id { get; set; }
 SavedTitle? title;
 AddonResources? source;
 AddonCatalog? catalog;
 List<AddonResources> providers = [];
 int? total;
 string? error;
 bool loaded, confirmRemoval, removing, favoriteBusy;

 protected override async Task OnParametersSetAsync()
 {
  var id = Id;
  loaded = confirmRemoval = false;
  title = null;
  error = null;
  try
  {
   var item = await Store.FindSavedTitleAsync(id);
   var enabled = (await Store.GetAddonsAsync()).Select(addon => new AddonResources(addon)).ToList();
   var linked = ProfileAniList is { } account ? await account.CachedLinkAsync() : null;
   var known = await Store.GetTrackingTotalAsync(linked?.Viewer.Id, id);
   if (id != Id) return;
   title = item;
   total = known;
   providers = enabled;
   source = enabled.FirstOrDefault(provider => provider.ProviderKey == item?.ProviderKey);
   catalog = item?.ResourceType is string type ? new(type, "", "", false, false) : null;
   if (item is null) error = "This title is no longer in Library.";
  }
  catch { if (id == Id) error = "Could not open this title."; }
  finally { if (id == Id) loaded = true; }
 }

 async Task ToggleFavorite(SavedTitle item)
 {
  if (favoriteBusy) return;
  favoriteBusy = true;
  try
  {
   var next = !item.IsFavourite;
   await Store.SetFavouriteAsync(item.Id, next);
   item.IsFavourite = next;
  }
  catch { error = "Could not update favorites."; }
  finally { favoriteBusy = false; }
 }

 async Task Remove()
 {
  if (title is not { } item || removing) return;
  removing = true;
  try { await Store.RemoveAsync(item.Id); Navigation.NavigateTo("/library"); }
  catch { error = "Could not remove this title. Try again."; }
  finally { removing = false; }
 }
}
