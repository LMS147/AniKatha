@inherits LayoutComponentBase
@implements IDisposable
@inject IServiceProvider Services
@if (!ready)
{
 <main class="app-shell" data-theme="system"><p role="status">Opening your profile…</p></main>
}
else
{
<div class="app-shell" data-theme="@appearance.Mode" data-density="@appearance.Density" style="@appearance.Css">
 <CascadingValue Value="appearance" Name="CurrentAppearance">
 <CascadingValue Value="apply" IsFixed="true">
 <CascadingValue Value="catalogSession" IsFixed="true">
  <CascadingValue Value="sourceResultCache" IsFixed="true">
   <CascadingValue Value="homeSpotlightSession" IsFixed="true">
    <main id="main-content">@Body</main>
   </CascadingValue>
  </CascadingValue>
 </CascadingValue>
 <nav class="bottom-nav" aria-label="Main navigation">
  <NavLink href="/" Match="NavLinkMatch.All"><Icon Name="home" /><span>Home</span></NavLink>
  <NavLink href="/anime"><Icon Name="play" /><span>Anime</span></NavLink>
  <NavLink href="/manga"><Icon Name="book" /><span>Manga</span></NavLink>
  <NavLink href="/library"><Icon Name="library" /><span>Library</span></NavLink>
  <NavLink href="/profile"><Icon Name="user" /><span>Profile</span></NavLink>
 </nav>
 </CascadingValue>
 </CascadingValue>
</div>
}
@code {
 readonly SourceResultCache sourceResultCache = new();
 readonly CatalogSession catalogSession = new();
 readonly HomeSpotlightSession homeSpotlightSession = new();
 [CascadingParameter] public ProfileSession? Session { get; set; }
 AppearanceSettings appearance = new();
 Func<AppearanceSettings, Task> apply = null!;
 bool ready, disposed;

 protected override async Task OnInitializedAsync()
 {
  apply = Apply;
  try
  {
   if (Session?.Store is { } store) appearance = await AppearanceSettings.LoadAsync(store);
   else if (Services.GetService(typeof(LocalStore)) is LocalStore legacy) appearance = await AppearanceSettings.LoadAsync(legacy);
   await ApplyPlatform();
  }
  catch { /* The UI can start with the default theme. */ }
  finally { ready = true; }
 }

 async Task Apply(AppearanceSettings value)
 {
  appearance = value;
  await ApplyPlatform();
  await InvokeAsync(StateHasChanged);
 }

 async Task ApplyPlatform()
 {
  if (!disposed && Services.GetService(typeof(IAppearancePlatform)) is IAppearancePlatform platform)
   await platform.ApplyAsync(appearance.Mode);
 }
 public void Dispose() => disposed = true;
}
